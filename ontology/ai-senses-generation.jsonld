  {
   "@id": "lab:method/length-penalty",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "글자 벌금 λ",
     "@language": "ko"
    },
    {
     "@value": "length penalty",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "답이 길수록 보상을 깎는 장치. 토큰 하나당 λ만큼 뺀다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#lab"
   },

   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "끌어오기",
     "@language": "ko"
    },
    {
     "@value": "reprojection",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기억에서 모션 벡터만큼 거슬러 올라간 자리의 색을 가져온다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv2"

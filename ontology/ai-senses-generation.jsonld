    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-3_frame_generation.html#lv1"
   }
  },
  {
   "@id": "lab:concept/ghost-double",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "겹침",
     "@language": "ko"
    },
    {
     "@value": "double image",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "섞기로 물체가 반투명한 두 개로 보이는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-3_frame_generation.html#lv1"
   }
  },
  {
   "@id": "lab:method/optical-flow",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "광학 흐름",
     "@language": "ko"
    },
    {
     "@value": "optical flow",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 그림만 비교해 픽셀마다 움직임을 찾는다.",

    },
    {
     "@id": "lab:dataset/persuade"
    },
    {
     "@id": "lab:dataset/wikipedia"
    }
   ]
  },
  {
   "@id": "lab:method/rlvr",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "채점형 강화학습",
     "@language": "ko"
    },
    {
     "@value": "reinforcement learning with verifiable rewards (RLVR)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정답을 자동으로 확인할 수 있는 문제(수학·코드)에서 맞히면 보상을 주는 강화학습. 사람이 고리 밖으로 빠진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#q"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:method/rlhf"
    }
   ]
  },
  {
   "@id": "lab:method/rlhf",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "사람 피드백 강화학습",
     "@language": "ko"
    },
    {
     "@value": "RLHF",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사람이 더 좋은 답을 골라 준 결과로 보상을 주는 강화학습.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#q"
   },

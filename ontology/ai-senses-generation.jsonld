     "@value": "통째 비교(자리 그대로 비교)",
     "@language": "ko"
    },
    {
     "@value": "Pixel-wise template matching",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "저장한 판과 새 판을 같은 자리끼리 비교해 같은 칸 수를 세는 방법.",
    "@language": "ko"
   },

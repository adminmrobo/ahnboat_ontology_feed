     "@id": "lab:concept/processing-difficulty"
    }
   ]
  },
  {
   "@id": "lab:concept/dependency-length",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "짝 거리",
     "@language": "ko"
    },
    {
     "@value": "dependency length",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문법적으로 짝인 두 단어(주어와 동사 등) 사이의 거리. 멀수록 작업 기억 부담이 크다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/processing-difficulty"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/std-dep-length"
    }
   ]
  },
  {
   "@id": "lab:concept/unattested-ngram",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "처음 보는 단어 짝",
     "@language": "ko"
    },
    {
     "@value": "unattested n-gram",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사람이 쓴 기준 말뭉치에 한 번도 나오지 않는 두 단어 이어짐. 예측하기 어려운 단어는 읽기 비용이 크다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/processing-difficulty"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/unattested-rate"
    },
    {
     "@id": "lab:metric/ngram-perplexity"
    }
   ]
  },
  {
   "@id": "lab:metric/ngram-perplexity",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "n-그램 퍼플렉서티",
     "@language": "ko"
    },
    {
     "@value": "trigram perplexity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사람 글로 만든 3-그램 모델이 그 글을 얼마나 놀라워하는지. 높을수록 낯선 표현이 많다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   }
  },
  {
   "@id": "lab:metric/unattested-rate",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "처음 보는 짝 비율",
     "@language": "ko"
    },
    {
     "@value": "unattested pairs per 1k",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "단어 짝 1,000개당 기준 말뭉치에 없는 짝의 수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   }
  },
  {
   "@id": "lab:metric/std-dep-length",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "표준화 짝 거리",
     "@language": "ko"
    },
    {
     "@value": "standardized dependency length",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문장 길이 차이를 없애려고 위키백과 문장 길이 분포에 맞춰 평균을 낸 짝 거리.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#method"
   }
  },
  {
   "@id": "lab:metric/short-share",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "짧은 쪽 선택 비율",
     "@language": "ko"
    },
    {
     "@value": "share of short variant",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정답 출력 가운데 같은 뜻 두 표현 중 짧은 쪽을 쓴 비율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#lab"
   }
  },
  {
   "@id": "lab:metric/reading-time",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "예상 읽기 시간 (설명용)",
     "@language": "ko"
    },
    {
     "@value": "expected reading time (toy)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이 페이지 대결에서 쓰는 설명용 모형의 지표. 실제 측정값이 아니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#duel"
   }
  },
  {
   "@id": "lab:method/dependency-parse",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "문장 해부 (의존 구문 분석)",
     "@language": "ko"
    },
    {
     "@value": "dependency parsing (spaCy)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문장 속 단어들이 어떤 짝 관계인지 자동으로 찾는 도구. 논문은 spaCy를 썼다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#method"

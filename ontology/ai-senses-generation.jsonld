   ],
   "skos:prefLabel": [
    {
     "@value": "데드팬",
     "@language": "ko"
    },
    {
     "@value": "Deadpan",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "갭 = |상황 크기 − 표정 크기|. 큰일 앞 무표정, 사소한 일에 과잉 반응",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/drawing_lab_fun/02_reaction.html#s4"
   }
  },
  {

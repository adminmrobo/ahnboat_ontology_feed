   ]
  },
  {
   "@id": "lab:concept/disocclusion",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "새로 드러난 자리",
     "@language": "ko"
    },
    {
     "@value": "disocclusion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "움직이던 물체가 비켜나 처음 보이는 배경. 따라갈 기억이 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv2"
   }
  },
  {
   "@id": "lab:concept/history-blur",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "끌어올 때 흐려짐",
     "@language": "ko"
    },
    {
     "@value": "resampling blur",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "끌어올 때마다 쌍선형으로 섞여 기억이 조금씩 흐려진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv2"
   }
  },
  {

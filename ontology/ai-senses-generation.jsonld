    "@id": "https://adminmrobo.github.io/ai_rendering/part2/2-1_why_photos_are_flat.html#lv1"
   }
  },
  {
   "@id": "lab:concept/ill-posed",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [

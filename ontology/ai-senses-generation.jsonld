     "@id": "lab:concept/dlss2"
    }
   ]
  },
  {
   "@id": "lab:concept/taa",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시간 누적 안티에일리어싱",
     "@language": "ko"
    },
    {
     "@value": "temporal anti-aliasing (TAA)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "게임에서 널리 쓰는 지터 + 누적 + 잘라내기 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv3"
   }
  },
  {
   "@id": "lab:concept/supersampling",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "슈퍼샘플링",
     "@language": "ko"
    },
    {
     "@value": "supersampling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "픽셀마다 여러 점을 평균. 지터 누적은 이것을 여러 장면에 나눠 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv1"
   }
  },
  {
   "@id": "lab:dataset/tetris-sequence",
   "@type": [
    "skos:Concept",
    "lab:Dataset"
   ],
   "skos:prefLabel": [
    {
     "@value": "테트리스 장면 16장",
     "@language": "ko"
    },
    {
     "@value": "Tetris frame sequence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "멈춘 화면과 블록 넷이 떨어지는 화면, 96×96, 정답 16점·입력 ×2 지터 1점.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv1"
   }
  },
  {
   "@id": "lab:concept/inbetween",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "사이 장면",
     "@language": "ko"
    },
    {
     "@value": "interpolated frame",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞·뒤 진짜 장면 사이 시각의 장면. 그리지 않고 만든다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-3_frame_generation.html#lv1"
   }
  },
  {
   "@id": "lab:method/hold",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "반복",
     "@language": "ko"
    },
    {
     "@value": "frame repeat",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞 장면을 한 번 더 보여 준다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

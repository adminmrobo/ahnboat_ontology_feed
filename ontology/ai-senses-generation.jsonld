     "@value": "motion vector",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "픽셀마다 앞 장면에서 지금까지 움직인 거리. 렌더러가 알려 준다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

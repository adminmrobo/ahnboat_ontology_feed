  {
   "@id": "lab:concept/reduced-orc",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "that 빠진 관계절",
     "@language": "ko"
    },
    {
     "@value": "object relative clause without relativizer",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "목적어를 꾸미는 관계절에서 생략해도 되는 that을 뺀 형태. 논문은 생략 가능한 단어를 건너뛰는 경향의 지표로 썼다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   },

     "@language": "ko"
    },
    {
     "@value": "Storyboard sheet prompt",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "8컷씩 나눠 그리고 둘째 장부터 앞 시트 첨부, 실루엣 규칙",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/drawing_lab_05/08_conti_book.html#s4"

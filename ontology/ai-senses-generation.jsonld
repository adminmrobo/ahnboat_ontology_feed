   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "섞기",
     "@language": "ko"
    },
    {
     "@value": "cross-fade",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞·뒤 장면을 반씩 겹친다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-3_frame_generation.html#lv1"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/psnr"
    }
   ],
   "lab:hasLimitation": [

    }
   ]
  },
  {
   "@id": "lab:method/human-baseline",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "사람 글 기준선",
     "@language": "ko"
    },
    {
     "@value": "human baseline",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "비슷한 장르의 사람 글(영화 자막, 질문답변 사이트, 학생 에세이, 위키백과)과 비교하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#method"

   ],
   "skos:prefLabel": [
    {
     "@value": "명사를 동사로",
     "@language": "ko"
    },
    {
     "@value": "denominal verb",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "명사를 그대로 동사로 쓰는 것. 예: calendar it(캘린더에 넣어).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   },
   "lab:broader": [

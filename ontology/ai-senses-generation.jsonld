  },
  {
   "@id": "lab:method/table-prompt",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "콘티 표 프롬프트",
     "@language": "ko"
    },
    {
     "@value": "Storyboard table prompt",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이야기 + 컷 수 + 표의 열 + 규칙을 대화형 AI에",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/drawing_lab_05/08_conti_book.html#s3"

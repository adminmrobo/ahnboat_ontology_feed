  {
   "@id": "lab:method/round-trip",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "왕복 번역",
     "@language": "ko"
    },
    {
     "@value": "round-trip translation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "영어를 일본어로 옮겼다가 다시 영어로 옮겨, 뜻은 같고 말투만 평범해진 짝 문장을 만드는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

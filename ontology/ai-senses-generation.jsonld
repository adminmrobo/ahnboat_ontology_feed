     "@value": "Upward-looking face",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "눈선 휨 = 머리 반지름 × sin(고개 든 각도), 귀는 눈 아래로",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

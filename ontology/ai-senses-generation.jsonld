     "@value": "From storyboard to finished cut",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "그 컷만 잘라 첨부, 구도만 참고, 기준 컷 먼저, 덩어리마다 두 컷",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

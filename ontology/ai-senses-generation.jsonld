     "@value": "filter radius trade-off",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "좁으면 잡음이 남고 넓으면 그림자 끝이 뭉개진다. 최고 반경은 광선 수마다 다르다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

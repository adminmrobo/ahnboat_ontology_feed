    },
    {
     "@value": "screen-space effects",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "불꽃·그림자·반사·화면 글자처럼 물체가 아닌 것. 모션 벡터가 모른다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

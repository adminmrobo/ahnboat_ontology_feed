    "@id": "https://adminmrobo.github.io/ai_rendering/part2/2-1_why_photos_are_flat.html#lv2"
   }
  },
  {
   "@id": "lab:concept/depth",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [

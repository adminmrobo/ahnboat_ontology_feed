    }
   ]
  },
  {
   "@id": "lab:method/cross-correlation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "합성곱(교차 상관)",
     "@language": "ko"
    },
    {
     "@value": "Convolution (cross-correlation)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "돋보기를 옮겨 가며 겹친 칸끼리 곱해서 더하는 계산. CNN 도구들은 돋보기를 뒤집지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/cnn_face_game_lab/index.html#r3"

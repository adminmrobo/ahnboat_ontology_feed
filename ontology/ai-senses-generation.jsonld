    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "숫자판(픽셀 격자)",
     "@language": "ko"
    },
    {
     "@value": "Pixel grid",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사진을 칸으로 나누고 칸마다 밝기를 숫자로 적은 판. (H, W, C)로 크기를 적는다.",

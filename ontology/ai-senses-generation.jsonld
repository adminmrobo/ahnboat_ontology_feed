   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "타이밍과 간격",
     "@language": "ko"
    },
    {
     "@value": "Timing and spacing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "프레임 수는 시간, 간격은 속도 곡선. 천천히 출발 = t²",

     "@value": "할턴 수열",
     "@language": "ko"
    },
    {
     "@value": "Halton sequence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "빈자리를 골고루 채우는 준난수 수열. 지터 자리로 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

     "@id": "lab:concept/processing-difficulty"
    }
   ]
  },
  {
   "@id": "lab:concept/inanimate-subject",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "사물이 사람처럼",
     "@language": "ko"
    },
    {
     "@value": "inanimate subject with animate verb",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "보통 사람·동물만 하는 동작(먹다, 삼키다, 묻다)을 사물 주어에 붙이는 것. 예: 대화가 제 꼬리를 먹고 있다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/processing-difficulty"
    }
   ]
  },
  {
   "@id": "lab:concept/stacked-nouns",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "명사 기차",
     "@language": "ko"
    },
    {
     "@value": "stacked noun compounds",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "명사 세 개 이상을 이어 붙여 한 덩어리로 쓰는 것. 어디서 끊어 읽을지 헷갈린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_text_read_ability/07_ai_text_readability.html#r1"
   },
   "lab:broader": [

  {
   "@id": "lab:concept/trust-tradeoff",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "믿을까 버릴까",
     "@language": "ko"
    },
    {
     "@value": "history trust trade-off",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잘라내면 잔상은 줄지만 진짜 세부도 잘린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv3"
   }
  },
  {
   "@id": "lab:concept/learned-accumulation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "배우는 누적",
     "@language": "ko"
    },
    {
     "@value": "learned temporal accumulation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "어떻게 모으고 무엇을 버릴지 신경망이 배운다 (DLSS 2.0).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

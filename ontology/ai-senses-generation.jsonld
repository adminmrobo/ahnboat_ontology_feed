  },
  {
   "@id": "lab:method/conti-book",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "콘티 북 만들기",
     "@language": "ko"
    },
    {
     "@value": "Making a storyboard book",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 문장 이야기 → 네 덩어리 × 컷 수 → 표 → 8컷 시트 → 완성 컷",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/drawing_lab_05/08_conti_book.html#s1"

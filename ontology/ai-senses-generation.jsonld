   ],
   "skos:prefLabel": [
    {
     "@value": "컷 쪼개기",
     "@language": "ko"
    },
    {
     "@value": "Splitting cuts",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "8 → 16 → 32, 한 컷 길이 = 전체 길이 ÷ 컷 수, 쪼갠 컷은 목적이 달라야",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/drawing_lab_05/08_conti_book.html#s2"

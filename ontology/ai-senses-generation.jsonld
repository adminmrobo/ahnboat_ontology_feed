   ],
   "skos:prefLabel": [
    {
     "@value": "저더",
     "@language": "ko"
    },
    {
     "@value": "judder",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "움직임이 고르지 않아 끊겨 보이는 것.",

     "@value": "콘티 진단 순서",
     "@language": "ko"
    },
    {
     "@value": "Storyboard diagnosis order",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이야기 → 카메라 → 흐름 → 포즈 → 고정값",

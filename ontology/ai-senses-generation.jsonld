     "@value": "기억 잘라내기",
     "@language": "ko"
    },
    {
     "@value": "neighborhood clamping",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기억 색을 지금 장면 이웃 색의 범위로 자른다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_rendering/part3/3-2_time_helps.html#lv3"
   },

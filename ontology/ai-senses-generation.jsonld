     "@value": "rendering pipeline combination",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작게·시간·사이·광선 네 가지를 한 줄에 놓고 켜고 끈다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

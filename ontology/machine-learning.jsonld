     "@id": "lab:concept/kernel-function"
    },
    {
     "@id": "lab:concept/rbf-svm"
    }
   ]
  },
  {
   "@id": "lab:concept/poly-kernel",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "다항 커널",
     "@language": "ko"
    },
    {
     "@value": "Polynomial kernel",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(γ a·b + r)^d. d차 특징까지 올린 공간의 내적",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/knn_svc_svm_lab/part4_kernel.html#ch16"
   },
   "lab:partOf": [

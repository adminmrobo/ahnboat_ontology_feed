    },
    {
     "@value": "gradient vector",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "계수마다 하나씩, 35개 기울기를 모은 묶음. 가장 가파르게 내려가는 방향.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

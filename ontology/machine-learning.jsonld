    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "분류",
     "@language": "ko"
    },
    {
     "@value": "Classification",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "범주를 맞히는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ML_model_hiring_committee/5-0_job_posting.html#overview"
   }
  },
  {

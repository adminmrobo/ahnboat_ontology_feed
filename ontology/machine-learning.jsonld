    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/vit"
    }
   ]
  },
  {
   "@id": "lab:concept/inductive-bias",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "귀납 편향",
     "@language": "ko"
    },
    {
     "@value": "Inductive bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모델이 데이터를 보기 전에 구조로 갖고 있는 가정. CNN은 가까운 칸을 함께 보지만 ViT는 조각 사이의 관계까지 데이터로 배운다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-9_transformer.html#m4"
   }
  },
  {
   "@id": "lab:method/retest-recipe",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "재시험 처방: AdamW·300에포크·코사인",
     "@language": "ko"
    },
    {
     "@value": "Retest recipe: AdamW, 300 epochs, cosine",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사전 등록한 재시험 설정. 가중치 감쇠를 기울기와 따로 적용하는 AdamW로 300에포크를 코사인 학습률로 돌린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-9_transformer.html#m5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/weight-decay"
    }
   ]
  },
  {
   "@id": "lab:bio/fly-attention",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리의 시각 주의",
     "@language": "ko"
    },
    {
     "@value": "Fly visual attention",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "초파리는 시야의 여러 곳 가운데 중요한 대상에 시각 처리를 모으는 주의 같은 현상을 보인다. 다만 이는 신경 회로의 이득 조절이고 셀프 어텐션과 계산이 다르다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-9_transformer.html#analogy-sec"
   },

     "@id": "lab:topic/probability-statistics"
    }
   ]
  },
  {
   "@id": "lab:concept/likelihood",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가능도",
     "@language": "ko"
    },
    {
     "@value": "likelihood",
     "@language": "en"
    }
   ],

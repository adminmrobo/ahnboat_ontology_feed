  {
   "@id": "lab:concept/classification-vs-regression",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "분류와 회귀",
     "@language": "ko"
    },
    {
     "@value": "classification vs regression",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "텍스트를 미리 정의된 범주로 구분하는 분류(스팸 필터, 감성 분석, 뉴스 주제)와 텍스트에서 연속적인 수치를 예측하는 회귀(리뷰 평점, 가독성 점수, 감정 강도).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ML_model_hiring_committee/5-6_decision_tree.html#m6"
   }
  },

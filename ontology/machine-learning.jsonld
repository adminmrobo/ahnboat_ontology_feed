     "@language": "ko"
    },
    {
     "@value": "linearity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "덧셈·곱셈만으로 된 관계. 주성분 지도 위 직선 산책 = 겹치기.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

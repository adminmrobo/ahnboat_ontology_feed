     "@id": "lab:concept/soft-margin"
    }
   ]
  },
  {
   "@id": "lab:concept/nonlinear-separability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "곧은 줄로 못 가르는 데이터",
     "@language": "ko"
    },
    {
     "@value": "Non-linearly separable data",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 무리가 다른 무리를 둘러싸는 등 곧은 경계로 못 가르는 모양",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/knn_svc_svm_lab/part4_kernel.html#ch14"
   },
   "lab:addressedBy": [
    {
     "@id": "lab:concept/feature-map"
    }
   ]
  },
  {
   "@id": "lab:concept/kernel-trick",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "커널 트릭",
     "@language": "ko"
    },
    {
     "@value": "Kernel trick",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "올라간 카드의 내적을 원래 카드로 바로 계산하는 요령",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/knn_svc_svm_lab/part4_kernel.html#ch16"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/svm"
    }
   ]
  },
  {
   "@id": "lab:concept/kernel-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "커널(닮음 점수)",
     "@language": "ko"
    },
    {
     "@value": "Kernel function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "K(a, b) = φ(a)·φ(b). 두 카드가 얼마나 닮았는지",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/knn_svc_svm_lab/part4_kernel.html#ch16"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/kernel-trick"
    }
   ]
  },
  {
   "@id": "lab:concept/rbf-kernel",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "RBF(가우시안) 커널",
     "@language": "ko"
    },
    {
     "@value": "RBF kernel",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "exp(−γ 거리²). 가까울수록 1, 멀수록 0",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/knn_svc_svm_lab/part4_kernel.html#ch16"
   },
   "lab:partOf": [

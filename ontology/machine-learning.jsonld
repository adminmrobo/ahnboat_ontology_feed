     "@id": "lab:concept/train-test-split"
    },
    {
     "@id": "lab:concept/split-variability"
    }
   ]
  },
  {
   "@id": "lab:concept/sampling-variability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "작은 시험의 흔들림",
     "@language": "ko"
    },
    {
     "@value": "sampling variability of the test score",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시험이 40마리면 1마리 = 2.5%p. 분할만 바꿔도 같은 모델의 점수가 크게 달라진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/01_setting_the_board.html#lv4"
   },
   "lab:relatedTo": [
    {
     "@id": "lab:concept/test-set"
    }
   ]
  },
  {
   "@id": "lab:concept/optimization-layers",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "최적화의 네 층위",
     "@language": "ko"
    },
    {
     "@value": "four layers of optimization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "0층위(판 짜기), ①파라미터, ②하이퍼파라미터, ③모형 구조·결합. 별도 축으로 재현성·신뢰도.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/01_setting_the_board.html#map"
   }
  },
  {
   "@id": "lab:concept/loss-bowl",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "손실 그릇 (지형)",
     "@language": "ko"
    },
    {
     "@value": "loss landscape",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "계수에 따른 손실을 그린 모양. 바닥이 목표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/02_loss_and_gradient.html#lv1"
   },
   "lab:relatedTo": [

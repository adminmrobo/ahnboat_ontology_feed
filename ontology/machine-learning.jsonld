     "@id": "lab:concept/train-test-split"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/overfitting"
    }
   ]
  },
  {
   "@id": "lab:concept/stratified-sampling",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "층화 추출",
     "@language": "ko"
    },
    {
     "@value": "stratified sampling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "집단 비율을 지키며 표본을 뽑는 방법. 적은 어종이 시험에서 빠지지 않게 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/01_setting_the_board.html#lv4"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/train-test-split"
    }
   ]
  },
  {
   "@id": "lab:concept/random-state",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "random_state (시작 번호)",
     "@language": "ko"
    },
    {
     "@value": "random seed (random_state)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무작위 섞기의 시작 번호. 같은 번호면 같은 결과가 다시 나온다. 재현성 도구이지 튜닝 대상이 아니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/01_setting_the_board.html#lv4"
   },
   "lab:partOf": [

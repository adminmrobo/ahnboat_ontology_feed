    }
   ]
  },
  {
   "@id": "lab:concept/step-vs-slope",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "계단과 비탈",
     "@language": "ko"
    },
    {
     "@value": "step vs slope",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정확도는 기울기 0인 계단, 손실은 매끄러운 비탈이라 학습에는 손실을 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/02_loss_and_gradient.html#lv2"
   },
   "lab:prerequisiteOf": [

    {
     "@id": "lab:method/lstm"
    },
    {
     "@id": "lab:method/lstm-prev"
    }
   ]
  },
  {
   "@id": "lab:concept/input-gate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "입력 문",
     "@language": "ko"
    },
    {
     "@value": "Input gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 후보를 셀 상태에 얼마나 적을지 정하는 0~1 값 i.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/lstm"
    }
   ]
  },
  {
   "@id": "lab:concept/output-gate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "출력 문",
     "@language": "ko"
    },
    {
     "@value": "Output gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "셀 상태를 바깥 상태 h로 얼마나 내보낼지 정하는 0~1 값 o.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/lstm"
    }
   ]
  },
  {
   "@id": "lab:concept/gate-sigmoid",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시그모이드 문",
     "@language": "ko"
    },
    {
     "@value": "Sigmoid gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시그모이드로 0~1 값을 내어 곱하는 장치. 0은 막고 1은 통과시키며 값은 걸음마다 입력과 앞 상태를 보고 정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/activation-function"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/lstm"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/forget-gate"
    }
   ]
  },
  {
   "@id": "lab:concept/residual-shortcut",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지름길 연결",
     "@language": "ko"
    },
    {
     "@value": "Shortcut connection",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "6-3 ResNet에서 본, 층을 건너뛰어 정보와 기울기를 전하는 길. 셀 상태는 시간 방향의 비슷한 지름길이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/residual-connections"
    }
   ]
  },
  {
   "@id": "lab:concept/vanishing-gradient",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기울기 소실",
     "@language": "ko"
    },
    {
     "@value": "Vanishing gradient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "펼친 망에서 기울기가 거슬러 오는 동안 거듭 곱해져 작아지는 현상. 앞쪽 입력이 학습에 거의 반영되지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/rnn"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:concept/exploding-gradient"
    }
   ]
  },
  {
   "@id": "lab:method/forget-bias-init",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "망각 문 편향 1 초기화",
     "@language": "ko"
    },
    {
     "@value": "Forget-gate bias initialisation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습 초기에 기억을 지키려고 망각 문 편향을 1로 두는 방법. 이 편은 쓰지 않고 PyTorch 기본값을 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m3"
   }
  },
  {
   "@id": "lab:dataset/optical-digits",
   "@type": [
    "skos:Concept",
    "lab:Dataset"
   ],
   "skos:prefLabel": [
    {
     "@value": "손글씨 8×8 숫자",
     "@language": "ko"
    },
    {
     "@value": "Optical Recognition of Handwritten Digits",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "6-4와 같은 8×8 손글씨 데이터. 줄이나 칸으로 읽어 순서 데이터로 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m2"
   }
  },
  {
   "@id": "lab:concept/sequence-scorecard",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "순서팀 성적표",
     "@language": "ko"
    },
    {
     "@value": "Sequence-team scorecard",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "RNN·LSTM·GRU를 같은 과제로 잰 표. 6-6에서 시작해 이 편에서 둘째 줄을 채우고 6-8에서 완성된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#m5"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/test-accuracy"
    }
   ]
  },
  {
   "@id": "lab:bio/mushroom-body-memory",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 버섯체 시냅스 기억",
     "@language": "ko"
    },
    {
     "@value": "Fly mushroom-body synaptic memory",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "초파리의 기억은 버섯체 출력 시냅스의 세기로 남고 능동적 망각 경로(Rac1)도 있다. 다만 이는 느린 생화학 과정이고 셀 상태는 걸음마다 다시 계산하는 숫자다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-7_lstm.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:concept/cell-state"
    }
   ]
  },
  {
   "@id": "lab:method/lstm-prev",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "LSTM (순서팀 앞 줄)",
     "@language": "ko"
    },
    {
     "@value": "LSTM (previous applicant, 6-7)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "6-7에서 본 문 세 개와 셀 상태의 순환 망. RNN보다 오래 기억하지만 숫자가 RNN의 네 배 가까이 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-8_gru.html#m4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/lstm-gru"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/gru"
    }
   ]
  },
  {
   "@id": "lab:concept/gate-tying",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "잊기와 적기를 묶기",
     "@language": "ko"
    },
    {
     "@value": "Tying forgetting and writing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "LSTM의 망각 문 f와 입력 문 i를 f = z, i = 1 − z로 묶은 셈이다. 남기는 만큼 덜 적고, 출력 문과 셀 상태는 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-8_gru.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/gru"
    }
   ]
  },
  {
   "@id": "lab:concept/train-time",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "학습 시간",
     "@language": "ko"
    },
    {
     "@value": "Training time",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 컴퓨터에서 정해진 에포크를 학습하는 데 걸린 시간. 구현에 따라 파라미터 수와 다르게 움직일 수 있다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-8_gru.html#m4"
   },
   "lab:relatedTo": [
    {
     "@id": "lab:concept/param-count"
    }
   ]
  },
  {
   "@id": "lab:bio/memory-overwrite",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 기억 흔적의 덧씌움",
     "@language": "ko"
    },
    {
     "@value": "Fly memory traces overlaid by new learning",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "초파리의 기억 흔적은 새 학습이 오면 옛 흔적 위에 덧씌워지며 비율이 경험에 따라 바뀐다. 다만 이는 시간이 걸리는 과정이고 GRU의 섞기는 걸음마다 즉시 계산한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-8_gru.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:concept/update-gate"
    }
   ]
  },
  {
   "@id": "lab:method/vit",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "ViT (Vision Transformer)",
     "@language": "ko"
    },
    {
     "@value": "Vision Transformer",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "그림을 조각으로 잘라 토큰으로 쓰고, 맨 앞에 [CLS] 칸을 붙여 인코더 층을 지난 [CLS]로 답하는 Transformer.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-9_transformer.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/transformer"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/svm-senior"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/test-accuracy"
    }
   ]
  },
  {
   "@id": "lab:concept/cls-token",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "[CLS] 토큰",
     "@language": "ko"
    },
    {
     "@value": "[CLS] token",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "답을 낼 자리로 맨 앞에 붙이는 배우는 토큰. 다른 조각을 보며 내용을 모으고 마지막 층의 [CLS]로 숫자를 답한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-9_transformer.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/vit"
    }
   ]
  },
  {
   "@id": "lab:concept/position-embedding",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "위치 임베딩",
     "@language": "ko"
    },
    {
     "@value": "Position embedding",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조각의 자리를 알려 주는 배우는 숫자. 셀프 어텐션이 순서를 모르기 때문에 더한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-9_transformer.html#m4"
   },
   "lab:topic": [

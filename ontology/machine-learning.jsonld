    }
   ]
  },
  {
   "@id": "lab:method/newton",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "뉴턴법",
     "@language": "ko"
    },
    {
     "@value": "Newton method",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "휘어진 정도까지 써서 큰 걸음으로 바닥에 가는 엔진.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

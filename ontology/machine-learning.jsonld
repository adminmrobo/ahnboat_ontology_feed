    }
   ],
   "skos:definition": {
    "@value": "학생이 자기 편 벽을 넘어온 만큼",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/knn_svc_svm_lab/part3_svm.html#ch12"
   },

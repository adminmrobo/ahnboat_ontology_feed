  },
  {
   "@id": "lab:concept/independence",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "독립 사건",
     "@language": "ko"
    },
    {
     "@value": "independent events",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 사건이 일어났다는 사실이 다른 사건의 확률을 바꾸지 않는 관계. P(A∩B) = P(A) × P(B).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/Regression_model_lab_01/part3_resid.html#ch11"

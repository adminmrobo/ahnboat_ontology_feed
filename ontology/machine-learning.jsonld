  {
   "@id": "lab:concept/engine-vs-model",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "같은 모형, 다른 엔진",
     "@language": "ko"
    },
    {
     "@value": "same model, different engine",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "LogisticRegression, 전체 경사하강, SGD는 같은 모형의 계수를 찾는 다른 방법이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/02_loss_and_gradient.html#lv5"

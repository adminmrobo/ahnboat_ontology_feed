    {
     "@id": "lab:topic/autoencoder"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/autoencoder"
    },
    {
     "@id": "lab:method/pca16"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/reconstruction-error"
    },
    {
     "@id": "lab:metric/grader-accuracy"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/digits-1797"
    }
   ]
  },
  {
   "@id": "lab:method/pca16",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "PCA 16성분 투영 복원",
     "@language": "ko"
    },
    {
     "@value": "PCA 16-component projection",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "깨끗한 훈련 글씨로 성분 16개를 구해 번진 글씨를 투영했다가 되살린다. 성분 밖으로 흔들린 잡음이 버려진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/pca"
    }
   ]
  },
  {
   "@id": "lab:concept/corruption",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "데이터 오염",
     "@language": "ko"
    },
    {
     "@value": "Input corruption",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습 입력을 일부러 바꾸는 일(잡음, 칸 지우기). 증강과 닮았지만 정답이 깨끗한 원본이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/data-augmentation"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/dae"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/clean-target"
    }
   ]
  },
  {
   "@id": "lab:concept/gaussian-noise",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가우스 잡음",
     "@language": "ko"
    },
    {
     "@value": "Gaussian noise",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정규분포를 따르는 잡음. 세기는 표준편차 σ이고, 0~1 밝기에서 σ 0.3이면 칸마다 ±0.3 안팎이 흔들린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/corruption"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/noise-mismatch"
    }
   ]
  },
  {
   "@id": "lab:concept/bottleneck-filters-noise",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "병목이 잡음을 거른다",
     "@language": "ko"
    },
    {
     "@value": "Bottleneck filters noise",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잡음은 칸마다 제멋대로 흔들리고 글씨의 꼴은 여러 칸이 함께 움직인다. 병목 16칸은 함께 움직이는 것만 싣는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/dae"
    }
   ]
  },
  {
   "@id": "lab:concept/clean-target",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "정답 자리는 깨끗한 원본",
     "@language": "ko"
    },
    {
     "@value": "Clean target",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잡음은 입력에만 섞고 손실의 정답은 깨끗한 원본으로 둔다. 잡음을 정답에도 섞는 것이 흔한 실수다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/dae"
    }
   ]
  },
  {
   "@id": "lab:concept/noise-mismatch",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "잡음 어긋남",
     "@language": "ko"
    },
    {
     "@value": "Noise mismatch",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "배운 잡음과 시험 잡음의 세기나 종류가 다른 상황. 이때 디노이징은 약해진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m4"
   }
  },
  {
   "@id": "lab:method/identity-baseline",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "그대로 둠",
     "@language": "ko"
    },
    {
     "@value": "Leave as is",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "아무것도 하지 않고 번진 글씨를 그대로 쓰는 기본선. 되살린다고 하면서 이보다 오차가 크면 오히려 망친 것이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m2"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:method/dae"
    }
   ]
  },
  {
   "@id": "lab:metric/grader-accuracy",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "채점관 정확도",
     "@language": "ko"
    },
    {
     "@value": "Grader accuracy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "SVM 채점관이 되살린 글씨를 맞게 읽는 비율. 복원 오차와 별개로 판독 업무를 잰다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#m4"
   }
  },
  {
   "@id": "lab:bio/fly-olfaction",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 후각계",
     "@language": "ko"
    },
    {
     "@value": "Fly olfactory system",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "바람 따라 끊기고 흔들리는 냄새 신호에서도 같은 냄새를 알아보는 것과 닮았다. 다만 초파리는 이 강건함을 진화로 얻었고 디노이징은 데이터로 배운다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-12_denoising_ae.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:method/dae"
    }
   ]
  },
  {
   "@id": "lab:method/vae",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "변분 오토인코더",
     "@language": "ko"
    },
    {
     "@value": "Variational autoencoder (VAE)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "글씨를 병목의 점이 아니라 작은 구름(평균과 흩어짐)으로 줄이고, 구름이 표준 정규분포를 닮도록 벌점(KL)을 주는 생성 모델. 표준 정규분포에서 뽑은 z를 디코더에 넣으면 새 글씨가 나온다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/vae"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/gmm-senior"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/recognizable-ratio"
    },
    {
     "@id": "lab:metric/evenness"
    },
    {
     "@id": "lab:metric/nearest-train-distance"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/gan"
    }
   ]
  },
  {
   "@id": "lab:method/gmm-senior",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "GMM 40묶음 (선배)",
     "@language": "ko"
    },
    {
     "@value": "GMM with 40 clusters (senior)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1차 공채의 선배. 종 모양 40개를 덮어 두고 거기서 표본을 뽑아 새 글씨를 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/density-estimation"
    }
   ]
  },
  {
   "@id": "lab:concept/reparameterization",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "재매개변수화",
     "@language": "ko"
    },
    {
     "@value": "Reparameterization trick",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "z = μ + σε로 써서 뽑기(ε)를 바깥으로 빼는 방법. 기울기가 μ와 σ로 흐른다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m4"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/vae"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/elbo"
    }
   ]
  },
  {
   "@id": "lab:concept/kl-divergence",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "KL 발산",
     "@language": "ko"
    },
    {
     "@value": "KL divergence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 분포가 얼마나 다른지 재는 값. VAE에서는 각 구름과 표준 정규분포의 차이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/information-theory"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/elbo"
    }
   ]
  },
  {
   "@id": "lab:concept/elbo",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "ELBO",
     "@language": "ko"
    },
    {
     "@value": "Evidence lower bound (ELBO)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "복원 항과 KL 항을 합친 VAE의 목적 함수(증거 하한).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m4"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/vae"
    }
   ]
  },
  {
   "@id": "lab:concept/kl-weight",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "KL 무게 β",
     "@language": "ko"
    },
    {
     "@value": "KL weight (β)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "KL 항에 곱하는 무게. 이 편은 β = 1로 쓰고 0인 경우와 비교한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m4"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/elbo"
    }
   ]
  },
  {
   "@id": "lab:metric/recognizable-ratio",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "알아볼 수 있는 비율",
     "@language": "ko"
    },
    {
     "@value": "Recognizable ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "채점관이 최고 확률 0.9를 넘게 읽은 새 글씨의 비율. 진짜 글씨 1,000장이 천장이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/accuracy-metrics"
    }
   ]
  },
  {
   "@id": "lab:metric/evenness",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "고른 정도",
     "@language": "ko"
    },
    {
     "@value": "Evenness (normalized entropy)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "채점관이 읽은 숫자 분포의 정규화 엔트로피. 1이면 열 숫자를 똑같이 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m2"
   }
  },
  {
   "@id": "lab:metric/nearest-train-distance",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "가장 가까운 훈련 글씨까지의 거리",
     "@language": "ko"
    },
    {
     "@value": "Distance to nearest training digit",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 글씨 200장마다 가장 가까운 훈련 글씨까지의 제곱 거리 평균. 너무 작으면 베낀 것은 아닌지 그림으로 확인한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-13_vae.html#m2"
   }
  },
  {
   "@id": "lab:method/generator",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "생성자 (위조범)",
     "@language": "ko"
    },
    {
     "@value": "Generator",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잡음 z 16칸을 받아 글씨 64칸을 만드는 망. 진짜 글씨는 보지 못하고 감별사를 거쳐 오는 기울기로만 배운다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/gan"
    }
   ]
  },
  {
   "@id": "lab:method/discriminator",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "판별자 (감별사)",
     "@language": "ko"
    },
    {
     "@value": "Discriminator",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "글씨 64칸을 받아 진짜일 점수 1칸을 내는 분류기. 학습에만 쓰고 글씨를 쓸 때는 필요 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/supervised-learning"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/gan"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/alternating-training"
    }
   ]
  },
  {
   "@id": "lab:concept/alternating-training",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "번갈아 학습",
     "@language": "ko"
    },
    {
     "@value": "Alternating updates",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "감별사 한 걸음(위조범 고정), 위조범 한 걸음(감별사 고정)을 30,000번 되풀이한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/gan"
    }
   ]
  },
  {
   "@id": "lab:concept/detach",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "detach",
     "@language": "ko"
    },
    {
     "@value": "detach",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "텐서를 계산 그래프에서 떼어 내 기울기가 그 뒤로 흐르지 않게 한다. 감별사 걸음에서 위조범이 함께 배우지 않게 하는 데 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#m3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/alternating-training"
    }
   ]
  },
  {
   "@id": "lab:concept/label-smoothing",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "한쪽 라벨 누그러뜨리기",
     "@language": "ko"
    },
    {
     "@value": "One-sided label smoothing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "진짜 라벨을 1 대신 0.9로 주어 판별자가 지나치게 확신하지 않게 하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#m3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/discriminator"
    }
   ]
  },
  {
   "@id": "lab:concept/intermediate-record",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "중간 기록",
     "@language": "ko"
    },
    {
     "@value": "Intermediate checkpoints scoring",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "8,000 · 15,000 · 30,000걸음마다 새 글씨를 채점해 남긴 기록. 판정은 30,000걸음으로 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#m2"
   },
   "lab:partOf": [
    {
     "@id": "lab:metric/recognizable-ratio"
    }
   ]
  },
  {
   "@id": "lab:bio/courtship-song",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 구애 노래와 가려듣기",
     "@language": "ko"
    },
    {
     "@value": "Fly courtship song and female choice",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "수컷이 노래하고 암컷이 같은 종의 노래인지 가려 받아들이며 만드는 쪽과 가리는 쪽이 함께 다듬어진다. 다만 이는 수많은 세대의 진화이고 GAN은 몇 분의 학습이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-14_gan.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:method/gan"
    }
   ]
  },
  {
   "@id": "lab:method/diffusion",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "확산 모델 (DDPM)",
     "@language": "ko"
    },
    {
     "@value": "Diffusion model (DDPM)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터에 잡음을 조금씩 더하는 정해진 과정을 두고 각 단계의 잡음을 맞히는 망을 배워, 순수한 잡음에서 그 과정을 거꾸로 밟아 표본을 만드는 생성 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/diffusion"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/gan"
    },
    {
     "@id": "lab:method/gmm-senior"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/ddim"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/recognizable-ratio"
    }
   ]
  },
  {
   "@id": "lab:concept/forward-process",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "더하는 길",
     "@language": "ko"
    },
    {
     "@value": "Forward process",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정해진 일정대로 T = 200걸음 동안 잡음을 더해 글씨를 순수한 잡음으로 만드는 과정. 배우지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/diffusion"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/reverse-process"
    }
   ]
  },
  {
   "@id": "lab:concept/reverse-process",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "거꾸로 걷기",
     "@language": "ko"
    },
    {
     "@value": "Reverse process",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순수한 잡음에서 출발해 망이 맞힌 잡음을 한 걸음씩 덜어 내며 200걸음 만에 새 글씨에 닿는 과정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/diffusion"
    }
   ]
  },
  {
   "@id": "lab:concept/noise-schedule",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "코사인 일정",
     "@language": "ko"
    },
    {
     "@value": "Cosine noise schedule",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "걸음마다 잡음을 얼마나 더할지 정한 표. 이 편은 코사인 일정을 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/forward-process"
    }
   ]
  },
  {
   "@id": "lab:concept/alpha-bar",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "ᾱ (알파 바)",
     "@language": "ko"
    },
    {
     "@value": "Alpha-bar",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "t걸음 뒤 원래 글씨가 남은 비율(의 제곱). 1에서 0으로 줄어든다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/noise-schedule"
    }
   ]
  },
  {
   "@id": "lab:method/noise-predictor",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "잡음 맞히기 망",
     "@language": "ko"
    },
    {
     "@value": "Noise-prediction network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잡음 섞인 글씨 x_t와 걸음 t를 받아 섞인 잡음 ε를 맞히는 MLP. 걸음 임베딩 128칸을 함께 넣는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/diffusion"
    }
   ]
  },
  {
   "@id": "lab:concept/noise-prediction-loss",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "잡음 예측 손실",
     "@language": "ko"
    },
    {
     "@value": "Noise-prediction loss",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "아무 걸음 t나 뽑아 그만큼 잡음을 섞은 글씨를 주고 섞은 잡음을 맞히는 제곱 오차 하나. 감별사도 KL도 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/loss-function"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/noise-predictor"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/reverse-process"
    }
   ]
  },
  {
   "@id": "lab:concept/ema",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "EMA",
     "@language": "ko"
    },
    {
     "@value": "Exponential moving average (EMA)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가중치의 지수 이동 평균(0.999). 글씨를 생성할 때 흔들림을 줄인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/reproducibility"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/noise-predictor"
    }
   ]
  },
  {
   "@id": "lab:method/denoising-ae",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "디노이징 오토인코더 (6-12)",
     "@language": "ko"
    },
    {
     "@value": "Denoising autoencoder (6-12)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 가지 세기의 잡음을 한 번에 걷어 내는 망. 확산 모델은 그것을 200가지 세기로 나눠 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/autoencoder"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/diffusion"
    }
   ]
  },
  {
   "@id": "lab:method/ddim",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "DDIM",
     "@language": "ko"
    },
    {
     "@value": "Denoising diffusion implicit models (DDIM)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "걸음을 건너뛰며 더 적은 횟수로 표본을 만드는 확산 모델의 가속 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#m6"
   }
  },
  {
   "@id": "lab:bio/odor-diffusion",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "공기 중으로 퍼지는 냄새 분자",
     "@language": "ko"
    },
    {
     "@value": "Odor molecules diffusing in air",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "초파리가 맡는 냄새 분자도 공기 중에서 확산하며 흐려진다. 확산 모델의 이름이 이 물리 현상에서 왔다. 다만 물리적 확산은 되돌릴 수 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-15_diffusion.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:concept/forward-process"
    }
   ]
  },
  {
   "@id": "lab:method/perceptron-rule",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "퍼셉트론 규칙",
     "@language": "ko"
    },
    {
     "@value": "Perceptron learning rule",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "틀린 샘플에서만 w ← w + η·t·x, b ← b + η·t로 고치는 학습 규칙.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-1_perceptron.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/perceptron"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/online-learning"
    }
   ]
  },
  {
   "@id": "lab:concept/bce",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이진 교차 엔트로피",
     "@language": "ko"
    },
    {
     "@value": "Binary cross-entropy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정답 확률의 −log를 손실로 쓰는 이진 분류 손실. 맞힌 샘플에서도 확신이 모자라면 조금씩 배운다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-1_perceptron.html#m3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/loss-function"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/logistic-regression"
    }
   ]
  },
  {
   "@id": "lab:concept/linear-separability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "선형 분리 가능",
     "@language": "ko"
    },
    {
     "@value": "Linear separability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선(초평면) 하나로 두 무리를 하나도 틀리지 않게 가를 수 있는 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-1_perceptron.html#m4"
   }
  },
  {
   "@id": "lab:method/averaged-perceptron",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균 퍼셉트론",
     "@language": "ko"
    },
    {
     "@value": "Averaged perceptron",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습 중 거쳐 간 가중치를 모두 평균 내어 판정에 쓰는 퍼셉트론. 마지막 수정에 덜 흔들린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-1_perceptron.html#m5"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/perceptron"
    }
   ]
  },
  {
   "@id": "lab:concept/online-learning",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "온라인 학습",
     "@language": "ko"
    },
    {
     "@value": "Online learning",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터를 한 줄씩 받을 때마다 바로 고치며 배우는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-1_perceptron.html#m6"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/sgd-minibatch"
    }
   ]
  },
  {
   "@id": "lab:bio/mbon",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 버섯체 출력 뉴런",
     "@language": "ko"
    },
    {
     "@value": "Fruit-fly mushroom body output neuron",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "입력을 모아 문턱을 넘으면 신호를 낸다. 다만 진짜 뉴런의 문턱은 고정되어 있지 않고 신호는 시간에 따라 튀는 펄스다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-1_perceptron.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:method/perceptron"
    }
   ]
  },
  {
   "@id": "lab:concept/relu",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "ReLU",
     "@language": "ko"
    },
    {
     "@value": "ReLU",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "max(0, z). 음수를 0으로 눌러 선을 꺾인 판으로 바꾸는 활성화 함수. 판을 더해 굽은 경계를 만든다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-2_mlp.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/activation-function"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/mlp"
    }
   ]
  },
  {
   "@id": "lab:concept/fully-connected",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "완전 연결",
     "@language": "ko"
    },
    {
     "@value": "Fully connected",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 층의 모든 뉴런이 다음 층의 모든 뉴런과 이어진 구조. PyTorch의 nn.Linear다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-2_mlp.html#overview"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/mlp"
    }
   ]
  },
  {
   "@id": "lab:concept/momentum",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "모멘텀",
     "@language": "ko"
    },
    {
     "@value": "Momentum",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞 걸음의 방향을 일부 이어 가며 내려가는 경사 하강법. 골짜기에서 덜 지그재그로 간다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-2_mlp.html#m4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/momentum-adam"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/adam"
    }
   ]
  },
  {
   "@id": "lab:concept/validation-split",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "검증 몫",
     "@language": "ko"
    },
    {
     "@value": "Validation split",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "훈련 772건에서 15%(116건)를 다시 떼어, 언제 멈출지 고르는 데만 쓰는 몫. 시험지와 다르다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-2_mlp.html#m2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/data-splitting"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/early-stopping"
    }
   ]
  },
  {
   "@id": "lab:method/residual-block",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "잔차 블록",
     "@language": "ko"
    },
    {
     "@value": "Residual block",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Linear → ReLU → Linear로 F(x)를 계산하고 입력 x를 더해 h = ReLU(x + F(x))를 내는 단위. 입력에서 얼마나 바꿀지만 배운다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-3_resnet.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/resnet"
    }
   ]
  },
  {
   "@id": "lab:method/plain-deep-network",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "평범한 깊은 망",
     "@language": "ko"
    },
    {
     "@value": "Plain deep network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "지름길 없이 블록을 쌓은 망. 26층에서는 입력 쪽 층이 배우지 못해 출력이 평균 근처에 머문다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-3_resnet.html#m4"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/resnet"
    }
   ]
  },
  {
   "@id": "lab:method/tabular-resnet",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "표 데이터용 ResNet",
     "@language": "ko"
    },
    {
     "@value": "ResNet for tabular data",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "완전 연결 층으로 블록을 짠 ResNet 변형. 표 데이터의 기준선으로 연구된 구조다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-3_resnet.html#m6"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/resnet"
    }
   ]
  },
  {
   "@id": "lab:concept/exploding-gradient",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "기울기 폭발",
     "@language": "ko"
    },
    {
     "@value": "Exploding gradient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "반대로 층을 지날수록 기울기가 커져 학습이 튕겨 나가는 현상.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-3_resnet.html#glossary-sec"
   }
  },
  {
   "@id": "lab:concept/he-init",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "He 초기화",
     "@language": "ko"
    },
    {
     "@value": "He initialization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "ReLU 망에서 층마다 값의 크기가 유지되도록 가중치를 N(0, 2/입력 수)에서 뽑는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-3_resnet.html#m4"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/plain-deep-network"
    }
   ]
  },
  {
   "@id": "lab:concept/batch-norm",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "배치 정규화",
     "@language": "ko"
    },
    {
     "@value": "Batch normalization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "층마다 미니배치의 평균·분산으로 값을 맞추는 층. 원래 ResNet 블록 안에 있지만 이 편은 지름길의 효과만 보려고 뺐다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-3_resnet.html#m3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/normalization-layers"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/plain-deep-network"
    }
   ]
  },
  {
   "@id": "lab:concept/convolution",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "합성곱",
     "@language": "ko"
    },
    {
     "@value": "Convolution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "필터를 한 자리에 대고 겹친 칸끼리 곱해 더한 값을 그 자리의 점수로 삼고, 모든 자리에서 같은 일을 되풀이하는 계산.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-4_cnn.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/convolution"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/cnn"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/equivariance"
    }
   ]
  },
  {
   "@id": "lab:concept/equivariance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "등변성",
     "@language": "ko"
    },
    {
     "@value": "Equivariance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "입력이 밀리면 출력도 똑같이 밀리는 성질. 합성곱이 가진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-4_cnn.html#m1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/invariance"
    }
   ]
  },
  {
   "@id": "lab:method/svm-senior",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "SVM (선배)",
     "@language": "ko"
    },
    {
     "@value": "SVM (senior)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1차 공채 5-8에서 합격한 선배. 64칸을 한 줄로 펴서 읽고, 밀린 사본을 섞어 배우면 다시 잘 맞힌다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-4_cnn.html#m5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/svm"
    }
   ]
  },
  {
   "@id": "lab:dataset/shifted-test",
   "@type": [
    "skos:Concept",
    "lab:Dataset"
   ],
   "skos:prefLabel": [
    {
     "@value": "밀린 시험지",
     "@language": "ko"
    },
    {
     "@value": "Shifted test set",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "봉인된 시험지 450장을 한 칸씩 민 것. 학습에는 한 번도 쓰지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-4_cnn.html#m2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/distribution-shift"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:dataset/digits"
    }
   ]
  },
  {
   "@id": "lab:bio/t4t5",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 눈의 움직임 탐지 신경",
     "@language": "ko"
    },
    {
     "@value": "Fly elementary motion detectors (T4/T5)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작은 영역마다 같은 방식으로 움직임의 방향을 잰다. 다만 시간에 따라 바뀌는 빛을 재고, CNN 필터는 정지한 공간 무늬만 본다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-4_cnn.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:method/cnn"
    }
   ]
  },
  {
   "@id": "lab:method/siamese",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "샴 네트워크",
     "@language": "ko"
    },
    {
     "@value": "Siamese network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 망을 두(세) 갈래로 써서 글씨를 임베딩으로 바꾸고, 그 거리로 같은 숫자인지 판정하는 틀. 이 편은 0~4로 배워 처음 보는 5~9를 견본으로 알아본다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/contrastive"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/knn-pixels"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/hard-triplet-mining"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/unseen-accuracy"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/digits"
    }
   ]
  },
  {
   "@id": "lab:concept/shared-weights",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가중치를 나눠 쓰는 쌍둥이",
     "@language": "ko"
    },
    {
     "@value": "Shared-weight twins",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "갈래마다 같은 망을 쓰면 같은 글씨가 같은 점이 되어 거리를 잴 수 있다. 서로 다른 망이면 거리가 뜻을 잃는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/siamese"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/embedding"
    }
   ]
  },
  {
   "@id": "lab:concept/unit-norm",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "길이 1로 맞추기",
     "@language": "ko"
    },
    {
     "@value": "Unit-length normalization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "임베딩을 구 표면 위의 점으로 맞추는 것. 방향만으로 같음과 다름을 나눠야 하므로 점을 마구 키워 손실을 피할 수 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/siamese"
    }
   ]
  },
  {
   "@id": "lab:method/contrastive-loss",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "대조 손실",
     "@language": "ko"
    },
    {
     "@value": "Contrastive loss",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 장씩 같으면 당기고 다르면 여유만큼 밀어내는 손실. 삼중항 손실의 두 장 버전이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#glossary-sec"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/contrastive"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/triplet-loss"
    }
   ]
  },
  {
   "@id": "lab:concept/margin",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "여유 (margin)",
     "@language": "ko"
    },
    {
     "@value": "Margin",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다른 종류가 같은 종류보다 얼마나 더 멀어야 벌점이 없는지 정하는 값 m.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/triplet-loss"
    },
    {
     "@id": "lab:method/svm"
    },
    {
     "@id": "lab:concept/maximal-margin"
    }
   ]
  },
  {
   "@id": "lab:method/hard-triplet-mining",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "어려운 세 장 고르기",
     "@language": "ko"
    },
    {
     "@value": "Hard triplet mining",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "묶음 안에서 다른 숫자인데 가까운 세 장을 골라 배우는 방법. 이 편은 공정한 비교를 위해 무작위로 고른다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m4"
   }
  },
  {
   "@id": "lab:concept/few-shot",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "퓨샷 학습",
     "@language": "ko"
    },
    {
     "@value": "Few-shot learning",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "종류마다 견본 몇 장만으로 알아보는 일. 새 종류는 견본만 등록하면 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/transfer-learning"
    }
   ]
  },
  {
   "@id": "lab:method/one-nn",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "1-NN 판정",
     "@language": "ko"
    },
    {
     "@value": "1-nearest-neighbour decision",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시험 글씨와 가장 가까운 견본 하나의 숫자를 그대로 답하는 판정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/few-shot"
    }
   ]
  },
  {
   "@id": "lab:method/knn-pixels",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "KNN 픽셀 거리 (선배)",
     "@language": "ko"
    },
    {
     "@value": "KNN on pixels (senior)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1차 공채 5-1의 선배. 같은 1-NN을 임베딩 없이 64칸 픽셀의 거리로 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/knn"
    }
   ]
  },
  {
   "@id": "lab:metric/unseen-accuracy",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "처음 보는 숫자 정확도 (씨앗 5개 평균)",
     "@language": "ko"
    },
    {
     "@value": "Unseen-digit accuracy (mean of 5 seeds)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시험 글씨 5~9를 견본 1장과 5장으로 판정했을 때 맞힌 비율. 배운 숫자 0~4의 정확도와 나란히 본다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#m5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/accuracy-metrics"
    }
   ]
  },
  {
   "@id": "lab:bio/kenyon",
   "@type": [
    "skos:Concept",
    "lab:BioAnalogue"
   ],
   "skos:prefLabel": [
    {
     "@value": "초파리 버섯체 케년 세포의 냄새 코드",
     "@language": "ko"
    },
    {
     "@value": "Fly mushroom body Kenyon-cell odor code",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "냄새마다 소수의 세포만 켜지고 비슷한 냄새는 겹치는 코드가 된다. 다만 연결은 대부분 무작위이고 샴의 임베딩은 손실로 배운다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-5_siamese.html#analogy-sec"
   },
   "lab:bioAnalogueOf": [
    {
     "@id": "lab:concept/embedding"
    }
   ]
  },
  {
   "@id": "lab:concept/time-step",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "걸음",
     "@language": "ko"
    },
    {
     "@value": "Time step",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순서의 한 칸. 이 편에서는 한 줄(8칸) 또는 한 칸이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/DL_model_hiring_committee/6-6_rnn.html#m2"
   },

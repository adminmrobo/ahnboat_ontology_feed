     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "변수끼리 함께 움직이는 관계(공분산)를 반영해 잰 거리. 관계를 깨는 점이 멀게 나온다.",
    "@language": "ko"
   },

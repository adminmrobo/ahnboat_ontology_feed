    }
   ]
  },
  {
   "@id": "lab:concept/confident-error",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자신 있게 틀림",
     "@language": "ko"
    },
    {
     "@value": "confident error",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "틀린 답에 높은 확률을 주면 크로스 엔트로피가 크게 늘어난다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/02_loss_and_gradient.html#lv3"
   },
   "lab:partOf": [

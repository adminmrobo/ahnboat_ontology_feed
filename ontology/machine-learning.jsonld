   ],
   "skos:prefLabel": [
    {
     "@value": "사후 확률",
     "@language": "ko"
    },
    {
     "@value": "posterior probability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 정보를 반영해 고친 확률. P(A|B)",

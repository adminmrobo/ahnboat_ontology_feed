     "@value": "계수의 동태",
     "@language": "ko"
    },
    {
     "@value": "coefficient dynamics",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "업데이트마다 35개 계수가 각자 학습률 × 자기 기울기만큼 동시에 움직이는 과정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fish_market_learning_epoch_etc/02_loss_and_gradient.html#lv6"

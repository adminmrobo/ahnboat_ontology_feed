   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "기상 인공지능",
     "@language": "ko"
    },
    {
     "@value": "Machine-learning weather prediction",
     "@language": "en"
    }

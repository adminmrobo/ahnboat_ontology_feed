     "@value": "전환 가격",
     "@language": "ko"
    },
    {
     "@value": "switching price",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 공정의 이윤이 같아져 선택이 바뀌는 가격.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

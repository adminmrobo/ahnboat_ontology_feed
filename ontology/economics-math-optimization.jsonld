   ],
   "skos:prefLabel": [
    {
     "@value": "모서리해",
     "@language": "ko"
    },
    {
     "@value": "corner solution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최적점이 가능 범위의 끝(0이나 최대치)에 있는 해.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

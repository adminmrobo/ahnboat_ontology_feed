    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "오일러 방법(계단 풀이)",
     "@language": "ko"
    },
    {
     "@value": "Euler method",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "짧은 Δt마다 기울기 × Δt만큼 이동해 미분방정식을 푼다.",
    "@language": "ko"
   },

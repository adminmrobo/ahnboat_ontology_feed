   ]
  },
  {
   "@id": "lab:term/exogenous-variable",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "외생변수",
     "@language": "ko"
    },
    {
     "@value": "exogenous variable",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모형 밖에서 주어진다고 두는 변수(예: 소득, 날씨, 다른 시장 가격을 고정할 때).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

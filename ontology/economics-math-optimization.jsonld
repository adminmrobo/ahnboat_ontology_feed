  {
   "@id": "lab:concept/elasticity-revenue",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "탄력성과 총수입",
     "@language": "ko"
    },
    {
     "@value": "elasticity and total revenue",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격 변화가 매출(가격 × 판매량)에 주는 효과는 탄력성이 1보다 큰지 작은지에 따라 반대가 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/04_elasticity.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/elasticity"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/income-cross-elasticity"
    }
   ]
  },
  {
   "@id": "lab:concept/income-cross-elasticity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "소득·교차·공급 탄력성",
     "@language": "ko"
    },
    {
     "@value": "income, cross-price and supply elasticity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "소득·다른 재화 가격·자기 가격에 대해 수요량 또는 공급량이 반응하는 정도.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/04_elasticity.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/elasticity"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/price-ceiling"
    }
   ]
  },
  {
   "@id": "lab:term/elastic",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "탄력적",
     "@language": "ko"
    },
    {
     "@value": "elastic",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "탄력성이 1보다 큼. 가격에 크게 반응.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/04_elasticity.html#lv1"

    }
   ]
  },
  {
   "@id": "lab:concept/market-supply",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시장 공급",
     "@language": "ko"
    },
    {
     "@value": "market supply",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 가격에서 모든 기업의 공급량을 더한 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/market-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/free-entry",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "자유진입",
     "@language": "ko"
    },
    {
     "@value": "free entry",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기업이 비용 없이(또는 비용을 반영해) 들어오고 나갈 수 있는 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/efficient-scale",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "효율적 규모",
     "@language": "ko"
    },
    {
     "@value": "efficient scale",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "평균비용이 가장 낮은 산출량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/constant-cost",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "일정비용 산업",
     "@language": "ko"
    },
    {
     "@value": "constant-cost industry",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "산업 규모가 변해도 요소가격이 변하지 않는 산업. 장기 공급이 수평.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   },
   "lab:partOf": [

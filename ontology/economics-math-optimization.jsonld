     "@id": "lab:concept/expenditure-function"
    }
   ]
  },
  {
   "@id": "lab:concept/expenditure-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지출함수",
     "@language": "ko"
    },
    {
     "@value": "expenditure function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 목표 효용의 함수로 본 최소 지출.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/compensating-variation"
    }
   ]
  },
  {
   "@id": "lab:concept/budget-set",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "예산집합",
     "@language": "ko"
    },
    {
     "@value": "budget set",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 소득으로 살 수 있는 묶음 전체.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:concept/utility-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "효용함수",
     "@language": "ko"
    },
    {
     "@value": "utility function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선호 순서를 숫자로 나타낸 것. 증가변환해도 같은 선호.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:term/ordinal-utility",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "서수적 효용",
     "@language": "ko"
    },
    {
     "@value": "ordinal utility",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순서만 의미 있고 차이의 크기는 의미 없는 효용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv1"

   ],
   "skos:prefLabel": [
    {
     "@value": "실질 GDP",
     "@language": "ko"
    },
    {
     "@value": "real GDP",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기준연도 가격으로 잰 GDP.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/gdp"
    }
   ]
  },
  {
   "@id": "lab:term/gdp-deflator",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "GDP 디플레이터",
     "@language": "ko"
    },
    {
     "@value": "GDP deflator",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "명목 GDP ÷ 실질 GDP × 100. 종합 물가 지표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv1"
   },
   "lab:partOf": [

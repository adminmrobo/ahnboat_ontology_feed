     "@id": "lab:concept/cost-function"
    }
   ]
  },
  {
   "@id": "lab:concept/average-variable-cost",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균가변비용",
     "@language": "ko"
    },
    {
     "@value": "average variable cost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가변비용 ÷ 생산량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv3"
   },
   "lab:partOf": [

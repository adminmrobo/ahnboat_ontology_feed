   "@id": "lab:method/curvature-step-limit",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "③ 굽음으로 보폭 한계 정하기",
     "@language": "ko"
    },
    {
     "@value": "Curvature-based step limit",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "헤시안의 가장 큰 고유값으로 학습률의 상한 2/λmax를 정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

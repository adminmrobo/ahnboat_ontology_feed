    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "미분방정식",
     "@language": "ko"
    },
    {
     "@value": "Differential equation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "지금 상태가 변화 속도를 정하는 식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

  {
   "@id": "lab:concept/tangency-condition",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "닿는 점 조건 ∇f = λ∇g",
     "@language": "ko"
    },
    {
     "@value": "Tangency condition",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "닿는 점에서 목표와 울타리의 기울기 화살표가 한 직선 위에 놓인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/lagrange_multiplier_lab/index.html#s2"
   },

  {
   "@id": "lab:concept/solow-steady-state",
   "@type": [
    "skos:Concept",
    "lab:Theory"
   ],
   "skos:prefLabel": [
    {
     "@value": "솔로우 모형과 정상상태",
     "@language": "ko"
    },
    {
     "@value": "Solow model and steady state",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "저축으로 새로 쌓는 자본과 닳고 나눠지는 자본이 같아지는 정상상태에서, 1인당 소득은 기술 성장률만큼 자란다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/pacing_problem_lab/index.html#lv1"
   },
   "lab:topic": [

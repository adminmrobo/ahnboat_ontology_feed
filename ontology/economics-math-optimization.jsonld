    }
   ]
  },
  {
   "@id": "lab:concept/counterexample-museum",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "반례 박물관",
     "@language": "ko"
    },
    {
     "@value": "gallery of counterexamples",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무한 교집합, 무한 이산 공간, 픽셀 역설, 카포비치 반례, 모듈러 군, 캔터 집합처럼 흔한 일반화를 깨는 예들의 모음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/topology_ai_lab/15_final_review.html#lv2"
   }
  },

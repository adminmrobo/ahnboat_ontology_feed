    },
    {
     "@value": "Afriat's theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "GARP 만족 ⇔ 연속·단조·오목 효용으로 합리화 가능.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

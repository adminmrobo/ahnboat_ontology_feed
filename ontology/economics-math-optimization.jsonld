    }
   ]
  },
  {
   "@id": "lab:concept/mrs",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "한계대체율",
     "@language": "ko"
    },
    {
     "@value": "marginal rate of substitution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "효용을 유지하며 x 하나와 바꿀 수 있는 y의 양.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv2"
   },
   "lab:prerequisiteOf": [

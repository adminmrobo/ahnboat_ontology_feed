     "@id": "lab:method/gradient-descent"
    }
   ]
  },
  {
   "@id": "lab:method/vanilla-sgd",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "바닐라 SGD",
     "@language": "ko"
    },
    {
     "@value": "Vanilla SGD",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관성이나 보폭 조절 없이 θ ← θ − η·g만 쓰는 기본 걸음법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_test_lab/index.html#p5"
   },

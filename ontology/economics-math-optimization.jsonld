    }
   ]
  },
  {
   "@id": "lab:concept/labor-statistics",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "고용 지표",
     "@language": "ko"
    },
    {
     "@value": "labor force statistics",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생산가능인구를 취업자·실업자·비경제활동인구로 나눠 계산하는 실업률·경제활동참가율·고용률.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/leisure-consumption-choice"
    }
   ]
  },
  {
   "@id": "lab:concept/leisure-consumption-choice",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "여가-소비 선택",
     "@language": "ko"
    },
    {
     "@value": "leisure-consumption choice",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "효용 U(C, L)을 예산 C = w(T − L) + V 안에서 고르는 노동공급의 기본 모형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/optimal-labor-supply"
    }
   ]
  },
  {
   "@id": "lab:concept/optimal-labor-supply",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "최적 근로시간",
     "@language": "ko"
    },
    {
     "@value": "optimal labor supply",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무차별곡선과 예산선이 접하는 MRS = w 조건으로 구한 근로시간. 접점이 없으면 코너해.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/income-substitution-effects"
    }
   ]
  },
  {
   "@id": "lab:term/unemployment-rate",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "실업률",
     "@language": "ko"
    },
    {
     "@value": "unemployment rate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "실업자 ÷ 경제활동인구 × 100.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/unemployment-rate"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/labor-statistics"
    }
   ]
  },
  {
   "@id": "lab:term/lfpr",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "경제활동참가율",
     "@language": "ko"
    },
    {
     "@value": "labor force participation rate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "경제활동인구 ÷ 생산가능인구 × 100.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/labor-statistics"
    }
   ]
  },
  {
   "@id": "lab:concept/discouraged-worker",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "실망실업자",
     "@language": "ko"
    },
    {
     "@value": "discouraged worker",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "취업 가능성이 낮다고 보고 구직을 포기해 비경제활동인구로 분류되는 사람.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/labor-statistics"
    }
   ]
  },
  {
   "@id": "lab:term/indifference-curve",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "무차별곡선",
     "@language": "ko"
    },
    {
     "@value": "indifference curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 효용을 주는 소비·여가 조합을 이은 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/indifference-curves"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/leisure-consumption-choice"
    }
   ]
  },
  {
   "@id": "lab:term/mrs",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "한계대체율",
     "@language": "ko"
    },
    {
     "@value": "marginal rate of substitution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "여가 1단위를 위해 포기할 용의가 있는 소비. 무차별곡선 기울기의 절댓값.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/leisure-consumption-choice"
    }
   ]
  },
  {
   "@id": "lab:term/budget-line",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "예산선",
     "@language": "ko"
    },
    {
     "@value": "budget line",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "C = w(T − L) + V. 시급과 비근로소득으로 가능한 조합.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/leisure-consumption-choice"
    }
   ]
  },
  {
   "@id": "lab:term/nonlabor-income",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "비근로소득",
     "@language": "ko"
    },
    {
     "@value": "nonlabor income",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일과 상관없이 들어오는 소득(이자·이전소득 등).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/leisure-consumption-choice"
    }
   ]
  },
  {
   "@id": "lab:concept/reservation-wage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "유보임금",
     "@language": "ko"
    },
    {
     "@value": "reservation wage",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이 시급보다 낮으면 일하지 않는 문턱. 일하지 않는 점의 MRS.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/optimal-labor-supply"
    },
    {
     "@id": "lab:concept/discouraged-worker"
    }
   ]
  },
  {
   "@id": "lab:term/corner-solution",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "코너해",
     "@language": "ko"
    },
    {
     "@value": "corner solution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "접점이 아닌 끝점(일하지 않음)이 최선인 해.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/02_labor_supply.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/optimal-labor-supply"
    },
    {
     "@id": "lab:concept/threshold-wage"
    },
    {
     "@id": "lab:concept/sunk-cost"
    },
    {
     "@id": "lab:concept/mrs"
    }
   ]
  },
  {
   "@id": "lab:concept/income-substitution-effects",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대체효과와 소득효과",
     "@language": "ko"
    },
    {
     "@value": "substitution and income effects",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "임금 변화의 근로시간 효과를 상대가격 변화(대체)와 실질소득 변화(소득)로 나눈 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/labor-supply-curve"
    }
   ]
  },
  {
   "@id": "lab:concept/labor-supply-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "노동공급곡선",
     "@language": "ko"
    },
    {
     "@value": "labor supply curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "임금과 최적 근로시간의 관계. 소득효과가 커지면 뒤로 굽는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/eitc"
    }
   ]
  },
  {
   "@id": "lab:concept/eitc",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "근로장려세제(EITC)",
     "@language": "ko"
    },
    {
     "@value": "earned income tax credit",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "근로소득이 있어야 지급하는 세액공제. 증가·정액·감소 구간으로 예산선을 꺾는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/short-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/substitution-effect",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대체효과",
     "@language": "ko"
    },
    {
     "@value": "substitution effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "효용을 그대로 두고 여가의 상대가격(임금)만 바뀐 효과. 임금↑ → 근로↑.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-substitution-effects"
    }
   ]
  },
  {
   "@id": "lab:term/income-effect",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "소득효과",
     "@language": "ko"
    },
    {
     "@value": "income effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "실질소득 변화의 효과. 여가가 정상재면 소득↑ → 근로↓.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-substitution-effects"
    }
   ]
  },
  {
   "@id": "lab:term/backward-bending",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "후방굴절",
     "@language": "ko"
    },
    {
     "@value": "backward-bending",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "고임금 구간에서 임금이 오를수록 근로시간이 줄어 곡선이 뒤로 굽는 모양.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/labor-supply-curve"
    }
   ]
  },
  {
   "@id": "lab:term/labor-supply-elasticity",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "노동공급 탄력성",
     "@language": "ko"
    },
    {
     "@value": "labor supply elasticity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "임금 1% 변화에 대한 근로시간의 % 변화.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/labor-supply-curve"
    }
   ]
  },
  {
   "@id": "lab:term/life-cycle",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "생애주기 모형",
     "@language": "ko"
    },
    {
     "@value": "life-cycle model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "임금이 높은 시기에 더 일하고 낮은 시기에 여가를 쓰는 시점 간 대체 모형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/03_labor_supply_policy.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/eitc"
    }
   ]
  },
  {
   "@id": "lab:concept/short-run-labor-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "단기 노동수요",
     "@language": "ko"
    },
    {
     "@value": "short-run labor demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자본이 고정된 단기에 VMP = w 규칙으로 정하는 고용. VMP 곡선이 수요곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/long-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:concept/long-run-labor-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "장기 노동수요",
     "@language": "ko"
    },
    {
     "@value": "long-run labor demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "노동과 자본을 모두 바꿀 수 있는 장기의 비용 최소화로 정하는 고용. 대체효과와 규모효과.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/production-functions-ai"
    }
   ]
  },
  {
   "@id": "lab:term/marginal-product",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "한계생산",
     "@language": "ko"
    },
    {
     "@value": "marginal product of labor",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "노동자 한 명을 더 쓸 때 늘어나는 생산량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/short-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/vmp",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "VMP",
     "@language": "ko"
    },
    {
     "@value": "value of marginal product",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한계생산의 가치 = 제품 가격 × 한계생산. 단기 노동수요곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/short-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/diminishing-returns",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "한계생산 체감",
     "@language": "ko"
    },
    {
     "@value": "diminishing returns",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "고정된 설비에 노동을 늘릴수록 한계생산이 줄어드는 현상.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/short-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/isoquant",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "등량곡선",
     "@language": "ko"
    },
    {
     "@value": "isoquant",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 산출을 만드는 노동·자본 조합.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/isocost",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "등비용선",
     "@language": "ko"
    },
    {
     "@value": "isocost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 비용이 드는 노동·자본 조합. 기울기 −w ÷ r.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/scale-effect",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "규모효과",
     "@language": "ko"
    },
    {
     "@value": "scale effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "임금 상승으로 비용이 올라 산출이 줄며 노동·자본이 함께 주는 효과.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/hicks-marshall",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "힉스-마셜 법칙",
     "@language": "ko"
    },
    {
     "@value": "Hicks-Marshall laws of derived demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "노동수요 탄력성을 정하는 네 가지 조건(파생수요 법칙).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-labor-demand"
    }
   ]
  },
  {
   "@id": "lab:term/elasticity-of-substitution",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "대체탄력성",
     "@language": "ko"
    },
    {
     "@value": "elasticity of substitution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "요소가격 비율 변화에 요소 투입 비율이 얼마나 반응하는지. 레온티에프 0, 콥-더글러스 1, 선형 ∞.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/production-functions-ai"
    }
   ]
  },
  {
   "@id": "lab:term/threshold-wage",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "임계임금",
     "@language": "ko"
    },
    {
     "@value": "threshold wage",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "완전대체 기술에서 노동을 쓰는 최고 임금 w* = (a ÷ b)r.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/04_labor_demand.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/production-functions-ai"
    },
    {
     "@id": "lab:concept/threshold-wage"
    }
   ]
  },

    }
   ]
  },
  {
   "@id": "lab:concept/stone-geary",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "스톤-기어리 수요",
     "@language": "ko"
    },
    {
     "@value": "Stone-Geary demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생계 소비를 먼저 사고 여유소득을 일정 비율로 나누는 수요.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv1"
   },

   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "상태가격",
     "@language": "ko"
    },
    {
     "@value": "state prices",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "특정 상태에서만 1을 지급하는 증서의 오늘 가격.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

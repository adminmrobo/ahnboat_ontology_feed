   ]
  },
  {
   "@id": "lab:method/counterfactual-analysis",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "반사실 분석",
     "@language": "ko"
    },
    {
     "@value": "Counterfactual Analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "충격 이전의 안정적 법칙이 확산 이후에도 유지되었을 경우 나타났을 가상의 고용 경로.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

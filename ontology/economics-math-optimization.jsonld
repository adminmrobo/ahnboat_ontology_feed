     "@value": "1차 동차",
     "@language": "ko"
    },
    {
     "@value": "homogeneous of degree one",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 변수를 t배 하면 값도 t배.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/05_cost_function.html#lv1"
   },

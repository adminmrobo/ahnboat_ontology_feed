   ],
   "skos:prefLabel": [
    {
     "@value": "장기비용",
     "@language": "ko"
    },
    {
     "@value": "long-run cost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 투입을 조정할 수 있을 때의 최소비용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

   ],
   "skos:prefLabel": [
    {
     "@value": "분할 가능성",
     "@language": "ko"
    },
    {
     "@value": "divisibility",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공정을 원하는 비율로 줄여 일부만 가동하거나 여러 공정을 시간 비율로 섞어 가동할 수 있는 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

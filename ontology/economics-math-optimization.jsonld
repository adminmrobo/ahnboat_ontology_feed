    }
   ]
  },
  {
   "@id": "lab:concept/hicks-decomposition",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "힉스 분해",
     "@language": "ko"
    },
    {
     "@value": "Hicksian decomposition",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격 변화의 효과를 같은 효용을 유지하는 대체효과와 나머지 소득효과로 나누는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/10_consumer_surplus.html#lv3"
   }
  },
  {
   "@id": "lab:term/quasilinear",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "준선형 선호",
     "@language": "ko"
    },
    {
     "@value": "quasilinear preferences",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "u = v(x) + y 꼴. 소득효과가 없음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/10_consumer_surplus.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/consumer-surplus"
    }
   ]
  },
  {
   "@id": "lab:term/compensated-bundle",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "보상선택",
     "@language": "ko"
    },
    {
     "@value": "compensated bundle",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "처음 효용을 유지하며 변경 가격에서 지출을 최소로 하는 묶음 h¹.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/10_consumer_surplus.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/hicks-decomposition"
    }
   ]
  },
  {
   "@id": "lab:concept/certainty-equivalent",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "확실성등가",
     "@language": "ko"
    },
    {
     "@value": "certainty equivalent",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "위험한 결과와 같은 기대효용을 주는 확실한 금액.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/risk-aversion"
    }
   ]
  },
  {
   "@id": "lab:concept/risk-aversion",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "위험회피",
     "@language": "ko"
    },
    {
     "@value": "risk aversion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 평균이면 확실한 쪽을 선호하는 성질. 효용의 오목성.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/insurance-demand"
    }
   ]
  },
  {
   "@id": "lab:concept/insurance-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "보험 수요",
     "@language": "ko"
    },
    {
     "@value": "insurance demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "보험료와 위험회피에 따라 정하는 최적 보장 수준.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv3"
   }
  },
  {
   "@id": "lab:term/jensen",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "젠센 부등식",
     "@language": "ko"
    },
    {
     "@value": "Jensen's inequality",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "오목 함수 u에 대해 u(E[X]) ≥ E[u(X)].",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/certainty-equivalent"
    }
   ]
  },
  {
   "@id": "lab:term/fair-premium",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "공정 보험료",
     "@language": "ko"
    },
    {
     "@value": "actuarially fair premium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기대 보상액과 같은 보험료 pL.",

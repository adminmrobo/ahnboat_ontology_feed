     "@id": "lab:concept/intra-financial-circulation"
    }
   ]
  },
  {
   "@id": "lab:concept/capital-buffer",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "완충(자본)",
     "@language": "ko"
    },
    {
     "@value": "capital buffer",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "손실을 스스로 흡수할 수 있는 몫.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

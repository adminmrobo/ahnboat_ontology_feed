    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/capital-buffer"
    }
   ]
  },
  {
   "@id": "lab:theory/network-phase-transition",
   "@type": [
    "skos:Concept",
    "lab:Theory"
   ],
   "skos:prefLabel": [
    {
     "@value": "금융망 상전이",
     "@language": "ko"
    },
    {
     "@value": "phase transition in financial networks",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "충격이 작으면 촘촘한 연결이 안정을 높이고, 어느 지점을 넘으면 같은 연결이 전파 경로가 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/03_fof_between_stations.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/network-economics"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:indicator/interconnectedness"
    }
   ]

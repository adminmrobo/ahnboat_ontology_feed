   ],
   "skos:prefLabel": [
    {
     "@value": "거리 척도",
     "@language": "ko"
    },
    {
     "@value": "Distance metric",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 점(사람·글·도시)이 얼마나 먼지 재는 자. 자를 바꾸면 같은 두 사람의 거리가 달라진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

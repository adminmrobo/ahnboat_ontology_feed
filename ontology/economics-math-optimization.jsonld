  },
  {
   "@id": "lab:concept/discrete-processes",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이산 공정 기술",
     "@language": "ko"
    },
    {
     "@value": "activity analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "몇 개의 생산 공정(활동)으로 이루어진 기술.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/gdp"
    }
   ]
  },
  {
   "@id": "lab:term/labor-force",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "경제활동인구",
     "@language": "ko"
    },
    {
     "@value": "labor force",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "취업자 + 실업자.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/unemployment-rate"
    }
   ]
  },
  {
   "@id": "lab:term/discouraged-worker",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "실망실업자",
     "@language": "ko"
    },
    {
     "@value": "discouraged worker",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일자리가 없을 것 같아 구직을 포기한 사람. 비경제활동인구로 분류.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/unemployment-rate"
    }
   ]
  },
  {
   "@id": "lab:concept/inflation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "인플레이션",
     "@language": "ko"
    },
    {
     "@value": "inflation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "전반적 물가가 지속적으로 오르는 현상.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/inflation"
    }
   ],
   "lab:partOf": [

  {
   "@id": "lab:concept/technology-absorption",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기술 흡수 속도(사회 속도)",
     "@language": "ko"
    },
    {
     "@value": "technology absorption speed",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최첨단 기술과 사회가 실제로 쓰는 기술의 격차를 해마다 메우는 몫. 오래 지나면 격차는 g ÷ λ에 머문다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/pacing_problem_lab/index.html#lv2"
   },

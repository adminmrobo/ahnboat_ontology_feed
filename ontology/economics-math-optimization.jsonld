   ],
   "skos:prefLabel": [
    {
     "@value": "간접효용함수",
     "@language": "ko"
    },
    {
     "@value": "indirect utility function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 소득의 함수로 본 최대 효용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/expenditure-function"
    }
   ]
  },
  {
   "@id": "lab:concept/expenditure-matrix",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지출행렬",
     "@language": "ko"
    },
    {
     "@value": "expenditure matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관측 가격별로 모든 묶음의 값을 매긴 표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/garp"
    }
   ]
  },
  {
   "@id": "lab:concept/garp",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "GARP",
     "@language": "ko"
    },
    {
     "@value": "generalized axiom of revealed preference",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "현시선호 연쇄 뒤에 엄격한 반대 관계가 없어야 한다는 조건.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/revealed-preference-limits"
    }
   ]
  },
  {
   "@id": "lab:concept/revealed-preference-limits",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "현시선호의 식별 한계",
     "@language": "ko"
    },
    {
     "@value": "limits of revealed preference",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "유한한 선택 자료로는 선호의 일부 제한만 얻는다는 점.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv3"
   }
  },
  {
   "@id": "lab:term/transitivity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이행성",
     "@language": "ko"
    },
    {
     "@value": "transitivity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "x ≽ y이고 y ≽ z이면 x ≽ z.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/expenditure-matrix"
    }
   ]
  },
  {
   "@id": "lab:term/direct-revealed-preference",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "직접 현시선호",
     "@language": "ko"
    },
    {
     "@value": "directly revealed preferred",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "살 수 있었는데 고르지 않은 묶음보다 고른 묶음이 선호된다는 관계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/garp"
    }
   ]
  },
  {
   "@id": "lab:term/local-nonsatiation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "국소 비포화",
     "@language": "ko"
    },
    {
     "@value": "local nonsatiation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "어떤 묶음 근처에도 더 좋은 묶음이 있다는 가정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/garp"
    }
   ]
  },
  {
   "@id": "lab:concept/afriat",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "아프리아트 정리",
     "@language": "ko"
    },
    {
     "@value": "Afriat's theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "GARP 만족 ⇔ 연속·단조·오목 효용으로 합리화 가능.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/revealed-preference-limits"
    }
   ]
  },
  {
   "@id": "lab:term/identification",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "식별",
     "@language": "ko"
    },
    {
     "@value": "identification",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자료로 모형의 미지수를 하나로 정할 수 있는지의 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/revealed-preference-limits"
    }
   ]
  },
  {
   "@id": "lab:concept/stone-geary",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "스톤-기어리 수요",
     "@language": "ko"
    },
    {
     "@value": "Stone-Geary demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생계 소비를 먼저 사고 여유소득을 일정 비율로 나누는 수요.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:concept/slutsky-matrix",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "슬러츠키 행렬",
     "@language": "ko"
    },
    {
     "@value": "Slutsky matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "소득효과를 보정한 가격반응 행렬. 대칭·음의 준정부호.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv3"
   }
  },
  {
   "@id": "lab:term/subsistence",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "생계 소비",
     "@language": "ko"
    },
    {
     "@value": "subsistence quantity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "효용이 정의되기 위해 꼭 필요한 최소 소비량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/stone-geary"
    }
   ]
  },
  {
   "@id": "lab:term/supernumerary-income",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "여유소득",
     "@language": "ko"
    },
    {
     "@value": "supernumerary income",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생계 묶음 비용을 뺀 소득 R.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/stone-geary"
    }
   ]
  },
  {
   "@id": "lab:concept/engel-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "엥겔 곡선",
     "@language": "ko"
    },
    {
     "@value": "Engel curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격을 고정하고 소득에 따른 수요를 그린 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:term/non-homothetic",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "비동조성",
     "@language": "ko"
    },
    {
     "@value": "non-homotheticity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "소득에 따라 지출 비중이 변하는 선호 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:concept/roy-identity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "로이 항등식",
     "@language": "ko"
    },
    {
     "@value": "Roy's identity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "x = −V_p/V_m.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:term/nsd",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "음의 준정부호",
     "@language": "ko"
    },
    {
     "@value": "negative semidefinite",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 방향 z에 대해 zᵀSz ≤ 0인 행렬 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/slutsky-matrix"
    }
   ]
  },
  {
   "@id": "lab:concept/hicks-decomposition",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "힉스 분해",
     "@language": "ko"
    },
    {
     "@value": "Hicksian decomposition",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격 변화의 효과를 같은 효용을 유지하는 대체효과와 나머지 소득효과로 나누는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/10_consumer_surplus.html#lv3"
   }
  },
  {
   "@id": "lab:term/quasilinear",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "준선형 선호",
     "@language": "ko"
    },
    {
     "@value": "quasilinear preferences",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "u = v(x) + y 꼴. 소득효과가 없음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/10_consumer_surplus.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/consumer-surplus"
    }
   ]
  },
  {
   "@id": "lab:term/compensated-bundle",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "보상선택",
     "@language": "ko"
    },
    {
     "@value": "compensated bundle",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "처음 효용을 유지하며 변경 가격에서 지출을 최소로 하는 묶음 h¹.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/10_consumer_surplus.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/hicks-decomposition"
    }
   ]
  },
  {
   "@id": "lab:concept/certainty-equivalent",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "확실성등가",
     "@language": "ko"
    },
    {
     "@value": "certainty equivalent",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "위험한 결과와 같은 기대효용을 주는 확실한 금액.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/risk-aversion"
    }
   ]
  },
  {
   "@id": "lab:concept/risk-aversion",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "위험회피",
     "@language": "ko"
    },
    {
     "@value": "risk aversion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 평균이면 확실한 쪽을 선호하는 성질. 효용의 오목성.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/insurance-demand"
    }
   ]
  },
  {
   "@id": "lab:concept/insurance-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "보험 수요",
     "@language": "ko"
    },
    {
     "@value": "insurance demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "보험료와 위험회피에 따라 정하는 최적 보장 수준.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv3"
   }
  },
  {
   "@id": "lab:term/jensen",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "젠센 부등식",
     "@language": "ko"
    },
    {
     "@value": "Jensen's inequality",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "오목 함수 u에 대해 u(E[X]) ≥ E[u(X)].",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/certainty-equivalent"
    }
   ]
  },
  {
   "@id": "lab:term/fair-premium",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "공정 보험료",
     "@language": "ko"
    },
    {
     "@value": "actuarially fair premium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기대 보상액과 같은 보험료 pL.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/risk-aversion"
    }
   ]
  },
  {
   "@id": "lab:term/loading",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "부하율",
     "@language": "ko"
    },
    {
     "@value": "loading factor",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공정 보험료에 붙는 할증 비율 ℓ.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/11_uncertainty.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/insurance-demand"
    }
   ]
  },
  {
   "@id": "lab:concept/simultaneity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "동시성",
     "@language": "ko"
    },
    {
     "@value": "simultaneity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 수량이 수요와 공급에 의해 함께 정해지는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/simultaneity-bias"
    }
   ]
  },
  {
   "@id": "lab:concept/simultaneity-bias",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "동시성 편의",
     "@language": "ko"
    },
    {
     "@value": "simultaneity bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "설명변수가 오차와 상관되어 OLS가 참값과 다른 값으로 수렴하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/instrumental-variables"
    }
   ]
  },
  {
   "@id": "lab:concept/instrumental-variables",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "도구변수",
     "@language": "ko"
    },
    {
     "@value": "instrumental variable",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "설명변수를 움직이지만 오차와는 무관한 변수. 관련성과 배제조건이 필요.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv3"
   }
  },
  {
   "@id": "lab:term/endogenous",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "내생변수",
     "@language": "ko"
    },
    {
     "@value": "endogenous variable",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모형 안에서 정해지는 변수(여기서는 P, Q).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/simultaneity"
    }
   ]
  },
  {
   "@id": "lab:term/ols",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "최소제곱",
     "@language": "ko"
    },
    {
     "@value": "ordinary least squares",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잔차 제곱합이 가장 작은 직선을 고르는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/simultaneity-bias"
    }
   ]
  },
  {
   "@id": "lab:term/plim",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "확률극한",
     "@language": "ko"
    },
    {
     "@value": "probability limit",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "표본이 무한히 커질 때 추정량이 가까워지는 값.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/simultaneity-bias"
    }
   ]
  },
  {
   "@id": "lab:term/exclusion-restriction",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "배제조건",
     "@language": "ko"
    },
    {
     "@value": "exclusion restriction",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "도구가 결과에 설명변수를 통해서만 영향을 준다는 조건.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/instrumental-variables"
    }
   ]
  },
  {
   "@id": "lab:term/weak-instrument",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "약한 도구",
     "@language": "ko"
    },
    {
     "@value": "weak instrument",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "설명변수와의 관련성이 약한 도구. 1단계 F가 작음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/instrumental-variables"
    }
   ]
  },
  {
   "@id": "lab:concept/firm-supply",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기업 공급곡선",
     "@language": "ko"
    },
    {
     "@value": "firm supply curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격별 이윤극대화 산출. P ≥ min AVC 구간의 MC 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/market-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:concept/long-run-equilibrium",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "장기 경쟁균형",
     "@language": "ko"
    },
    {
     "@value": "long-run competitive equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "진입·퇴출로 이윤이 0이 되어 P = min AC인 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   }
  },
  {
   "@id": "lab:term/avc",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균가변비용",
     "@language": "ko"
    },
    {
     "@value": "average variable cost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가변비용 ÷ 산출.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/firm-supply"
    }
   ]
  },
  {
   "@id": "lab:concept/market-supply",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시장 공급",
     "@language": "ko"
    },
    {
     "@value": "market supply",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 가격에서 모든 기업의 공급량을 더한 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/market-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/free-entry",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "자유진입",
     "@language": "ko"
    },
    {
     "@value": "free entry",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기업이 비용 없이(또는 비용을 반영해) 들어오고 나갈 수 있는 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/efficient-scale",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "효율적 규모",
     "@language": "ko"
    },
    {
     "@value": "efficient scale",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "평균비용이 가장 낮은 산출량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/constant-cost",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "일정비용 산업",
     "@language": "ko"
    },
    {
     "@value": "constant-cost industry",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "산업 규모가 변해도 요소가격이 변하지 않는 산업. 장기 공급이 수평.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-run-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:concept/monopoly-pricing",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "독점 가격 결정",
     "@language": "ko"
    },
    {
     "@value": "monopoly pricing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한계수입 = 한계비용에서 수량을 정하고 수요곡선에서 가격을 정하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/price-ceiling-monopoly"
    }
   ]
  },
  {
   "@id": "lab:concept/price-ceiling-monopoly",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "독점과 가격상한",
     "@language": "ko"
    },
    {
     "@value": "price ceiling under monopoly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격상한이 독점의 한계수입을 바꿔 공급을 늘리거나 줄이는 효과.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/price-discrimination"
    }
   ]
  },
  {
   "@id": "lab:term/lerner-index",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "러너 지수",
     "@language": "ko"
    },
    {
     "@value": "Lerner index",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(P − MC)/P. 최적에서 1/|ε|.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/monopoly-pricing"
    }
   ]
  },
  {
   "@id": "lab:term/arbitrage",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "재판매",
     "@language": "ko"
    },
    {
     "@value": "resale (arbitrage)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "싸게 산 손님이 비싸게 사는 손님에게 되파는 것. 차별을 무너뜨림.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/price-discrimination"
    }
   ]
  },
  {
   "@id": "lab:concept/subgame-perfection",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "부분게임완전성",
     "@language": "ko"
    },
    {
     "@value": "subgame perfection",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 부분게임에서 내시균형인 전략 조합. 신뢰할 수 없는 위협을 배제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/15_game_theory.html#lv3"
   }
  },
  {

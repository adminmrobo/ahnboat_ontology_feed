   ],
   "skos:prefLabel": [
    {
     "@value": "간접효용함수",
     "@language": "ko"
    },
    {
     "@value": "indirect utility function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 소득의 함수로 본 최대 효용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv3"

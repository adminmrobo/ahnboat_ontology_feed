    }
   ]
  },
  {
   "@id": "lab:concept/prob-stats",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "확률·통계",
     "@language": "ko"
    },
    {
     "@value": "Probability & statistics",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "6~10장: 확률, 베이즈, 기술통계, 확률분포, 상관.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

  {
   "@id": "lab:term/endogenous-variable",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "내생변수",
     "@language": "ko"
    },
    {
     "@value": "endogenous variable",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모형 안에서 풀어서 정해지는 변수(예: 균형가격).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

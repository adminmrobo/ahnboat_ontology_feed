   ],
   "skos:prefLabel": [
    {
     "@value": "오경보",
     "@language": "ko"
    },
    {
     "@value": "False positive",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "양품을 불량으로 잘못 판정한 경우. 재현율과 맞바꾸는 비용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

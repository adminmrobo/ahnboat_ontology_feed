   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:concept/utility-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "효용함수",
     "@language": "ko"
    },
    {
     "@value": "utility function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선호 순서를 숫자로 나타낸 것. 증가변환해도 같은 선호.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:term/ordinal-utility",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "서수적 효용",
     "@language": "ko"
    },
    {
     "@value": "ordinal utility",
     "@language": "en"
    }
   ],
   "skos:definition": {

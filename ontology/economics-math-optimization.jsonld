     "@value": "분산투자",
     "@language": "ko"
    },
    {
     "@value": "diversification",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "상관이 낮은 자산을 섞어 위험을 줄이는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

  {
   "@id": "lab:method/look-through",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "투시(look-through) 계산",
     "@language": "ko"
    },
    {
     "@value": "look-through allocation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "금융기관 자산 구성 비율로 나눠 붙여 최종 사용 부문 몫을 추정. 행렬 곱 h·M, 금융기관 간 거래가 있으면 (I − F)⁻¹을 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/02_fof_who_to_whom.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:indicator/interconnectedness"
    }
   ]
  },
  {
   "@id": "lab:indicator/interconnectedness",
   "@type": [
    "skos:Concept",
    "lab:Indicator"
   ],
   "skos:prefLabel": [
    {
     "@value": "상호연계비율",
     "@language": "ko"
    },
    {
     "@value": "interconnectedness ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 주체가 서로에게 보유한 채권액의 합을 금융자산 총액으로 나눈 비율. 한국은행 상세자금순환표 보도 지표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/02_fof_who_to_whom.html#lv4"
   },

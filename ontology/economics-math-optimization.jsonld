    }
   ]
  },
  {
   "@id": "lab:concept/causality",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "원인과 결과 판정",
     "@language": "ko"
    },
    {
     "@value": "Causal order",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "① 거리² ≤ 0 ② Δt > 0이면 원인이 될 수 있다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/minkowski_space_lab/m1_clock_corridor.html#r5"

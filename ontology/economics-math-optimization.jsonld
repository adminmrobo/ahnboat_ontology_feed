   "@id": "lab:term/nominal-gdp",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "명목 GDP",
     "@language": "ko"
    },
    {
     "@value": "nominal GDP",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "올해 가격으로 잰 GDP.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/gdp"
    }
   ]
  },

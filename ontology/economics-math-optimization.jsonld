   "@id": "lab:term/fixed-point",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "고정점 정리",
     "@language": "ko"
    },
    {
     "@value": "fixed point theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "연속 함수가 자기 자신으로 보내는 점이 있음을 보이는 정리(브라우어 등).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/existence-uniqueness"
    }
   ]
  },
  {
   "@id": "lab:term/implicit-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "암묵함수정리",
     "@language": "ko"
    },
    {
     "@value": "implicit function theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "F(x, θ) = 0에서 ∂F/∂x ≠ 0이면 x를 θ의 함수로 보고 dx/dθ = −F_θ/F_x.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/comparative-statics"
    }
   ]
  },
  {
   "@id": "lab:term/local-stability",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "국소 안정성",
     "@language": "ko"
    },
    {
     "@value": "local stability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "균형 근처에서 출발하면 균형으로 돌아오는 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/tatonnement-stability"
    }
   ]
  },
  {
   "@id": "lab:term/linearization",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "선형화",
     "@language": "ko"
    },
    {
     "@value": "linearization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "균형 근처에서 비선형 규칙을 1차식으로 근사하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/tatonnement-stability"
    }
   ]
  },
  {
   "@id": "lab:concept/maximin",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "최소극대 기준",
     "@language": "ko"
    },
    {
     "@value": "maximin (Rawlsian) criterion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가장 낮은 효용을 최대로 하는 사회적 선택 기준.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/22_welfare.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/welfare-theorems"
    }
   ]
  },
  {
   "@id": "lab:concept/welfare-theorems",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "후생정리",
     "@language": "ko"
    },
    {
     "@value": "fundamental welfare theorems",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "경쟁균형과 파레토 효율의 관계를 말하는 두 정리.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/22_welfare.html#lv3"
   }
  },
  {
   "@id": "lab:method/22-duel-fly",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [

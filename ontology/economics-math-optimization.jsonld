   },
   "lab:topic": [
    {
     "@id": "lab:topic/probability-statistics"
    }
   ]
  },
  {
   "@id": "lab:concept/calc-opt",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "미적분·최적화",
     "@language": "ko"
    },
    {
     "@value": "Calculus & optimization",
     "@language": "en"
    }
   ],
   "skos:definition": {

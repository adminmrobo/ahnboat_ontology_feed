   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "생산함수와 AI 대체",
     "@language": "ko"
    },
    {
     "@value": "production functions and AI substitution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "보완(레온티에프)부터 완전대체(선형)까지 생산함수 형태에 따라 AI 가격 변화가 노동수요에 주는 영향이 달라진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

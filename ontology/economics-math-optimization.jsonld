   ],
   "skos:prefLabel": [
    {
     "@value": "볼록포",
     "@language": "ko"
    },
    {
     "@value": "convex hull",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "점들을 모두 포함하는 가장 작은 볼록 집합.",

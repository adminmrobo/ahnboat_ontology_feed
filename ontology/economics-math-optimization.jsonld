   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "생산의 쌍대성",
     "@language": "ko"
    },
    {
     "@value": "duality in production",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이윤함수(또는 비용함수)로부터 생산기술을 복원할 수 있다는 관계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

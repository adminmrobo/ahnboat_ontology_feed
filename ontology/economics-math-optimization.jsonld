    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "④ 헤시안 부호로 임계점 판별",
     "@language": "ko"
    },
    {
     "@value": "Second-order critical-point test",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기울기 0인 곳에서 고유값 부호로 바닥·봉우리·안장을 가린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

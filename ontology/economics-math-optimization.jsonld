   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "발산",
     "@language": "ko"
    },
    {
     "@value": "Training divergence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "걸음마다 오차가 커져 숫자가 끝없이 불어나는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/2_experiment_lab.html#s2"
   },
   "lab:relatedTo": [
    {
     "@id": "lab:concept/step-size-limit"
    }
   ]
  },
  {
   "@id": "lab:method/random-direction-slice",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "무작위 방향 2차원 단면",
     "@language": "ko"
    },
    {
     "@value": "Random-direction 2D slice",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습이 끝난 점을 가운데 두고 무작위 방향 두 개로 평면을 잘라 오차를 그린다. 방향 길이는 층별 가중치 크기에 맞춘다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/2_experiment_lab.html#s3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/early-stopping"
    }
   ],

   ]
  },
  {
   "@id": "lab:concept/shephard-lemma",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "셰퍼드 보조정리",
     "@language": "ko"
    },
    {
     "@value": "Shephard's lemma",
     "@language": "en"
    }
   ],
   "skos:definition": {

   ],
   "skos:prefLabel": [
    {
     "@value": "직접 현시선호",
     "@language": "ko"
    },
    {
     "@value": "directly revealed preferred",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "살 수 있었는데 고르지 않은 묶음보다 고른 묶음이 선호된다는 관계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv2"
   },
   "lab:partOf": [

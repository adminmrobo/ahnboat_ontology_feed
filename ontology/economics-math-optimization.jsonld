  {
   "@id": "lab:concept/lorentz-boost",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "관찰자 바꾸기(로렌츠 변환)",
     "@language": "ko"
    },
    {
     "@value": "Lorentz boost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "t′ = γ(t − vx), x′ = γ(x − vt). 사건은 거리²가 같은 쌍곡선 위를 미끄러진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

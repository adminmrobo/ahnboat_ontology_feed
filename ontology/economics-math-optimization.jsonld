     "@id": "lab:concept/short-run-cost"
    }
   ]
  },
  {
   "@id": "lab:concept/short-run-cost",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "단기비용",
     "@language": "ko"
    },
    {
     "@value": "short-run cost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일부 투입(보통 자본)을 고정한 채 나머지만 조정할 때의 최소비용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/05_cost_function.html#lv3"
   }
  },

   "@id": "lab:concept/euclidean-distance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "유클리드 거리",
     "@language": "ko"
    },
    {
     "@value": "Euclidean distance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "곧게 잰 거리. 시아 (4, 0, 10)와 모아 (12, 5, 7)는 √98 = 9.899.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

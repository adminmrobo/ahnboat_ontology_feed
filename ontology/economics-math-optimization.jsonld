    },
    {
     "@value": "3D Cartesian space",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞뒤·좌우·위아래 세 방향이 모두 공간 축인 좌표계. 점의 주소는 (x, y, z).",
    "@language": "ko"
   },

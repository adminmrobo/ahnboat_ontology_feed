   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "비탄력적",
     "@language": "ko"
    },
    {
     "@value": "inelastic",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "탄력성이 1보다 작음. 가격에 조금 반응.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

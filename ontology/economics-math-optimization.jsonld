     "@language": "ko"
    },
    {
     "@value": "identification",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자료로 모형의 미지수를 하나로 정할 수 있는지의 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

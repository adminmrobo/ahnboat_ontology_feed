     "@id": "lab:concept/long-run-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:concept/monopoly-pricing",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "독점 가격 결정",
     "@language": "ko"
    },
    {
     "@value": "monopoly pricing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한계수입 = 한계비용에서 수량을 정하고 수요곡선에서 가격을 정하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv1"

   ]
  },
  {
   "@id": "lab:term/contribution-margin",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "공헌이익",
     "@language": "ko"
    },
    {
     "@value": "contribution margin",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출 − 변동비. 고정비를 메우는 데 쓰이는 몫.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/shutdown-condition"
    },
    {
     "@id": "lab:concept/marginal-revenue"
    },
    {
     "@id": "lab:concept/profit-maximization"
    }
   ]
  },
  {
   "@id": "lab:concept/economic-rent",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "경제적 지대",
     "@language": "ko"
    },
    {
     "@value": "economic rent",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공급에 필요한 최소 금액(전용수입)을 넘어 받는 몫.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/shutdown-condition"
    }
   ]
  },
  {
   "@id": "lab:concept/price-discrimination",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가격차별",
     "@language": "ko"
    },
    {
     "@value": "price discrimination",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 상품을 손님이나 집단에 따라 다른 가격에 파는 것. 3급은 집단별, 1급은 사람마다 지불의사만큼, 2급은 수량·메뉴로 스스로 고르게 함.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/03_market_power.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/price-discrimination"
    }
   ]
  },
  {
   "@id": "lab:policy/price-ceiling",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가격상한",
     "@language": "ko"
    },
    {
     "@value": "price ceiling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정부가 정한 최고 가격. 독점에서는 거래량을 늘릴 수 있음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/03_market_power.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/deadweight-loss"
    }
   ]
  },
  {
   "@id": "lab:concept/natural-monopoly",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자연독점",
     "@language": "ko"
    },
    {
     "@value": "natural monopoly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 기업이 공급하는 것이 가장 싼 시장(평균비용이 계속 내려감).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/03_market_power.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/deadweight-loss"
    }
   ]
  },
  {
   "@id": "lab:concept/inverse-elasticity-rule",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "역탄력성 규칙",
     "@language": "ko"
    },
    {
     "@value": "inverse elasticity rule",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(P − MC)/P = 1/|ε|. 탄력적일수록 마크업이 작음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/03_market_power.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/elasticity"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/price-discrimination"
    }
   ]
  },
  {
   "@id": "lab:concept/screening",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "선별",
     "@language": "ko"
    },
    {
     "@value": "screening",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메뉴를 내밀어 손님이 스스로 유형을 드러내게 하는 것(2급 가격차별).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/03_market_power.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/price-discrimination"
    },
    {
     "@id": "lab:concept/adverse-selection"
    }
   ]
  },
  {
   "@id": "lab:model/cournot",
   "@type": [
    "skos:Concept",
    "lab:Theory"
   ],
   "skos:prefLabel": [
    {
     "@value": "쿠르노 과점",
     "@language": "ko"
    },
    {
     "@value": "Cournot oligopoly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기업들이 동시에 생산량을 고르는 과점 모형. 균형에서 각 기업의 양은 다른 기업 양에 대한 최선의 대응이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/repeated-game-cooperation"
    }
   ]
  },
  {
   "@id": "lab:concept/repeated-game-cooperation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "반복게임의 협조 조건",
     "@language": "ko"
    },
    {
     "@value": "cooperation in repeated games",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무한 반복에서 미래 협조의 현재가치가 한 번 일탈의 이득보다 클 때 협조가 유지된다는 조건.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/repeated-games"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:term/payoff-matrix",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "보수표",
     "@language": "ko"
    },
    {
     "@value": "payoff matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "행동 조합별로 각 참가자가 받는 결과를 정리한 표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/payoff-matrix"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/nash-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:concept/best-response",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "최선의 대응",
     "@language": "ko"
    },
    {
     "@value": "best response",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "상대의 전략이 주어졌을 때 나에게 가장 좋은 전략.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/nash-equilibrium"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/mixed-strategy"
    }
   ]
  },
  {
   "@id": "lab:concept/dominant-strategy",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "우월전략",
     "@language": "ko"
    },
    {
     "@value": "dominant strategy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "상대가 무엇을 하든 다른 전략보다 좋은 전략.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/nash-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:model/prisoners-dilemma",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "죄수의 딜레마",
     "@language": "ko"
    },
    {
     "@value": "prisoner's dilemma",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "각자 최선을 택하면 모두가 더 나쁜 결과에 이르는 게임.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/nash-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:concept/reaction-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "반응함수",
     "@language": "ko"
    },
    {
     "@value": "reaction function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다른 기업의 생산량에 대한 나의 최선의 생산량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:model/cournot"
    }
   ]
  },
  {
   "@id": "lab:concept/collusion",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "담합",
     "@language": "ko"
    },
    {
     "@value": "collusion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기업들이 생산량·가격을 짜고 정하는 것. 각자 깨고 싶은 유인이 있음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:model/cournot"
    }
   ]
  },
  {
   "@id": "lab:term/stage-game",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "단계게임",
     "@language": "ko"
    },
    {
     "@value": "stage game",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "반복게임에서 매 기간 되풀이되는 한 번의 게임.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/repeated-game-cooperation"
    }
   ]
  },
  {
   "@id": "lab:concept/credible-threat",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "신뢰 가능한 위협",
     "@language": "ko"
    },
    {
     "@value": "credible threat",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "그 상황이 오면 실제로 실행하는 것이 최선이라 믿을 만한 위협.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/04_game_theory.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/repeated-game-cooperation"
    }
   ]
  },
  {
   "@id": "lab:concept/walrasian-equilibrium",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "왈라스 균형(경쟁균형)",
     "@language": "ko"
    },
    {
     "@value": "Walrasian equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 사람이 가격을 주어진 것으로 보고 최선을 고를 때 모든 시장의 초과수요가 0이 되는 가격과 배분.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/present-value"
    }
   ]
  },
  {
   "@id": "lab:concept/present-value",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "현재가치",
     "@language": "ko"
    },
    {
     "@value": "present value",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "미래의 금액을 이자율로 할인해 오늘의 금액으로 바꾼 값.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/portfolio-variance"
    }
   ]
  },
  {
   "@id": "lab:concept/portfolio-variance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "포트폴리오 분산",
     "@language": "ko"
    },
    {
     "@value": "portfolio variance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자산을 섞었을 때 수익률의 흔들림. 각 분산과 공분산으로 정해진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:theory/first-welfare-theorem"
    }
   ]
  },
  {
   "@id": "lab:term/endowment",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "부존",
     "@language": "ko"
    },
    {
     "@value": "endowment",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "처음 가진 상품 묶음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    },
    {
     "@id": "lab:concept/endowment-demand"
    }
   ]
  },
  {
   "@id": "lab:concept/relative-price",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "상대가격",
     "@language": "ko"
    },
    {
     "@value": "relative price",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 상품 가격을 다른 상품 가격으로 나눈 비율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    },
    {
     "@id": "lab:concept/homogeneity-of-profit"
    }
   ]
  },
  {
   "@id": "lab:concept/excess-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "초과수요",
     "@language": "ko"
    },
    {
     "@value": "excess demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "원하는 양의 합 − 있는 양의 합.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    },
    {
     "@id": "lab:concept/walras-law"
    },
    {
     "@id": "lab:concept/existence-uniqueness"
    }
   ]
  },
  {
   "@id": "lab:concept/walras-law",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "왈라스 법칙",
     "@language": "ko"
    },
    {
     "@value": "Walras' law",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모두가 예산을 다 쓰면 시장 가치로 본 초과수요의 합이 0. 시장 n개 중 n − 1개가 맞으면 나머지도 맞음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/contract-curve"
    }
   ]
  },
  {
   "@id": "lab:term/edgeworth-box",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "에지워스 상자",
     "@language": "ko"
    },
    {
     "@value": "Edgeworth box",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 사람·두 상품의 배분을 한 상자 그림으로 나타낸 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    },
    {
     "@id": "lab:concept/endowment-demand"
    }
   ]
  },
  {
   "@id": "lab:concept/general-equilibrium",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "일반균형",
     "@language": "ko"
    },
    {
     "@value": "general equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 시장을 함께 풀어 정한 균형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/walrasian-equilibrium"
    },
    {
     "@id": "lab:concept/walras-law"
    }
   ]
  },
  {
   "@id": "lab:concept/interest-rate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이자율",
     "@language": "ko"
    },
    {
     "@value": "interest rate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "오늘 돈과 내일 돈을 바꾸는 비율. 내일 1원의 오늘 가격 = 1/(1 + r).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/present-value"
    }
   ]
  },
  {
   "@id": "lab:concept/state-price",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "상태가격",
     "@language": "ko"
    },
    {
     "@value": "state price",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "특정 상태(좋은 날·나쁜 날)에만 1원을 주는 증권의 가격.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/present-value"
    }
   ]
  },
  {
   "@id": "lab:term/short-selling",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "공매도",
     "@language": "ko"
    },
    {
     "@value": "short selling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가지지 않은 자산을 빌려 파는 것. 여기서는 금지(비중 0~1).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/05_general_equilibrium.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/portfolio-variance"
    }
   ]
  },
  {
   "@id": "lab:theory/first-welfare-theorem",
   "@type": [
    "skos:Concept",
    "lab:Theory"
   ],
   "skos:prefLabel": [
    {
     "@value": "후생경제학 제1정리",
     "@language": "ko"
    },
    {
     "@value": "first welfare theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조건(완비 시장, 가격수용, 외부성 없음 등)이 갖춰지면 경쟁균형은 파레토 효율적이라는 정리.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/tax-incidence"
    }
   ]
  },
  {
   "@id": "lab:theory/second-welfare-theorem",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "후생경제학 제2정리",
     "@language": "ko"
    },
    {
     "@value": "second welfare theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조건 아래 원하는 효율적 배분을 일괄 이전 + 경쟁시장으로 이룰 수 있음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:theory/first-welfare-theorem"
    }
   ]
  },
  {
   "@id": "lab:concept/social-welfare-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "사회후생함수",
     "@language": "ko"
    },
    {
     "@value": "social welfare function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사람들의 후생을 사회 전체의 평가로 묶는 규칙. 분배에 대한 가치판단을 드러냄.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:theory/first-welfare-theorem"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/maximin"
    }
   ]
  },
  {
   "@id": "lab:term/statutory-payer",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "법적 납부자",
     "@language": "ko"
    },
    {
     "@value": "statutory payer",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정부에 세금을 보낼 의무가 있는 쪽. 실제 부담과 다를 수 있음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/tax-incidence"
    }
   ]
  },
  {
   "@id": "lab:policy/pigouvian-tax",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "피구세",
     "@language": "ko"
    },
    {
     "@value": "Pigouvian tax",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1단위당 외부 피해와 같은 세금. 외부비용을 가격에 넣음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/externality"
    }
   ]
  },
  {
   "@id": "lab:theory/coase-theorem",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "코즈 정리",
     "@language": "ko"
    },
    {
     "@value": "Coase theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "재산권이 분명하고 거래비용이 작으면 당사자 협상으로 효율적 결과에 이를 수 있음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/externality"
    }
   ]
  },
  {
   "@id": "lab:concept/value-of-information",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "정보의 가치",
     "@language": "ko"
    },
    {
     "@value": "value of information",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정보를 보고 결정을 바꿔 얻는 기대 이득. 정보 없이 최선의 기대비용 − 정보를 쓸 때의 기대비용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/adverse-selection"
    },
    {
     "@id": "lab:concept/search"
    }
   ]
  },
  {
   "@id": "lab:concept/adverse-selection",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "역선택",
     "@language": "ko"
    },
    {
     "@value": "adverse selection",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "거래 전 숨은 정보(품질·위험) 때문에 나쁜 유형만 시장에 남는 현상.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/principal-agent"
    }
   ]
  },
  {
   "@id": "lab:concept/principal-agent",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "주인-대리인 문제",
     "@language": "ko"
    },
    {
     "@value": "principal–agent problem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일을 맡긴 쪽(주인)이 맡은 쪽(대리인)의 행동을 볼 수 없을 때 유인과 위험을 함께 설계하는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv3"
   }
  },
  {
   "@id": "lab:method/bayesian-updating",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "베이즈 갱신",
     "@language": "ko"
    },
    {
     "@value": "Bayesian updating",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "신호를 받은 뒤 사전확률을 사후확률로 고치는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/value-of-information"
    }
   ]
  },
  {
   "@id": "lab:concept/evsi",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "EVSI",
     "@language": "ko"
    },
    {
     "@value": "expected value of sample information",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "신호(표본) 정보의 기대가치.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/value-of-information"
    }
   ]
  },
  {
   "@id": "lab:concept/evpi",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "EVPI",
     "@language": "ko"
    },
    {
     "@value": "expected value of perfect information",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "완전정보의 기대가치. 정보 가치의 상한.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/value-of-information"
    }
   ]
  },
  {
   "@id": "lab:concept/search",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "탐색",
     "@language": "ko"
    },
    {
     "@value": "search",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "더 좋은 가격·상대를 찾기 위해 비용을 들여 알아보는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/value-of-information"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/moral-hazard"
    }
   ]
  },
  {
   "@id": "lab:concept/asymmetric-information",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "정보 비대칭",
     "@language": "ko"
    },
    {
     "@value": "asymmetric information",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "거래 당사자 한쪽만 중요한 정보를 가진 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/information-asymmetry"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/adverse-selection"
    }
   ]
  },
  {
   "@id": "lab:concept/signaling",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "신호",
     "@language": "ko"
    },
    {
     "@value": "signaling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정보를 가진 쪽이 비용이 드는 행동으로 자기 유형을 알리는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/adverse-selection"
    }
   ]
  },
  {
   "@id": "lab:concept/moral-hazard",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "도덕적 해이",
     "@language": "ko"
    },
    {
     "@value": "moral hazard",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "계약 뒤 상대의 행동을 볼 수 없어 생기는 유인 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/principal-agent"
    }
   ]
  },
  {
   "@id": "lab:concept/risk-premium",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "위험 프리미엄",
     "@language": "ko"
    },
    {
     "@value": "risk premium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "흔들리는 보수를 받아들이게 하려고 더 줘야 하는 금액.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/principal-agent"
    },
    {
     "@id": "lab:concept/risk-aversion"
    }
   ]
  },
  {
   "@id": "lab:term/performance-pay",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "성과급",
     "@language": "ko"
    },
    {
     "@value": "performance pay",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "성과에 비례해 주는 보수. 여기서는 비율 β.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/07_information.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/principal-agent"
    }
   ]
  },
  {
   "@id": "lab:concept/diminishing-returns",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "수확 체감",
     "@language": "ko"
    },
    {
     "@value": "diminishing returns",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다른 투입을 고정하고 한 투입을 늘릴수록 한계생산이 줄어드는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/01_technology.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/marginal-product"
    }
   ]
  },
  {
   "@id": "lab:term/homogeneous-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "동차함수",
     "@language": "ko"
    },
    {
     "@value": "homogeneous function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 변수를 t배 하면 값이 t^k배가 되는 함수(k차 동차).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/01_technology.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/returns-to-scale"
    }
   ]
  },
  {
   "@id": "lab:concept/mrts",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "MRTS",
     "@language": "ko"
    },
    {
     "@value": "marginal rate of technical substitution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "산출을 유지하며 노동 하나로 대신할 수 있는 자본의 양.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/01_technology.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/isoquant"
    },
    {
     "@id": "lab:concept/production-efficiency"
    }
   ]
  },
  {
   "@id": "lab:concept/production-possibility-set",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "생산가능집합",
     "@language": "ko"
    },
    {
     "@value": "production possibility set",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "실행 가능한 모든 생산 계획(투입은 음수, 산출은 양수로 적은 순산출 벡터)의 모음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/01_technology.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/isoquant"
    }
   ]
  },
  {
   "@id": "lab:term/free-disposal",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "자유처분",
     "@language": "ko"
    },
    {
     "@value": "free disposal",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "산출을 버리거나 투입을 더 써도 여전히 가능하다는 가정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/01_technology.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/isoquant"
    }
   ]
  },
  {
   "@id": "lab:concept/profit-maximization",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이윤극대화",
     "@language": "ko"
    },
    {
     "@value": "profit maximization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격이 주어진 상태에서 매출 − 비용이 가장 큰 생산 계획을 고르는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/02_profit_maximization.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/value-of-marginal-product"
    }
   ]
  },
  {
   "@id": "lab:concept/value-of-marginal-product",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "한계생산가치",
     "@language": "ko"
    },
    {
     "@value": "value of marginal product",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "투입 한 단위를 더 쓸 때 늘어나는 산출의 가치 p × MP.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/02_profit_maximization.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/shutdown-decision"
    }
   ]
  },
  {
   "@id": "lab:concept/shutdown-decision",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "조업중단 판단",
     "@language": "ko"
    },
    {
     "@value": "shutdown decision",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생산할 때 이윤과 멈출 때 이윤을 비교해 생산 여부를 정하는 것. 매몰비는 양쪽에 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/02_profit_maximization.html#lv3"
   }
  },
  {
   "@id": "lab:concept/price-taking",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가격수용",
     "@language": "ko"
    },
    {
     "@value": "price taking",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자기 선택으로 가격을 바꿀 수 없어 주어진 가격을 받아들이는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/02_profit_maximization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/profit-maximization"
    },
    {
     "@id": "lab:concept/firm-supply"
    }
   ]
  },
  {
   "@id": "lab:term/interior-solution",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "내부해",
     "@language": "ko"
    },
    {
     "@value": "interior solution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선택 범위의 경계가 아닌 안쪽에서 1계조건으로 정해지는 해.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/02_profit_maximization.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/value-of-marginal-product"
    }
   ]
  },
  {
   "@id": "lab:term/avoidable-fixed-cost",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "회피 가능한 고정비",
     "@language": "ko"
    },
    {
     "@value": "avoidable fixed cost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생산량과 무관하지만 멈추면 안 내도 되는 비용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/02_profit_maximization.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/shutdown-decision"
    }
   ]
  },
  {
   "@id": "lab:concept/profit-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이윤함수",
     "@language": "ko"
    },
    {
     "@value": "profit function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격의 함수로 본 최대 이윤.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/03_profit_function.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/hotelling-lemma"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/discrete-processes"
    }
   ]
  },
  {
   "@id": "lab:concept/hotelling-lemma",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "호텔링 보조정리",
     "@language": "ko"
    },
    {
     "@value": "Hotelling's lemma",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이윤함수의 가격 미분이 공급과 요소수요(부호 포함)가 된다는 결과.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/03_profit_function.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/homogeneity-of-profit"
    }
   ]
  },
  {
   "@id": "lab:concept/homogeneity-of-profit",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이윤함수의 1차 동차성",
     "@language": "ko"
    },
    {
     "@value": "homogeneity of degree one",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 가격을 t배 하면 최대 이윤도 t배, 최적 계획은 그대로.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/03_profit_function.html#lv3"
   }
  },
  {
   "@id": "lab:term/value-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가치함수",
     "@language": "ko"
    },
    {
     "@value": "value function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최적화 문제의 최댓값을 파라미터의 함수로 본 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/03_profit_function.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/profit-function"
    }
   ]
  },
  {
   "@id": "lab:concept/supply-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "공급함수",
     "@language": "ko"
    },
    {
     "@value": "supply function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격의 함수로 본 최적 산출.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/03_profit_function.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/profit-function"
    }
   ]
  },
  {
   "@id": "lab:concept/envelope-theorem",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "포락선 정리",
     "@language": "ko"
    },
    {
     "@value": "envelope theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최적값의 파라미터 미분은 최적점에서 평가한 편미분과 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/03_profit_function.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/hotelling-lemma"
    },
    {
     "@id": "lab:concept/shephard-lemma"
    }
   ]
  },
  {
   "@id": "lab:concept/factor-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "요소수요",
     "@language": "ko"
    },
    {
     "@value": "factor demand",

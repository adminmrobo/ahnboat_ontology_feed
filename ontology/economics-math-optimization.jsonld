  },
  {
   "@id": "lab:concept/intermediation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "금융중개",
     "@language": "ko"
    },
    {
     "@value": "financial intermediation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "금융기관이 예금·보험료를 받아 대출·채권 등으로 다시 운용하는 일. 겉 기록의 상대가 금융기관이 되는 이유.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/02_fof_who_to_whom.html#lv2"
   },

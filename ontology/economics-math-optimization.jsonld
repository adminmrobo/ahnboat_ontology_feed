     "@id": "lab:concept/laffer-curve"
    }
   ]
  },
  {
   "@id": "lab:concept/laffer-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "래퍼 곡선",
     "@language": "ko"
    },
    {
     "@value": "Laffer curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "세율이 오를 때 세수가 처음엔 늘다가 일정 수준을 넘으면 줄어드는 관계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/07_cost_of_taxation.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/taxation"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/perfect-competition"
    }
   ]
  },
  {
   "@id": "lab:term/tax-wedge",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "쐐기",
     "@language": "ko"
    },
    {
     "@value": "tax wedge",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "구매자 가격과 판매자 수취가격의 차이 = 세금.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/07_cost_of_taxation.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/deadweight-loss"
    }
   ]
  },
  {
   "@id": "lab:term/price-taker",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "가격수용자",
     "@language": "ko"
    },
    {
     "@value": "price taker",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시장가격을 그대로 받아들이는 경제주체.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/08_market_structure.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/perfect-competition"
    }
   ]
  },
  {
   "@id": "lab:concept/market-structure",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시장구조",
     "@language": "ko"
    },
    {
     "@value": "market structure",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기업 수와 제품 특성으로 나눈 시장의 형태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/08_market_structure.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/perfect-competition"
    }
   ]
  },
  {
   "@id": "lab:term/natural-monopoly",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "자연독점",
     "@language": "ko"
    },
    {
     "@value": "natural monopoly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "규모의 경제로 하나의 기업이 가장 싸게 공급하는 독점.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/08_market_structure.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/monopoly"
    }
   ]
  },
  {
   "@id": "lab:term/collusion",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "담합",
     "@language": "ko"
    },
    {
     "@value": "collusion, cartel",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생산량·가격을 함께 정하는 행위와 그 집단.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/08_market_structure.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/oligopoly"
    }
   ]
  },
  {
   "@id": "lab:concept/monopolistic-competition",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "독점적 경쟁",
     "@language": "ko"
    },
    {
     "@value": "monopolistic competition",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차별화된 제품을 파는 많은 기업과 자유 진입이 있는 시장.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/08_market_structure.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/monopolistic-competition"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/oligopoly"
    }
   ]
  },
  {
   "@id": "lab:concept/gini",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "소득분배와 지니계수",
     "@language": "ko"
    },
    {
     "@value": "income distribution and Gini coefficient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "로렌츠 곡선과 평등선 사이 면적으로 소득 불평등을 0~1 사이 값으로 나타낸 지표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/09_market_failure.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/gdp"
    }
   ]
  },
  {
   "@id": "lab:term/negative-externality",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "외부불경제",
     "@language": "ko"
    },
    {
     "@value": "negative externality",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "제3자에게 손해를 주는 외부효과. 과다 생산.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/09_market_failure.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/externality"
    }
   ]
  },
  {
   "@id": "lab:term/positive-externality",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "외부경제",
     "@language": "ko"
    },
    {
     "@value": "positive externality",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "제3자에게 이익을 주는 외부효과. 과소 생산.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/09_market_failure.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/externality"
    }
   ]
  },
  {
   "@id": "lab:concept/lorenz-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "로렌츠 곡선",
     "@language": "ko"
    },
    {
     "@value": "Lorenz curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "누적 인구 대비 누적 소득을 그린 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/09_market_failure.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/gini"
    }
   ]
  },
  {
   "@id": "lab:term/decile-ratio",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "10분위분배율",
     "@language": "ko"
    },
    {
     "@value": "decile distribution ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "하위 40% 소득 ÷ 상위 20% 소득. 0~2, 클수록 평등.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/09_market_failure.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/gini"
    }
   ]
  },
  {
   "@id": "lab:concept/gdp",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "GDP와 실질 GDP",
     "@language": "ko"
    },
    {
     "@value": "GDP and real GDP",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "국내에서 일정 기간 생산된 최종 재화·서비스의 시장가치. 실질 GDP는 기준연도 가격으로 계산.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/unemployment-rate"
    }
   ]
  },
  {
   "@id": "lab:concept/unemployment-rate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "실업률과 고용지표",
     "@language": "ko"
    },
    {
     "@value": "unemployment rate and employment indicators",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "경제활동인구 중 실업자의 비율과, 이를 보완하는 고용률·경제활동참가율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/phillips-curve"
    }
   ]
  },
  {
   "@id": "lab:concept/phillips-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "인플레이션과 필립스 곡선",
     "@language": "ko"
    },
    {
     "@value": "inflation and the Phillips curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "물가의 지속적 상승과, 단기에 실업률과 물가상승률이 반대로 움직이는 관계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/aggregate-demand"
    }
   ]
  },
  {
   "@id": "lab:term/gnp",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "GNP",
     "@language": "ko"
    },
    {
     "@value": "gross national product",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 나라 국민이 국내외에서 생산한 가치.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/gdp"
    }
   ]
  },

   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "총운용·총조달",
     "@language": "ko"
    },
    {
     "@value": "gross uses and sources",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순자금운용 뒤에 있는 운용 합과 조달 합. 순액이 작아도 총액은 클 수 있다.",
    "@language": "ko"
   },

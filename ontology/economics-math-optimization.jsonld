  {
   "@id": "lab:concept/expenditure-matrix",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지출행렬",
     "@language": "ko"
    },
    {
     "@value": "expenditure matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관측 가격별로 모든 묶음의 값을 매긴 표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

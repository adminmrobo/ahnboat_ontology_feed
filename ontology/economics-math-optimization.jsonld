   ],
   "skos:prefLabel": [
    {
     "@value": "코사인 유사도",
     "@language": "ko"
    },
    {
     "@value": "cosine similarity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 벡터가 이루는 각도의 코사인. −1(반대)~1(같은 방향) 값을 가지며 벡터의 길이는 무시한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

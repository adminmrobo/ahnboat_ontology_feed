    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "복제 포트폴리오",
     "@language": "ko"
    },
    {
     "@value": "replicating portfolio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "거래되는 자산으로 같은 상태별 지급을 만드는 조합.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv2"
   },

   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "코즈의 정리",
     "@language": "ko"
    },
    {
     "@value": "Coase theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "재산권이 분명하고 협상 비용이 작으면 당사자 협상으로 효율적 해결이 가능.",
    "@language": "ko"

   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "학습률 일정(워밍업·감소)",
     "@language": "ko"
    },
    {
     "@value": "Learning-rate schedule",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습 중에 학습률을 바꾸는 방법. 처음엔 올리고 나중엔 줄인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/2_experiment_lab.html#sum"
   },

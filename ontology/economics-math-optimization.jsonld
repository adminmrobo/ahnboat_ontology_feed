    },
    {
     "@value": "Chebyshev distance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가장 많이 움직인 축 하나의 거리. 8.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

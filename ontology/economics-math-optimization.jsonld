  {
   "@id": "lab:term/present-value",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "현재가치",
     "@language": "ko"
    },
    {
     "@value": "present value",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "미래 금액을 이자율로 할인한 오늘 가치.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/19_time.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/npv"
    }
   ]
  },
  {
   "@id": "lab:term/discounting",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "할인",
     "@language": "ko"
    },
    {
     "@value": "discounting",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "미래 금액을 1/(1 + r)ᵗ로 곱해 오늘 가치로 바꾸는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/19_time.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/npv"
    }
   ]
  },
  {
   "@id": "lab:term/time-preference",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "시간선호",
     "@language": "ko"
    },
    {
     "@value": "time preference",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "미래 효용을 지금 기준으로 낮게 보는 정도 β.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/19_time.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/fisher-separation"
    }
   ]
  },
  {
   "@id": "lab:term/perfect-capital-market",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "완전자본시장",
     "@language": "ko"
    },
    {
     "@value": "perfect capital market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 금리로 제약 없이 빌리고 빌려줄 수 있는 시장.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/19_time.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/fisher-separation"
    }
   ]
  },
  {
   "@id": "lab:term/bellman",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "벨만 방정식",
     "@language": "ko"
    },
    {
     "@value": "Bellman equation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Vₜ(K) = max{u(c) + βVₜ₊₁(K′)}.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/19_time.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/euler-bellman"
    }
   ]
  },
  {

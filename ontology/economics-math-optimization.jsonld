   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "부분균형",
     "@language": "ko"
    },
    {
     "@value": "partial equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다른 시장의 가격·소득을 고정하고 한 시장만 푸는 균형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

     "@id": "lab:concept/phillips-curve"
    }
   ]
  },
  {
   "@id": "lab:concept/aggregate-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "총수요와 총공급",
     "@language": "ko"
    },
    {
     "@value": "aggregate demand and supply",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 나라 전체의 재화·서비스에 대한 수요(C + I + G + NX)와 공급이 물가와 실질 GDP를 정한다는 틀.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/11_economic_policy.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/ad-as"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/fiscal-policy"
    }
   ]
  },
  {
   "@id": "lab:concept/fiscal-policy",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "재정정책",
     "@language": "ko"
    },
    {
     "@value": "fiscal policy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정부지출과 조세를 조정해 총수요를 관리하는 정책.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/11_economic_policy.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/monetary-policy"
    }
   ]
  },
  {
   "@id": "lab:concept/monetary-policy",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "통화정책과 정책조합",
     "@language": "ko"
    },
    {
     "@value": "monetary policy and policy mix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "중앙은행이 기준금리 등으로 통화량을 간접 조절해 총수요를 관리하고, 재정정책과 함께 쓰는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/11_economic_policy.html#lv3"
   }
  },

     "@id": "lab:concept/social-welfare-function"
    }
   ]
  },
  {
   "@id": "lab:term/upf",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "효용가능경계",
     "@language": "ko"
    },
    {
     "@value": "utility possibility frontier",
     "@language": "en"
    }
   ],
   "skos:definition": {

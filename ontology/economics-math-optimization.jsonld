   ]
  },
  {
   "@id": "lab:concept/leverage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "레버리지",
     "@language": "ko"
    },
    {
     "@value": "leverage",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "빌린 돈으로 투자 규모를 키우는 것. 손실을 키워 충격을 크게 만든다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/03_fof_between_stations.html#lv5"
   },
   "lab:topic": [

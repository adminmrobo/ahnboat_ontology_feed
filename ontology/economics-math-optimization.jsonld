  },
  {
   "@id": "lab:concept/financial-accelerator",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "금융가속기",
     "@language": "ko"
    },
    {
     "@value": "financial accelerator",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기업·은행의 순자본 변화가 차입 비용을 거쳐 경기 변동을 키우는 기제.",
    "@language": "ko"
   },

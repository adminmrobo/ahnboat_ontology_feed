    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "벨만 방정식",
     "@language": "ko"
    },
    {
     "@value": "Bellman equation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Vₜ(K) = max{u(c) + βVₜ₊₁(K′)}.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/19_time.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/euler-bellman"
    }
   ]
  },
  {
   "@id": "lab:concept/state-prices",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "상태가격",
     "@language": "ko"
    },
    {
     "@value": "state prices",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "특정 상태에서만 1을 지급하는 증서의 오늘 가격.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/replication"
    }
   ]
  },
  {
   "@id": "lab:concept/replication",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "복제 포트폴리오",
     "@language": "ko"
    },
    {
     "@value": "replicating portfolio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "거래되는 자산으로 같은 상태별 지급을 만드는 조합.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/diversification"
    }
   ]
  },
  {
   "@id": "lab:concept/diversification",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "분산투자",
     "@language": "ko"
    },
    {
     "@value": "diversification",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "상관이 낮은 자산을 섞어 위험을 줄이는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv3"
   }
  },
  {

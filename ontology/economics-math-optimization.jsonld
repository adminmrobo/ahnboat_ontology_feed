     "@value": "이웃 여섯 평균 비교",
     "@language": "ko"
    },
    {
     "@value": "Six-neighbour stencil",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "∇²f ≈ 6 × (이웃 평균 − 가운데) ÷ h².",
    "@language": "ko"

    }
   ]
  },
  {
   "@id": "lab:concept/existence-uniqueness",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "균형의 존재와 유일성",
     "@language": "ko"
    },
    {
     "@value": "existence and uniqueness of equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시장청산 가격이 적어도 하나 있는지, 하나뿐인지에 관한 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/comparative-statics"
    }
   ]
  },
  {
   "@id": "lab:concept/tatonnement-stability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가격조정의 안정성",
     "@language": "ko"
    },
    {
     "@value": "tâtonnement stability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격조정 규칙이 균형으로 수렴하는지에 관한 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv3"
   }
  },

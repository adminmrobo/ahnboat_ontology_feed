  {
   "@id": "lab:concept/pacing-problem",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "페이싱 문제와 정책 시차",
     "@language": "ko"
    },
    {
     "@value": "pacing problem and policy lag",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사회의 변화 속도와 정책의 대응 속도가 다를 때 생기는 틈. 오래 지나 남는 틈은 대략 두 속도의 비율(v ÷ μ)이 정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/pacing_problem_lab/index.html#lv3"
   },

   ],
   "skos:prefLabel": [
    {
     "@value": "등위면(같은 값 껍질)",
     "@language": "ko"
    },
    {
     "@value": "Level surface",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "값이 같은 점들을 이은 면. 2차원에서는 등고선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/3_arrow_field.html#s2"

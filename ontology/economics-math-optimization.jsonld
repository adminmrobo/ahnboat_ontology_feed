  {
   "@id": "lab:concept/cost-function-properties",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "비용함수의 성질",
     "@language": "ko"
    },
    {
     "@value": "properties of the cost function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "요소가격에 대해 1차 동차·증가·오목, 산출에 대해 증가.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/05_cost_function.html#lv1"
   },

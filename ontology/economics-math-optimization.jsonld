    }
   ]
  },
  {
   "@id": "lab:concept/garp",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "GARP",
     "@language": "ko"
    },
    {
     "@value": "generalized axiom of revealed preference",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "현시선호 연쇄 뒤에 엄격한 반대 관계가 없어야 한다는 조건.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/revealed-preference-limits"
    }
   ]
  },
  {
   "@id": "lab:concept/revealed-preference-limits",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "현시선호의 식별 한계",
     "@language": "ko"
    },
    {
     "@value": "limits of revealed preference",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "유한한 선택 자료로는 선호의 일부 제한만 얻는다는 점.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv3"
   }
  },
  {
   "@id": "lab:term/transitivity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이행성",
     "@language": "ko"
    },
    {
     "@value": "transitivity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "x ≽ y이고 y ≽ z이면 x ≽ z.",

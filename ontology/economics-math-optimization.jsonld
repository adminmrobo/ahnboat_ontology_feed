   }
  },
  {
   "@id": "lab:term/no-arbitrage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "무차익",
     "@language": "ko"
    },
    {
     "@value": "no arbitrage",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "비용 없이 위험 없는 이득을 얻는 조합이 없는 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/state-prices"
    }
   ]
  },
  {
   "@id": "lab:term/complete-market",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "완비시장",
     "@language": "ko"
    },
    {
     "@value": "complete market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 상태별 지급을 거래 자산으로 복제할 수 있는 시장.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/state-prices"
    }
   ]
  },
  {
   "@id": "lab:term/risk-neutral",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "위험중립 확률",
     "@language": "ko"
    },
    {
     "@value": "risk-neutral probability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "상태가격 ÷ 채권가격. 실제 확률이 아님.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/replication"
    }
   ]
  },
  {
   "@id": "lab:term/incomplete-market",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "불완비시장",
     "@language": "ko"
    },
    {
     "@value": "incomplete market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일부 지급을 복제할 수 없는 시장. 가격이 범위로 정해짐.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/replication"
    }
   ]
  },
  {
   "@id": "lab:term/capm",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "CAPM",
     "@language": "ko"
    },
    {
     "@value": "capital asset pricing model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "E[Rᵢ] − r_f = βᵢ(E[R_M] − r_f).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/diversification"
    }
   ]
  },
  {
   "@id": "lab:concept/existence-uniqueness",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "균형의 존재와 유일성",
     "@language": "ko"
    },
    {
     "@value": "existence and uniqueness of equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시장청산 가격이 적어도 하나 있는지, 하나뿐인지에 관한 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/comparative-statics"
    }
   ]
  },
  {
   "@id": "lab:concept/tatonnement-stability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가격조정의 안정성",
     "@language": "ko"
    },
    {
     "@value": "tâtonnement stability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격조정 규칙이 균형으로 수렴하는지에 관한 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/21_equilibrium_analysis.html#lv3"
   }
  },

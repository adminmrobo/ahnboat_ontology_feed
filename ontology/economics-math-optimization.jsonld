     "@id": "lab:concept/replication"
    }
   ]
  },
  {
   "@id": "lab:term/incomplete-market",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "불완비시장",
     "@language": "ko"
    },
    {
     "@value": "incomplete market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일부 지급을 복제할 수 없는 시장. 가격이 범위로 정해짐.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/replication"
    }
   ]
  },
  {
   "@id": "lab:term/capm",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "CAPM",
     "@language": "ko"
    },
    {
     "@value": "capital asset pricing model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "E[Rᵢ] − r_f = βᵢ(E[R_M] − r_f).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv3"
   },
   "lab:partOf": [

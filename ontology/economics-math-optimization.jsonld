     "@value": "오목함수",
     "@language": "ko"
    },
    {
     "@value": "concave function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 점을 잇는 선분이 그래프 아래(또는 위)에 있는 함수.",
    "@language": "ko"

     "@id": "lab:concept/expenditure-function"
    }
   ]
  },
  {
   "@id": "lab:concept/expenditure-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지출함수",
     "@language": "ko"
    },
    {
     "@value": "expenditure function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 목표 효용의 함수로 본 최소 지출.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv3"
   },
   "lab:partOf": [

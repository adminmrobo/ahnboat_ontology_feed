    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/production-function"
    },
    {
     "@id": "lab:concept/marginal-product"
    }
   ]
  },
  {
   "@id": "lab:concept/isocost-line",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "등비용선",
     "@language": "ko"
    },
    {
     "@value": "isocost line",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 비용이 드는 투입 묶음들의 선. 기울기 크기 = w/r.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv2"
   },
   "lab:partOf": [

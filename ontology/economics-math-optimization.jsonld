  {
   "@id": "lab:concept/ai-output-check",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "AI 결과 확인 질문 (단위·가정·상식)",
     "@language": "ko"
    },
    {
     "@value": "Checking AI output",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "AI가 낸 결과를 받으면 단위, 가정, 상식에 맞는지를 묻는다.",
    "@language": "ko"
   },

   "skos:prefLabel": [
    {
     "@value": "P × MP_L = w",
     "@language": "ko"
    },
    {
     "@value": "Value of marginal product equals wage",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 명 더의 매출 = 임금에서 고용을 멈춘다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/first_step_2.html#s41"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/lagrangian"
    }
   ]
  },
  {
   "@id": "lab:concept/constant-returns",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "규모에 대한 수익 불변",
     "@language": "ko"
    },
    {
     "@value": "Constant returns to scale",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 투입을 t배 하면 생산도 t배.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/first_step_2.html#s43"
   },

    {
     "@value": "순자산 지니계수",
     "@language": "ko"
    },
    {
     "@value": "net worth Gini coefficient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순자산 분포의 불평등 정도. 0이면 완전 평등, 1이면 한 가구가 전부.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/01_fof_money_meridian.html#d-wealth"
   }
  },
  {

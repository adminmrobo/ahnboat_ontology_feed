    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "탄력성과 사중손실",
     "@language": "ko"
    },
    {
     "@value": "elasticity and deadweight loss",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "수요·공급이 탄력적일수록 세금에 따른 거래 감소와 사중손실이 크다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/07_cost_of_taxation.html#lv2"
   },

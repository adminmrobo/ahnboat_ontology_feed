   ]
  },
  {
   "@id": "lab:concept/threshold-wage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "임계임금과 절벽형 노동수요",
     "@language": "ko"
    },
    {
     "@value": "threshold wage and cliff-shaped labor demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "완전대체 기술에서 노동과 AI의 단위비용이 같아지는 임금. 이를 넘으면 노동수요가 0으로 떨어진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/pacing_problem_lab/index.html#links"
   },

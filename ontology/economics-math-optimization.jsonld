   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "회전의 발산은 0",
     "@language": "ko"
    },
    {
     "@value": "Divergence of a curl is zero",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "회전 화살표로 만든 밭에는 샘도 구멍도 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/3_arrow_field.html#sum"

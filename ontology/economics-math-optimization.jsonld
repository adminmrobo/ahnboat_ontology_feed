    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "숫자 밭(스칼라장)",
     "@language": "ko"
    },
    {
     "@value": "Scalar field",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공간의 점마다 숫자 하나가 붙은 것. 온도, 농도, 오차.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

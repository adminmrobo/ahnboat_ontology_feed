    {
     "@value": "교차탄력성",
     "@language": "ko"
    },
    {
     "@value": "cross-price elasticity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다른 재화 가격 1% 변화에 수요량이 몇 % 변하는지.",
    "@language": "ko"
   },

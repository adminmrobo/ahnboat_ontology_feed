    }
   ]
  },
  {
   "@id": "lab:concept/euler-theorem",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "오일러 정리(생산물 소진)",
     "@language": "ko"
    },
    {
     "@value": "Euler's theorem (product exhaustion)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1차 동차함수면 Q = MP_L·L + MP_K·K.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/first_step_2.html#s43"
   },

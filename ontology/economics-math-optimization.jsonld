    },
    {
     "@value": "price floor",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정부가 정한 가격 이하로 거래하지 못하게 하는 규제(최저가격제). 예: 최저임금, 농산물 가격 지지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

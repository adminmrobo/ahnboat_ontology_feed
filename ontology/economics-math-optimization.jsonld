    }
   ]
  },
  {
   "@id": "lab:concept/marginal-rate-of-substitution",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "한계대체율",
     "@language": "ko"
    },
    {
     "@value": "marginal rate of substitution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "x 한 단위를 더 얻는 대신 기꺼이 포기할 y의 양. 무차별곡선 기울기의 크기.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:concept/utility-maximization",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "효용극대화",
     "@language": "ko"
    },
    {
     "@value": "utility maximization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "예산 제약 안에서 효용이 가장 큰 묶음을 고르는 문제. 해가 마셜(보통) 수요다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/consumer-choice"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/compensating-variation"
    },
    {
     "@id": "lab:concept/mrs"
    }
   ]
  },
  {
   "@id": "lab:concept/compensating-variation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "보상변화(CV)",
     "@language": "ko"
    },
    {
     "@value": "compensating variation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격이 바뀐 뒤 처음 효용을 되찾게 해 주는 데 필요한 돈. 새 가격 기준.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/production-function"
    },
    {
     "@id": "lab:concept/consumer-surplus"
    }
   ]
  },
  {
   "@id": "lab:concept/budget-line",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "예산선",
     "@language": "ko"
    },
    {
     "@value": "budget line",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "주어진 소득을 다 쓰는 묶음들의 선. 기울기 크기 = 가격비.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/marginal-rate-of-substitution"
    }
   ]
  },
  {
   "@id": "lab:concept/indifference-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "무차별곡선",
     "@language": "ko"
    },
    {
     "@value": "indifference curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 만족을 주는 묶음들을 이은 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/indifference-curves"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/marginal-rate-of-substitution"
    }
   ]
  },
  {
   "@id": "lab:concept/utility",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "효용",
     "@language": "ko"
    },
    {
     "@value": "utility",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선호의 순서를 숫자로 나타낸 것. 같은 사람 안에서만 비교.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/utility"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/marginal-rate-of-substitution"
    }
   ]
  },
  {
   "@id": "lab:model/cobb-douglas-utility",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "코브-더글러스",
     "@language": "ko"
    },
    {
     "@value": "Cobb–Douglas utility",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "u = x^α y^(1−α). 지출 비중이 α로 일정한 특수한 선호.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:concept/marshallian-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "마셜 수요",
     "@language": "ko"
    },
    {
     "@value": "Marshallian demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격·소득이 주어졌을 때 효용극대화로 정해지는 수요.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:term/monotonic-transformation",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "단조증가 변환",
     "@language": "ko"
    },
    {
     "@value": "monotonic transformation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순서를 바꾸지 않는 변환(예: 로그). 효용에 적용해도 같은 선택.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/utility-maximization"
    }
   ]
  },
  {
   "@id": "lab:concept/substitution-effect",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대체효과",
     "@language": "ko"
    },
    {
     "@value": "substitution effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 만족을 유지한 채 상대가격 변화만으로 생긴 수요 변화.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/income-substitution-effects"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/compensating-variation"
    },
    {
     "@id": "lab:concept/hicks-decomposition"
    }
   ]
  },
  {
   "@id": "lab:concept/income-effect",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "소득효과",
     "@language": "ko"
    },
    {
     "@value": "income effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격 변화로 실질소득이 바뀌어 생긴 수요 변화.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/compensating-variation"
    },
    {
     "@id": "lab:concept/hicks-decomposition"
    }
   ]
  },
  {
   "@id": "lab:concept/equivalent-variation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "동등변화",
     "@language": "ko"
    },
    {
     "@value": "equivalent variation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "옛 가격에서 새 효용과 같아지게 하려면 빼야 할 돈.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/compensating-variation"
    }
   ]
  },
  {
   "@id": "lab:concept/hicksian-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "힉스 수요",
     "@language": "ko"
    },
    {
     "@value": "Hicksian demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "목표 효용을 가장 싸게 얻는 수요. 지출최소화의 해.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/01_consumer_choice.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/compensating-variation"
    },
    {
     "@id": "lab:concept/expenditure-function"
    }
   ]
  },
  {
   "@id": "lab:concept/production-function",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "생산함수",
     "@language": "ko"
    },
    {
     "@value": "production function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "투입 묶음으로 만들 수 있는 최대 산출을 나타낸 함수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/production-function"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/cost-minimization"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/marginal-product"
    }
   ]
  },
  {
   "@id": "lab:method/cost-minimization",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "비용최소화",
     "@language": "ko"
    },
    {
     "@value": "cost minimization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정해진 산출을 가장 적은 비용으로 만드는 투입 묶음을 고르는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/shutdown-condition"
    }
   ]
  },
  {
   "@id": "lab:concept/shutdown-condition",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "조업중단 조건",
     "@language": "ko"
    },
    {
     "@value": "shutdown condition",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격이 평균가변비용의 최저점보다 낮으면 단기에 생산을 멈추는 것이 손실을 줄인다는 조건.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/marginal-revenue"
    }
   ]
  },
  {
   "@id": "lab:concept/returns-to-scale",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "규모수익",
     "@language": "ko"
    },
    {
     "@value": "returns to scale",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 투입을 t배 할 때 산출이 t배보다 큰지·같은지·작은지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/production-function"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/isoquant"
    }
   ]
  },
  {
   "@id": "lab:term/output-elasticity",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "산출탄력성",
     "@language": "ko"
    },
    {
     "@value": "output elasticity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "투입이 1% 늘 때 산출이 늘어나는 비율(%).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/elasticity"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/production-function"
    },
    {
     "@id": "lab:concept/marginal-product"
    }
   ]
  },
  {
   "@id": "lab:concept/isocost-line",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "등비용선",
     "@language": "ko"
    },
    {
     "@value": "isocost line",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 비용이 드는 투입 묶음들의 선. 기울기 크기 = w/r.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/cost-minimization"
    }
   ]
  },
  {
   "@id": "lab:concept/conditional-factor-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "조건부 요소수요",
     "@language": "ko"
    },
    {
     "@value": "conditional factor demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정해진 산출을 최소비용으로 만드는 투입량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv2"
   },
   "lab:topic": [
    {

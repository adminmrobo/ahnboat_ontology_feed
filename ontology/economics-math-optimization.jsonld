     "@id": "lab:concept/spacetime-interval"
    }
   ]
  },
  {
   "@id": "lab:concept/time-dilation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시간 팽창",
     "@language": "ko"
    },
    {
     "@value": "Time dilation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "속도 0.6으로 따라간 사람의 시계는 4, 멈춘 사람은 5.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/minkowski_space_lab/m1_clock_corridor.html#r4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/minkowski-spacetime"
    }
   ],
   "lab:derivedFrom": [

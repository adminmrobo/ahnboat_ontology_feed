    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/validation-loss"
    }
   ]
  },
  {
   "@id": "lab:metric/full-data-loss",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "전체 데이터 오차",
     "@language": "ko"
    },
    {
     "@value": "Full-data loss",
     "@language": "en"
    }
   ],
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/2_experiment_lab.html#s1"
   }
  },
  {
   "@id": "lab:method/learning-rate-sweep",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "② 학습률 고르기",
     "@language": "ko"
    },
    {
     "@value": "Learning-rate sweep",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습률을 여러 값으로 돌려 보고 오차로 고른다. 굽음이 정한 한계를 넘지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/2_experiment_lab.html#s2"
   },
   "lab:prerequisiteOf": [
    {

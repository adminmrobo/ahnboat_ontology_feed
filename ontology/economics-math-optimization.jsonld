     "@id": "lab:concept/gdp"
    }
   ]
  },
  {
   "@id": "lab:concept/business-cycle",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "경기변동",
     "@language": "ko"
    },
    {
     "@value": "business cycle",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "장기 성장 추세를 중심으로 회복·호황·후퇴·불황을 오가는 움직임.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

  {
   "@id": "lab:concept/w2w-matrix",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "거래상대방 행렬",
     "@language": "ko"
    },
    {
     "@value": "from-whom-to-whom matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "행=보유자, 열=발행자인 금융자산 행렬. 행의 합은 보유자의 금융자산, 열의 합은 발행자의 부채.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/fof-money-meridian-/02_fof_who_to_whom.html#lv2"

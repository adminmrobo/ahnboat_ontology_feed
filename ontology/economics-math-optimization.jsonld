     "@value": "순자금운용",
     "@language": "ko"
    },
    {
     "@value": "net lending / net borrowing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자금운용에서 자금조달을 뺀 값. +면 그 부문이 다른 부문에 돈을 대고, −면 빌려 쓴다.",
    "@language": "ko"

     "@value": "선형대수",
     "@language": "ko"
    },
    {
     "@value": "Linear algebra",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "2~5장: 스칼라·벡터·행렬, 벡터·행렬 연산, 연립방정식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/math_basic_for_ai_dictionary/index.html#toc"
   },

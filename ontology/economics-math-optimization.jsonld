     "@id": "lab:concept/garp"
    }
   ]
  },
  {
   "@id": "lab:term/local-nonsatiation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "국소 비포화",
     "@language": "ko"
    },
    {
     "@value": "local nonsatiation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "어떤 묶음 근처에도 더 좋은 묶음이 있다는 가정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/08_choice.html#lv2"
   },

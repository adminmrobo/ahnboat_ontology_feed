     "@id": "lab:concept/price-ceiling-monopoly"
    }
   ]
  },
  {
   "@id": "lab:concept/price-ceiling-monopoly",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "독점과 가격상한",
     "@language": "ko"
    },
    {
     "@value": "price ceiling under monopoly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격상한이 독점의 한계수입을 바꿔 공급을 늘리거나 줄이는 효과.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv2"
   },
   "lab:prerequisiteOf": [

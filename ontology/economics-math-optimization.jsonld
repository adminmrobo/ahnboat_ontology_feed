    }
   ]
  },
  {
   "@id": "lab:concept/shephard-lemma",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "셰퍼드 보조정리",
     "@language": "ko"
    },
    {
     "@value": "Shephard's lemma",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "비용함수의 요소가격 미분이 조건부 요소수요가 된다는 결과.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/05_cost_function.html#lv2"
   },
   "lab:prerequisiteOf": [

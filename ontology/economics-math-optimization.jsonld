  {
   "@id": "lab:concept/right-hand-rule",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "오른손 법칙",
     "@language": "ko"
    },
    {
     "@value": "Right-hand rule",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "네 손가락을 도는 쪽으로 감으면 엄지가 회전 화살표 방향.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/3_arrow_field.html#s4"

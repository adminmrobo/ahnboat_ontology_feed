  {
   "@id": "lab:term/stagflation",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "스태그플레이션",
     "@language": "ko"
    },
    {
     "@value": "stagflation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "물가 상승과 경기 침체(실업 증가)가 함께 나타나는 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/basic_economic_lab/10_macro_economy.html#lv3"
   },
   "lab:partOf": [

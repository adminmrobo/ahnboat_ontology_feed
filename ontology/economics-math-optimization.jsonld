  {
   "@id": "lab:term/pareto-improvement",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "파레토 개선",
     "@language": "ko"
    },
    {
     "@value": "Pareto improvement",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "누구도 나빠지지 않고 적어도 한 명이 나아지는 변화.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/22_welfare.html#lv1"
   },
   "lab:partOf": [

   ],
   "skos:prefLabel": [
    {
     "@value": "등이윤선",
     "@language": "ko"
    },
    {
     "@value": "isoprofit line (supporting line)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이윤이 같은 (노동, 산출) 조합을 이은 직선 q = (π + wL)/p. 최대 이윤 수준의 등이윤선은 생산집합에 바깥에서 맞닿는 지지직선이 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

  {
   "@id": "lab:concept/gradient-theorem",
   "@type": [
    "skos:Concept",
    "lab:Identity"
   ],
   "skos:prefLabel": [
    {
     "@value": "기울기 정리",
     "@language": "ko"
    },
    {
     "@value": "gradient theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "그래디언트를 길 따라 더한 값은 양 끝 높이 차와 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/vector_calculus_lab/02_integral.html#room-7"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/divergence-theorem"
    }
   ]
  },
  {
   "@id": "lab:concept/divergence-theorem",
   "@type": [
    "skos:Concept",
    "lab:Identity"
   ],
   "skos:prefLabel": [
    {
     "@value": "발산 정리",
     "@language": "ko"
    },
    {
     "@value": "divergence theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "영역 안 발산의 합은 겉면으로 빠져나가는 양의 합과 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/vector_calculus_lab/02_integral.html#room-8"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/stokes-theorem"
    }
   ]
  },
  {
   "@id": "lab:concept/stokes-theorem",
   "@type": [
    "skos:Concept",
    "lab:Identity"
   ],
   "skos:prefLabel": [
    {
     "@value": "스토크스 정리",
     "@language": "ko"
    },
    {
     "@value": "stokes theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "면 위 회전의 합은 그 면 테두리를 한 바퀴 도는 흐름의 합과 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/vector_calculus_lab/02_integral.html#room-9"
   }
  },

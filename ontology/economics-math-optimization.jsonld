     "@id": "lab:concept/instrumental-variables"
    }
   ]
  },
  {
   "@id": "lab:term/weak-instrument",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "약한 도구",
     "@language": "ko"
    },
    {
     "@value": "weak instrument",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "설명변수와의 관련성이 약한 도구. 1단계 F가 작음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/12_econometrics.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/instrumental-variables"
    }
   ]
  },
  {
   "@id": "lab:concept/firm-supply",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기업 공급곡선",
     "@language": "ko"
    },
    {
     "@value": "firm supply curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격별 이윤극대화 산출. P ≥ min AVC 구간의 MC 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/market-equilibrium"
    }
   ]
  },
  {
   "@id": "lab:concept/long-run-equilibrium",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "장기 경쟁균형",
     "@language": "ko"
    },
    {
     "@value": "long-run competitive equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "진입·퇴출로 이윤이 0이 되어 P = min AC인 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv3"
   }
  },
  {
   "@id": "lab:term/avc",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균가변비용",
     "@language": "ko"
    },
    {
     "@value": "average variable cost",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가변비용 ÷ 산출.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/13_competitive_markets.html#lv1"
   },
   "lab:partOf": [

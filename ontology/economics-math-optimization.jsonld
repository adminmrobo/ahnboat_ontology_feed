    }
   ]
  },
  {
   "@id": "lab:method/momentum-sgd",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "모멘텀 SGD",
     "@language": "ko"
    },
    {
     "@value": "Momentum SGD",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "v ← βv + g, θ ← θ − η·v. 앞 걸음 속도의 β배를 이어 받아 완만한 길에서 가속한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_test_lab/index.html#p5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/momentum-adam"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/vanilla-sgd"
    }
   ]
  },
  {
   "@id": "lab:concept/ill-conditioned-valley",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "휘어진 골짜기 (방향마다 다른 가파름)",
     "@language": "ko"
    },
    {
     "@value": "Ill-conditioned curved valley",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 방향은 가파르고 다른 방향은 완만한 오차 지형. 바닐라 SGD가 느려지는 대표 상황.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_test_lab/index.html#p5"
   }
  },

  {
   "@id": "lab:concept/rate-of-change",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "변화율",
     "@language": "ko"
    },
    {
     "@value": "Rate of change",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "x가 변할 때 y가 변하는 빠르기. 평균 변화율 Δy/Δx의 간격을 한없이 줄인 끝이 미분 dy/dx.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_test_lab/index.html#p2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/tangent-slope"
    }
   ]
  },
  {
   "@id": "lab:concept/small-increment-approximation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "작은 증분 근사",
     "@language": "ko"
    },
    {
     "@value": "Small-increment approximation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조금 움직이면 Δy ≈ f′(x)·Δx. 움직임이 클수록 틀린 양이 빠르게 커진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_test_lab/index.html#p4"
   },
   "lab:prerequisiteOf": [

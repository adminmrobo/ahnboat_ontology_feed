     "@id": "lab:concept/compensating-variation"
    }
   ]
  },
  {
   "@id": "lab:concept/budget-set",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "예산집합",
     "@language": "ko"
    },
    {
     "@value": "budget set",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격과 소득으로 살 수 있는 묶음 전체.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/07_utility_maximization.html#lv1"

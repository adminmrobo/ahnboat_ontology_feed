   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "최적반응 (순수 \"위\")",
     "@language": "ko"
    },
    {
     "@value": "duel choice A 15",
     "@language": "en"
    }
   ],
   "skos:definition": {

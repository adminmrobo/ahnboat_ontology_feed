  {
   "@id": "lab:concept/minkowski-distance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "민코프스키 거리",
     "@language": "ko"
    },
    {
     "@value": "Minkowski distance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "p로 모양이 바뀌는 자. p = 1이면 맨해튼, 2면 유클리드, p를 키울수록 체비쇼프 8에 다가간다(p = 1.5·3·4·8: 11.501·8.724·8.324·8.023).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/Distance-metrics-tutorial/index.html#stage"
   },

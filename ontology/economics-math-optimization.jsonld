     "@id": "lab:concept/price-discrimination"
    }
   ]
  },
  {
   "@id": "lab:term/lerner-index",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "러너 지수",
     "@language": "ko"
    },
    {
     "@value": "Lerner index",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(P − MC)/P. 최적에서 1/|ε|.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/14_monopoly.html#lv1"
   },
   "lab:partOf": [

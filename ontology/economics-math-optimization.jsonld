    {
     "@id": "lab:metric/15-duel"
    }
   ]
  },
  {
   "@id": "lab:metric/15-duel",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "행의 기대보수",
     "@language": "ko"
    },
    {
     "@value": "duel metric 15",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "행의 기대보수",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/15_game_theory.html#duel"
   }
  },
  {
   "@id": "lab:term/strategy",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "전략",
     "@language": "ko"
    },
    {
     "@value": "strategy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "마주칠 수 있는 모든 상황에서 무엇을 할지 정한 완전한 계획.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/15_game_theory.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/best-response"
    }
   ]
  },
  {
   "@id": "lab:term/indifference-principle",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "무차별 원리",
     "@language": "ko"
    },
    {
     "@value": "indifference principle",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "혼합 균형에서 섞는 순수전략들의 기대보수는 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/15_game_theory.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/mixed-strategy"
    }
   ]
  },
  {
   "@id": "lab:term/backward-induction",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "역진귀납",
     "@language": "ko"
    },
    {
     "@value": "backward induction",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "마지막 결정부터 거꾸로 푸는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/15_game_theory.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/subgame-perfection"
    }
   ]
  },
  {
   "@id": "lab:concept/cournot",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "쿠르노 균형",
     "@language": "ko"
    },
    {
     "@value": "Cournot equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "수량을 동시에 고르는 기업들이 서로에게 최적반응인 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/16_oligopoly.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/stackelberg"
    }
   ]
  },
  {
   "@id": "lab:concept/stackelberg",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "슈타켈베르크 균형",
     "@language": "ko"
    },
    {
     "@value": "Stackelberg equilibrium",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선도기업이 후발기업의 반응을 예상해 먼저 수량을 정하는 균형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/16_oligopoly.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/repeated-game-collusion"
    }
   ]
  },
  {
   "@id": "lab:concept/repeated-game-collusion",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],

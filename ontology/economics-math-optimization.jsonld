    }
   ]
  },
  {
   "@id": "lab:concept/heat-equation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "열방정식",
     "@language": "ko"
    },
    {
     "@value": "Heat equation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "∂T/∂t = k∇²T. 이웃 평균보다 낮은 곳은 데워진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_3d_map/3_arrow_field.html#s5"
   },

   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "반반 무작위",
     "@language": "ko"
    },
    {
     "@value": "duel choice B 15",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "반반 무작위",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/15_game_theory.html#duel"
   },

     "@id": "lab:method/cost-minimization"
    }
   ]
  },
  {
   "@id": "lab:concept/conditional-factor-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "조건부 요소수요",
     "@language": "ko"
    },
    {
     "@value": "conditional factor demand",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정해진 산출을 최소비용으로 만드는 투입량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/02_producer_choice.html#lv2"
   },
   "lab:topic": [
    {

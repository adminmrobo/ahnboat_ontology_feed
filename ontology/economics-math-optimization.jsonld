     "@id": "lab:concept/number-standards"
    }
   ]
  },
  {
   "@id": "lab:concept/number-standards",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "숫자와 기준 (HTM·QTM, 보장·보통·최악)",
     "@language": "ko"
    },
    {
     "@value": "metrics and bounds summary",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "신의 수는 반 바퀴도 한 수로 세면 20, 4분의 1 바퀴만 세면 26이며, 보장(52·45·30)·보통(31·20~22·18)·최악(20)을 구별해야 숫자를 바르게 비교할 수 있다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai_cube_lab/15_final_review.html#lv2"
   }
  },

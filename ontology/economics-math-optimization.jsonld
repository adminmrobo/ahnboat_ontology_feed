     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:concept/slutsky-matrix",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "슬러츠키 행렬",
     "@language": "ko"
    },
    {
     "@value": "Slutsky matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "소득효과를 보정한 가격반응 행렬. 대칭·음의 준정부호.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv3"
   }
  },
  {
   "@id": "lab:term/subsistence",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "생계 소비",
     "@language": "ko"
    },
    {
     "@value": "subsistence quantity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "효용이 정의되기 위해 꼭 필요한 최소 소비량.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/stone-geary"
    }
   ]
  },
  {
   "@id": "lab:term/supernumerary-income",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "여유소득",
     "@language": "ko"
    },
    {
     "@value": "supernumerary income",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "생계 묶음 비용을 뺀 소득 R.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/stone-geary"
    }
   ]
  },
  {
   "@id": "lab:concept/engel-curve",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "엥겔 곡선",
     "@language": "ko"
    },
    {
     "@value": "Engel curve",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가격을 고정하고 소득에 따른 수요를 그린 곡선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:term/non-homothetic",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "비동조성",
     "@language": "ko"
    },
    {
     "@value": "non-homotheticity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "소득에 따라 지출 비중이 변하는 선호 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:concept/roy-identity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "로이 항등식",
     "@language": "ko"
    },
    {
     "@value": "Roy's identity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "x = −V_p/V_m.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/09_demand.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/income-elasticity"
    }
   ]
  },
  {
   "@id": "lab:term/nsd",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "음의 준정부호",
     "@language": "ko"
    },
    {
     "@value": "negative semidefinite",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 방향 z에 대해 zᵀSz ≤ 0인 행렬 성질.",
    "@language": "ko"

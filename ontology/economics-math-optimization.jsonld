   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "KKT",
     "@language": "ko"
    },
    {
     "@value": "Karush–Kuhn–Tucker conditions",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "부등식 제약이 있는 최적화의 필요조건. 경계해까지 한 번에 다룸.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/00_economic_models.html#lv3"
   },

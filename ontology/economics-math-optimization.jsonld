   "skos:definition": {
    "@value": "비경합성과 비배제성을 가져 한번 공급되면 모두가 소비 혜택을 누리는 재화·서비스.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/06_welfare_policy.html#lv3"
   },

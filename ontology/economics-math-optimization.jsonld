   ],
   "skos:prefLabel": [
    {
     "@value": "접선의 기울기",
     "@language": "ko"
    },
    {
     "@value": "Slope of the tangent",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "곡선의 한 점에 살짝 닿는 직선의 기울기. 그 점의 미분값이며 내리막 방향을 알려 준다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/optimization_test_lab/index.html#p1"

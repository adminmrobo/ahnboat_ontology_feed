  {
   "@id": "lab:concept/conditional-labor-demand",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "조건부 노동수요함수",
     "@language": "ko"
    },
    {
     "@value": "Conditional Labor Demand Function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "비용최소화 1계조건을 통해 자본 K를 소거하고 산출 Y와 상대가격 w/r로 구인수요를 도출하는 함수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_06_AI_effect_to_labor_demand/01_labor_demand_ai.html#lv2"
   },

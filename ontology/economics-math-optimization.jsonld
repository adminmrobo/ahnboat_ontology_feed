    }
   ]
  },
  {
   "@id": "lab:term/normative",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "규범",
     "@language": "ko"
    },
    {
     "@value": "normative analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "바람직한가에 대한 가치판단.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/01_what_is_labor_econ.html#lv3"
   },
   "lab:partOf": [

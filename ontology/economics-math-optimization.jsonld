     "@value": "화살표 밭(벡터장)",
     "@language": "ko"
    },
    {
     "@value": "Vector field",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공간의 점마다 화살표 하나가 붙은 것. 바람, 물 흐름.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ]
  },
  {
   "@id": "lab:term/positive",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "실증",
     "@language": "ko"
    },
    {
     "@value": "positive analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자료로 확인할 수 있는 사실에 대한 분석.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/labor_economics/01_what_is_labor_econ.html#lv3"

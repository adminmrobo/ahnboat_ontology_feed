   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "완비시장",
     "@language": "ko"
    },
    {
     "@value": "complete market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 상태별 지급을 거래 자산으로 복제할 수 있는 시장.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/micro_economics/v2/20_asset_markets.html#lv1"
   },
   "lab:partOf": [

     "@value": "Lagrange multiplier",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "제약을 1 늘릴 때 최적값의 변화. 비용최소화에서는 한계비용.",
    "@language": "ko"
   },

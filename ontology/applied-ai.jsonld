   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "2027년 여름 수요 — 한 점이 아니라 세 갈래",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "세 시나리오의 차이가 곧 위험의 크기입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w06/index.html#sec-6-10"
   },

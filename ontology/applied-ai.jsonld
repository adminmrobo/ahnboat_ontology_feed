    }
   ],
   "lab:derivedFrom": [
    {
     "@id": "lab:distribution/t"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/standard-error"
    }
   ]
  },
  {
   "@id": "lab:concept/degrees-of-freedom",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자유도",
     "@language": "ko"
    },
    {
     "@value": "degrees of freedom",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "표본표준편차를 계산할 때 평균을 이미 썼으므로 자유롭게 움직이는 값이 하나 줄어 n−1이 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv3a"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:distribution/t"
    }
   ]
  },
  {
   "@id": "lab:assumption/normality",
   "@type": [
    "skos:Concept",
    "lab:Assumption"
   ],
   "skos:prefLabel": [
    {
     "@value": "정규성 가정",
     "@language": "ko"
    },
    {
     "@value": "normality assumption",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모집단이 정규분포를 따른다는 가정. 작은 표본의 t 구간은 이 가정에 기댄다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv3a"
   },
   "lab:relatedTo": [
    {
     "@id": "lab:distribution/t"
    }
   ]
  },
  {
   "@id": "lab:concept/ci-misreading",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "신뢰구간의 흔한 오독",
     "@language": "ko"
    },
    {
     "@value": "common CI misinterpretation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "‘이 구간에 모수가 있을 확률 95%’는 틀린 해석이다. 같은 방법을 반복할 때 약 95%가 모수를 포함한다는 뜻이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv3a"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/ci-interpretation"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/t-interval"
    }
   ]
  },
  {
   "@id": "lab:concept/multiple-comparisons",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "다중 비교",
     "@language": "ko"
    },
    {
     "@value": "multiple comparisons",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 자료에 검정을 여러 번 하면 거짓 양성이 쌓여, 한 번용으로 설계한 유의수준이 지켜지지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv4a"
   },

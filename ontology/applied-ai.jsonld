     "@value": "accounts payable and credit terms",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "외상 매입으로 생긴 지급 의무(부채). 결제조건 2/10, n/30은 10일 안에 갚으면 2% 할인, 아니면 30일 안에 전액 지급을 뜻한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

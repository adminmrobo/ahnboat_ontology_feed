     "@value": "정률법 감가상각",
     "@language": "ko"
    },
    {
     "@value": "declining-balance depreciation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매년 기초 장부가액 × 상각률을 비용으로 옮기는 방법. 초기 비용이 크고 해마다 줄어든다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

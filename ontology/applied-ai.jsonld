    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-10",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "원인과 구간 연결하기 — 「함께 나타남」까지만",
     "@language": "ko"
    }

    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "계절지수와 프로모션 — 여름 모양이 셋 다 다르다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "월 계절지수로 보면 냉면은 7월 2.02, 콩국수는 7월 3.07, 비빔면은 6월 1.50이 최대입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

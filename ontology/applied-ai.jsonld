  },
  {
   "@id": "lab:method/self-supervised-plm",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "자기지도 단백질 언어모델",
     "@language": "ko"
    },
    {
     "@value": "self-supervised protein language model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "서열의 일부를 가리고 복원하는 과제로 라벨 없이 학습해, 있을 수 있는 서열의 분포를 배우는 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

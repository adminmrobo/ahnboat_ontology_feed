   ],
   "skos:prefLabel": [
    {
     "@value": "자산화와 정액법 감가상각",
     "@language": "ko"
    },
    {
     "@value": "capitalization and straight-line depreciation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1년 넘게 쓰는 물건은 자산으로 적고, (취득원가 − 잔존가치) ÷ 내용연수만큼 매년 같은 금액을 비용으로 옮긴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

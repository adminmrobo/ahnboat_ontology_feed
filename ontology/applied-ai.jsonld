    }
   ]
  },
  {
   "@id": "lab:concept/sm-w06-06",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "5주 다시 보기 — 작업지시서",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "작업지시서는 점검표(결과) + 회의록(결정) + 매뉴얼(방법)을 한 장에 모은 카드입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

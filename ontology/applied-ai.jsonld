   "skos:prefLabel": [
    {
     "@value": "평균과 흔들림이 변하는가 — 정상성",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "정상 시계열은 평균과 흔들림의 크기가 시간에 따라 변하지 않습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

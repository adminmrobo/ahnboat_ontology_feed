    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-02",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "원인 라벨 다섯 가지 — machine_failure 뒤에 숨은 것",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "라벨은 모두 0 또는 1입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w07/index.html#sec-7-2"

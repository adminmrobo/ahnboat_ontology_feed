   ]
  },
  {
   "@id": "lab:term/carrying-amount",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "장부가액",
     "@language": "ko"
    },
    {
     "@value": "carrying amount",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "취득원가에서 감가상각누계액을 뺀 금액.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

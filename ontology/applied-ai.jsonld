   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "의미 변화만 쓰는 점수",
     "@language": "ko"
    },
    {
     "@value": "semantic-change-only score",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "서열 표현의 변화량만으로 면역 회피를 짚으려는 접근.",

     "@id": "lab:concept/sm-w07-05"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-05",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "파레토 — 많은 것부터 줄을 세운다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "차트는 막대(건수)와 선(누적 비율) 두 겹입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w07/index.html#sec-7-5"
   },
   "lab:prerequisiteOf": [

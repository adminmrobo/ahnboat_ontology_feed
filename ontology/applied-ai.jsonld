     "@id": "lab:concept/sm-w06-03"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w06-03",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "2주 다시 보기 — 생성형 AI의 원리와 프롬프트",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "AI는 글을 토큰과 숫자 ID로 바꾸고, 임베딩으로 의미 좌표를 주고, 어텐션으로 중요한 말에 집중해, 다음 토큰을 확률로 골라 문장을 만듭니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w06/index.html#sec-6-3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/sm-w06-04"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w06-04",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "3주 다시 보기 — 시계열",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "시계열은 순서가 정보입니다(자기상관).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

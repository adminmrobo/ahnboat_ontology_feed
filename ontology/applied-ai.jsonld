    }
   ]
  },
  {
   "@id": "lab:concept/sm-w06-11",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "라인 능력과 교대 — 가동률 85%와 95%",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "보통 시나리오는 냉면·콩국수 3교대(83.1%, 82.6%), 비빔면 2교대(84.9%)로 목표 85% 안에 들어옵니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w06/index.html#sec-6-11"

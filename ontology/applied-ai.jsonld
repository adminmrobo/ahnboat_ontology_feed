   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "감시 자료 편향",
     "@language": "ko"
    },
    {
     "@value": "surveillance data bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "서열 제출량이 지역·시기마다 달라, 자료가 적은 곳의 변화는 늦게 보인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv5a"
   }
  },

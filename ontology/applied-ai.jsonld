     "@value": "기준선부터 이겨라 — 나이브·지수평활·채점",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "가장 단순한 두 기준선은 나이브(다음 달 = 이번 달)와 계절 나이브(다음 달 = 작년 같은 달)입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

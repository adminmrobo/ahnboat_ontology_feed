     "@value": "pre-pandemic held-out validation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "특정 시점 이후의 정보를 차단한 상태로 모델을 돌려, 그 이후 실제로 나타난 결과를 얼마나 앞서 지목하는지 채점하는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv5a"
   }
  },

    },
    {
     "@value": "type I error",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차이가 없는데 있다고 판정하는 잘못. 확률은 유의수준 α로 통제한다.",
    "@language": "ko"
   },

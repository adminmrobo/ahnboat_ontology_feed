   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "트랜스포머 — 읽는 쪽과 쓰는 쪽",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "교안이 꼽는 네 가지 열쇠는 ① 인코더 ② 디코더 ③ 병렬 처리(한 단어씩 순서대로 읽던 방식에서 벗어남) ④ 장기 의존성(멀리 떨어진 단어를 연결)입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

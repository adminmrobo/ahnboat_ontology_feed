   ],
   "skos:prefLabel": [
    {
     "@value": "1주 다시 보기 — 스마트공장과 검수",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "스마트공장은 데이터로 보고·판단·제어하는 공장이고, 수준은 미적용·기초·중간1·중간2·고도화입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w06/index.html#sec-6-2"
   },

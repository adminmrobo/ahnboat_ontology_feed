    {
     "@value": "recall at top k%",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "점수 상위 몇 퍼센트 안에 실제 대상이 몇 개 들어왔는지의 비율. 무작위로 고르면 그 비율 자체가 기준선이 된다.",
    "@language": "ko"
   },

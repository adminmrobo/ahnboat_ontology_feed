  {
   "@id": "lab:concept/accounts-receivable-flow",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "매출과 매출채권의 연결",
     "@language": "ko"
    },
    {
     "@value": "revenue–receivable link",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "외상·카드 매출이 생기면 매출채권이 늘고, 회수하면 매출채권이 현금으로 바뀐다. 회수는 매출을 다시 만들지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/02_revenue_inventory.html#lv1"
   },

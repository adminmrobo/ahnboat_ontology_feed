    }
   ]
  },
  {
   "@id": "lab:concept/allowance-for-doubtful-accounts",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대손충당금",
     "@language": "ko"
    },
    {
     "@value": "allowance for doubtful accounts",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출채권 중 회수하지 못할 것으로 예상되는 금액을 미리 추정해 채권에서 차감하는 계정. 매출채권 총액 − 대손충당금 = 순장부금액.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/02_revenue_inventory.html#lv2"
   },

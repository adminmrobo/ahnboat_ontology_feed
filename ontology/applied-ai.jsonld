   ],
   "skos:prefLabel": [
    {
     "@value": "빈도·집계·달력·빠진 시점",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "MES에서 내려받은 데이터를 월별로 묶을 때 합계와 평균을 틀리면, 가동률이 300%로 찍히거나 생산량이 하루치로 줄어드는 사고가 납니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

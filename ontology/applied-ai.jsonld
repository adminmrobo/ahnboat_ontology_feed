  {
   "@id": "lab:concept/pseudonymization",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "가명처리·익명화",
     "@language": "ko"
    },
    {
     "@value": "pseudonymization and anonymization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "식별자 제거, 일반화, 마스킹, 해시·토큰화 등으로 개인을 알아볼 수 없게 처리하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_science_for_business/week02_data_collection.html#lv5"

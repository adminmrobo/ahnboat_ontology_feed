   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "순서가 정보다 — 84개를 섞으면",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "평균·합계·최댓값처럼 순서를 모르는 요약 통계는 섞어도 같습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

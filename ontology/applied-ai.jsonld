   ],
   "skos:prefLabel": [
    {
     "@value": "어텐션 — 중요한 단어에 더 집중한다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "어텐션 덕분에 AI는 긴 문장에서도 길을 잃지 않습니다.",

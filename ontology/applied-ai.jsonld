   ],
   "skos:definition": {
    "@value": "목록은 값을 순서대로 담아 번호(0부터)로 꺼내는 자료구조, 사전은 이름표(키)와 값을 짝지어 이름으로 꺼내는 자료구조.",
    "@language": "ko"
   },

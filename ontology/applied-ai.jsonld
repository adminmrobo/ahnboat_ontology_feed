   ]
  },
  {
   "@id": "lab:method/t-interval",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "t 분포 신뢰구간",
     "@language": "ko"
    },
    {
     "@value": "t confidence interval",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모분산을 모르고 표본이 작을 때, 표본표준편차와 t 분포 기준값으로 모평균의 구간을 만드는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/health_stats_lab/01_clinical_stats_ai.html#lv3a"
   },

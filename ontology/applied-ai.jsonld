     "@id": "lab:concept/sm-w07-06"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-06",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "파레토의 네 가지 모양과 세 가지 함정",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "차트의 모양이 다음 행동을 고릅니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w07/index.html#sec-7-6"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/sm-w07-07"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-07",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "층별 — 평균 안에 숨은 구간을 꺼낸다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "네 컬럼을 같은 방식으로 나누면 몰린 구간은 둘입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w07/index.html#sec-7-7"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/sm-w07-08"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-08",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "구간을 얼마나 잘게 — 너무 잘면 우연이 패턴이 된다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "100행을 4구간으로 나누면 구간당 25행입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

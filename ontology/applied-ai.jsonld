    }
   ]
  },
  {
   "@id": "lab:concept/sm-w02-07",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "LLM 학습 3단계 — 사전학습 → 다음 토큰 → 미세조정",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "사전학습은 지식 저장소를 만드는 일이라기보다, 언어 패턴에 대한 폭넓은 감각을 만드는 일입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

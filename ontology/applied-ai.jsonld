   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "카드 04 · 다른 공장, 같은 질문 — 불량 판정 데이터",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "같은 카드를 데이터만 바꿔 다시 씁니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w07/index.html#sec-7-9"
   },

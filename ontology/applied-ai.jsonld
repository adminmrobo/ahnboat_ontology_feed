    }
   ]
  },
  {
   "@id": "lab:concept/sm-w06-07",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "종합 사례 — 면류 3사의 데이터",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "면류 데이터는 2016-01-01부터 2026-10-03까지 일별 기록입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

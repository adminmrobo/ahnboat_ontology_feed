     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "훌륭한 프롬프트는 기계에 규칙을 주입하는 것이 아니라, 모델이 알맞은 패턴과 맥락을 꺼내도록 환경을 설계하는 일입니다.",
    "@language": "ko"

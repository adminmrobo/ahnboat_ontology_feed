   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "오늘은 어제를 닮는다 — 자기상관",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "독립이 아니라는 것은 정보가 겹친다는 뜻입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w03/index.html#sec-3-4"

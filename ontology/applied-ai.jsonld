   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "검정력",
     "@language": "ko"
    },
    {
     "@value": "statistical power",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "참 효과가 있을 때 그것을 유의하다고 판정할 확률.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

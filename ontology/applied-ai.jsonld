    }
   ]
  },
  {
   "@id": "lab:standard/pipa-2020",
   "@type": [
    "skos:Concept",
    "lab:Standard"
   ],
   "skos:prefLabel": [
    {
     "@value": "개인정보보호법(2020 개정, 가명정보)",
     "@language": "ko"
    },
    {
     "@value": "Personal Information Protection Act (2020 amendment)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "추가 정보 없이는 특정 개인을 알아볼 수 없게 처리한 정보. 교안 기준 2020년 개정 개인정보보호법으로 통계·연구·공익적 기록보존 목적의 활용 근거가 생겼다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_science_for_business/week02_data_collection.html#lv5"
   }
  },
  {
   "@id": "lab:standard/gdpr",
   "@type": [
    "skos:Concept",
    "lab:Standard"
   ],
   "skos:prefLabel": [
    {
     "@value": "GDPR",
     "@language": "ko"
    },
    {
     "@value": "General Data Protection Regulation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "유럽연합의 일반 데이터 보호 규정. 정보주체 권리 강화와 기업 책임을 규정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_science_for_business/week02_data_collection.html#lv5"
   }
  },
  {
   "@id": "lab:standard/ccpa",
   "@type": [
    "skos:Concept",
    "lab:Standard"
   ],
   "skos:prefLabel": [
    {
     "@value": "CCPA",
     "@language": "ko"
    },
    {
     "@value": "California Consumer Privacy Act",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "미국 캘리포니아주 소비자 프라이버시법. 판매 거부권·삭제권·알 권리를 규정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_science_for_business/week02_data_collection.html#lv5"
   }
  },

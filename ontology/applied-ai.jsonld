  },
  {
   "@id": "lab:concept/sm-w06-08",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "검색이 오르면 판매가 오른다? — 상관과 선행 신호",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "3주에서 순환은 맞히지 말고 선행 신호로 가늠한다고 했습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

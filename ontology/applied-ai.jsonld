   ],
   "skos:prefLabel": [
    {
     "@value": "이동평균·분해·계절조정 — \"지난달보다 늘었다\"를 공정하게",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "12개월 이동평균을 그리면 톱니는 크지만 추세선은 거의 평평합니다.",
    "@language": "ko"
   },

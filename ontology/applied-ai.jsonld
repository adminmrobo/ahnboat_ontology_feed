   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "원인이 겹치는 행 — 합이 안 맞는 이유",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "UID 042는 열도 빠지지 않았고(hdf), 닳은 공구에 큰 힘도 걸렸습니다(osf).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

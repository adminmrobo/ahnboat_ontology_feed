    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "생산실적은 수요가 아니다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "생산실적은 설비·가동일수·원료에 묶여 있습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w03/index.html#sec-3-1"

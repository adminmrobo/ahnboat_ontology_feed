     "@id": "lab:concept/sm-w07-04"
    }
   ]
  },
  {
   "@id": "lab:concept/sm-w07-04",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "카드 01 · 세는 일부터 AI에게 — 그리고 다시 세기",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "숫자를 먼저 확정해야 그 위의 차트가 흔들리지 않습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

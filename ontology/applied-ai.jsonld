    }
   ]
  },
  {
   "@id": "lab:concept/sm-w06-05",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "4주 다시 보기 — 분류와 회귀",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "라벨은 분류, 숫자는 회귀입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w06/index.html#sec-6-5"
   },

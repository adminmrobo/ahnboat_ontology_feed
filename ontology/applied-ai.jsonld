   ],
   "skos:prefLabel": [
    {
     "@value": "무작위 분할의 함정 — 미래를 보고 과거 맞히기",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "AI에게 \"이 가격 데이터로 예측 모델을 만들고 정확도를 알려 줘\"라고 하면 무작위 분할을 쓰는지 확인합니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "불량 건수와 불량률 — 다른 질문에 답한다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "불량 건수는 「몇 개가 나빴나」, 불량률은 「전체 중 몇 %가 나빴나」에 답합니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

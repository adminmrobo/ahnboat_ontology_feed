   ],
   "skos:prefLabel": [
    {
     "@value": "제2종 오류",
     "@language": "ko"
    },
    {
     "@value": "type II error",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차이가 있는데 없다고 판정하는 잘못. 1에서 검정력을 뺀 값이다.",
    "@language": "ko"

   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "Bot · RPA · AI는 어떻게 다른가",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "15주차 자동화 흐름은 셋을 섞습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/smart_product/weeks/w02/index.html#sec-2-8"
   },

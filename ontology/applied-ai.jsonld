   ],
   "skos:prefLabel": [
    {
     "@value": "조합 폭발",
     "@language": "ko"
    },
    {
     "@value": "combinatorial explosion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자리 수와 동시 변이 수가 늘면 가능한 조합이 기하급수로 늘어 전수 실험이 불가능해진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차이가 없다는 기본 가정. 검정은 이것을 버릴 증거가 있는지 묻는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

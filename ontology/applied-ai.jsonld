  {
   "@id": "lab:concept/sm-w02-06",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "다음 토큰을 하나씩 고른다",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "생성은 한 번에 완성된 판단이 아니라 연속된 확률 계산의 누적입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

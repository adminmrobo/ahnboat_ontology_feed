   ]
  },
  {
   "@id": "lab:metric/receivables-turnover",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "매출채권 회전율",
     "@language": "ko"
    },
    {
     "@value": "receivables turnover",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출액 ÷ 매출채권. 매출채권이 1년에 몇 번 현금으로 회전하는지를 나타낸다. 52주 ÷ 회전율 = 평균 회수기간(주).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:metric/inventory-turnover"
    }
   ]
  },
  {
   "@id": "lab:metric/inventory-turnover",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "재고자산 회전율",
     "@language": "ko"
    },
    {
     "@value": "inventory turnover",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출원가 ÷ 재고자산. 재고가 1년에 몇 번 팔려 나가는지를 나타낸다. 52주 ÷ 회전율 = 평균 회전기간(주).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/timing-differences"
    }
   ]
  },
  {
   "@id": "lab:concept/timing-differences",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "비용과 현금의 시점 차이",
     "@language": "ko"
    },
    {
     "@value": "timing differences between expense and cash",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "비용은 발생한 기간에 인식하지만 현금 지급은 앞서거나(선급) 늦을(미지급) 수 있다. 감가상각비는 비용이지만 현금 유출이 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv3"
   }
  },
  {
   "@id": "lab:metric/average-collection-period",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균 회수기간",
     "@language": "ko"
    },
    {
     "@value": "average collection period",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "52주(또는 365일) ÷ 매출채권 회전율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:metric/receivables-turnover"
    }
   ]
  },
  {
   "@id": "lab:term/merchandising-company",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "상기업",
     "@language": "ko"
    },
    {
     "@value": "merchandising company",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "물건을 만들지 않고 사서 파는 회사. 재고는 상품.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:metric/inventory-turnover"
    }
   ]
  },
  {
   "@id": "lab:metric/payables-turnover",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "매입채무 회전율",
     "@language": "ko"
    },
    {
     "@value": "payables turnover",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매입액 ÷ 매입채무. 낮을수록 외상 대금을 오래 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:metric/inventory-turnover"
    }
   ]
  },
  {
   "@id": "lab:term/deferral",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "이연항목",
     "@language": "ko"
    },
    {
     "@value": "deferral",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "미리 받거나 낸 돈처럼 다음 기간으로 넘기는 항목.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/timing-differences"
    }
   ]
  },
  {
   "@id": "lab:concept/income-tax-payable",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "미지급법인세",
     "@language": "ko"
    },
    {
     "@value": "income tax payable",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "올해 비용으로 인식했지만 아직 내지 않은 법인세. 부채.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/timing-differences"
    }
   ]
  },
  {
   "@id": "lab:concept/retained-earnings",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이익잉여금",
     "@language": "ko"
    },
    {
     "@value": "retained earnings",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "그동안 번 순이익 중 배당하지 않고 쌓아 둔 금액. 자본.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/09_turnover_review.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/retained-earnings"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/timing-differences"
    }
   ]
  },
  {
   "@id": "lab:concept/cash-flow-direct-method",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "현금흐름표의 구조와 직접법",
     "@language": "ko"
    },
    {
     "@value": "cash flow statement and direct method",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "현금의 변동을 영업·투자·재무 활동으로 나눠 보고하는 표. 직접법은 매출로부터의 현금수입, 매입·영업비용에 대한 현금지출을 항목별로 직접 계산한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/cash-flow-indirect-method"
    }
   ]
  },
  {
   "@id": "lab:method/cash-flow-indirect-method",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "간접법",
     "@language": "ko"
    },
    {
     "@value": "indirect method",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "당기순이익에서 출발해 현금 유출이 없는 비용(감가상각비)을 더하고, 영업과 무관한 손익을 제거하고, 영업 관련 자산·부채의 변동을 조정해 영업활동 현금흐름을 구하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/financial-ratio-analysis"
    }
   ]
  },
  {
   "@id": "lab:concept/financial-ratio-analysis",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "재무비율 분석",
     "@language": "ko"
    },
    {
     "@value": "financial ratio analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "재무상태표와 손익계산서의 항목을 서로 나눈 비율로 유동성(단기 지급능력), 안정성(타인자본 의존도), 수익성(이익률), 활동성(자산 회전)을 진단하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv3"
   }
  },
  {
   "@id": "lab:metric/quick-ratio",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "당좌비율",
     "@language": "ko"
    },
    {
     "@value": "quick ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(유동자산 − 재고자산) ÷ 유동부채 × 100%.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/financial-ratio-analysis"
    }
   ]
  },
  {
   "@id": "lab:metric/debt-to-equity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "부채비율",
     "@language": "ko"
    },
    {
     "@value": "debt-to-equity ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "타인자본 ÷ 자기자본 × 100%. 낮을수록 재무구조가 안정적.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/financial-ratio-analysis"
    }
   ]
  },
  {
   "@id": "lab:metric/interest-coverage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이자보상비율",
     "@language": "ko"
    },
    {
     "@value": "interest coverage ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "영업이익 ÷ 이자비용. 1배보다 커야 이자를 정상 지급.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/financial-ratio-analysis"
    }
   ]
  },
  {
   "@id": "lab:metric/total-asset-turnover",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "총자산회전율",
     "@language": "ko"
    },
    {
     "@value": "total asset turnover",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출액 ÷ 총자산. 자산이 1년에 몇 번 회전했는가.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/10_cashflow_ratios.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/financial-ratio-analysis"
    }
   ]
  },
  {
   "@id": "lab:concept/limits-of-financial-statements",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "재무제표와 비율분석의 한계",
     "@language": "ko"
    },
    {
     "@value": "limits of financial statements and ratio analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "재무제표는 과거의 요약이자 추정이며 회계정책·결산 시점·일회성 항목에 따라 달라진다. 비율은 비교 기준과 정의를 맞춰야 뜻을 가진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/cvp-analysis"
    }
   ]
  },
  {
   "@id": "lab:method/cvp-analysis",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "원가·조업도·이익(CVP) 분석",
     "@language": "ko"
    },
    {
     "@value": "cost-volume-profit analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "원가를 변동비와 고정비로 나눠 공헌이익(매출 − 변동비)을 구하고, 손익분기 매출 = 고정비 ÷ 공헌이익률, 안전한계율 = (매출 − 손익분기 매출) ÷ 매출을 계산하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/operating-leverage"
    }
   ]
  },
  {
   "@id": "lab:concept/operating-leverage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "영업레버리지와 투자 의사결정",
     "@language": "ko"
    },
    {
     "@value": "operating leverage and investment decision",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "영업레버리지도(DOL) = 공헌이익 ÷ 영업이익. 고정비 비중이 클수록 매출 변화율이 영업이익 변화율로 크게 증폭된다. 투자는 회수기간과 순현재가치(NPV)로 평가한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/break-even"
    }
   ]
  },
  {
   "@id": "lab:term/window-dressing",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "윈도 드레싱",
     "@language": "ko"
    },
    {
     "@value": "window dressing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "결산일 직전의 거래로 재무비율을 실제보다 좋아 보이게 꾸미는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/limits-of-financial-statements"
    }
   ]
  },
  {
   "@id": "lab:method/dupont-analysis",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "DuPont 분해",
     "@language": "ko"
    },
    {
     "@value": "DuPont analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "ROE를 마진 × 회전 × 레버리지 세 조각으로 나누는 분석.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/limits-of-financial-statements"
    }
   ]
  },
  {
   "@id": "lab:metric/roe",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자기자본이익률",
     "@language": "ko"
    },
    {
     "@value": "return on equity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순이익 ÷ 자기자본. 주주의 돈으로 얼마를 벌었나.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/limits-of-financial-statements"
    }
   ]
  },
  {
   "@id": "lab:concept/managerial-accounting",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "관리회계",
     "@language": "ko"
    },
    {
     "@value": "managerial accounting",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "경영자의 계획·통제·의사결정을 위해 회사 안에서 쓰는 회계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/cvp-analysis"
    }
   ]
  },
  {
   "@id": "lab:concept/cost-behavior",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "원가행태",
     "@language": "ko"
    },
    {
     "@value": "cost behavior",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조업도(매출·생산량)가 변할 때 원가가 움직이는 모양. 변동비·고정비·혼합원가.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/cvp-analysis"
    }
   ]
  },
  {
   "@id": "lab:method/high-low-method",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "고저점법",
     "@language": "ko"
    },
    {
     "@value": "high-low method",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최고 조업도와 최저 조업도의 두 점으로 혼합원가를 변동비와 고정비로 나누는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/python-accounting-analytics/11_managerial_accounting.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/cvp-analysis"
    }
   ]
  },
  {
   "@id": "lab:concept/contribution-margin",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "공헌이익",
     "@language": "ko"
    },
    {
     "@value": "contribution margin",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출 − 변동비. 고정비를 덮고 이익을 만드는 데 공헌하는 몫.",
    "@language": "ko"
   },

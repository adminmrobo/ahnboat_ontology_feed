    }
   ]
  },
  {
   "@id": "lab:concept/sm-w03-02",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "두 종류의 데이터 — 횡단면과 시계열",
     "@language": "ko"
    }
   ],
   "skos:definition": {
    "@value": "한 시점에 여러 대상을 재면 횡단면 데이터, 한 대상을 여러 시점에 재면 시계열입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

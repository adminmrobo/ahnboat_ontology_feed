    }
   ]
  },
  {
   "@id": "lab:method/domain-adaptation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "도메인 특화와 점진적 미세조정",
     "@language": "ko"
    },
    {
     "@value": "domain-specific models and progressive fine-tuning",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "의료·법률·금융 등 전문 데이터로 LLM을 특화하는 방법. 도메인 적응(대량 도메인 텍스트) → 태스크별 미세조정 → 품질 평가·지속 개선의 단계적 전략.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

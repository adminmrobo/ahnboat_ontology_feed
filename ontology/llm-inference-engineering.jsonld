    }
   ]
  },
  {
   "@id": "lab:method/standard-attention",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "표준 어텐션",
     "@language": "ko"
    },
    {
     "@value": "standard attention",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "S=QKᵀ, P=softmax(S)를 창고 메모리에 쓰고 다시 읽어 O=PV를 계산하는 구현(알고리즘 0).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_03_article_01/03_flash_attention.html#q"

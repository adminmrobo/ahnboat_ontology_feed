   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대화 중에 적기",
     "@language": "ko"
    },
    {
     "@value": "hot-path memory formation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대화가 진행되는 동안 바로 기억을 저장하는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

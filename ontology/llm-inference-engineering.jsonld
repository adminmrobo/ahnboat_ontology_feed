  {
   "@id": "lab:term/negative-sampling",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "네거티브 샘플링",
     "@language": "ko"
    },
    {
     "@value": "negative sampling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정답 단어와 무작위 부정 샘플 몇 개만 구분하게 해 Word2Vec 학습을 빠르게 하는 기법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-1_word2vec_overview.html#lv2"
   },

  {
   "@id": "lab:concept/best-of-n-selection",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "여러 버전 중 최고만 남기기",
     "@language": "ko"
    },
    {
     "@value": "best-of-N variant selection",
     "@language": "en"
    }
   ],

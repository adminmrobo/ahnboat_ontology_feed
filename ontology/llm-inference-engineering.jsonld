   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "임베딩층",
     "@language": "ko"
    },
    {
     "@value": "embedding layer",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰을 받아 임베딩을 돌려주는 입력층.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

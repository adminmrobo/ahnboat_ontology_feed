   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "반복 노이즈 제거",
     "@language": "ko"
    },
    {
     "@value": "iterative denoising",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무작위 노이즈에서 출발해 확산으로 결과를 다듬는 생성 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_02_textbook_ch02_p1_p2/02_models.html#big"
   }
  },
  {
   "@id": "lab:method/plan-batch-activation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "배치 기준 활성 계획",
     "@language": "ko"
    },
    {
     "@value": "plan by batched activation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "배치 서버에서는 거의 모든 전문가가 켜진다고 보고 메모리·계산을 계획한다 (초파리 연구원의 선택).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_02_textbook_ch02_p1_p2/02_models.html#duel"

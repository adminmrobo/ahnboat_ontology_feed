   ]
  },
  {
   "@id": "lab:concept/background-write",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대화 뒤에 적기",
     "@language": "ko"
    },
    {
     "@value": "background memory formation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대화가 끝난 뒤 돌아보며 기억을 뽑아 저장하는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/3_2_when_to_write.html#lv1"
   }
  },
  {
   "@id": "lab:concept/write-latency",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "적느라 늘어나는 기다림",
     "@language": "ko"
    },
    {
     "@value": "write latency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기억을 고르고 저장하는 동안 답이 늦어지는 시간.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/3_2_when_to_write.html#lv1"
   }
  },
  {
   "@id": "lab:concept/profile-memory",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "프로필 (한 장에 고쳐 쓰기)",
     "@language": "ko"
    },
    {
     "@value": "profile memory",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "주제마다 한 칸을 두고 새 정보가 오면 그 칸을 고쳐 쓰는 기억.",
    "@language": "ko"

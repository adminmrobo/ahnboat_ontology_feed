   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "개선 대상 × 순환이 닫힌 정도",
     "@language": "ko"
    },
    {
     "@value": "Improvement target × loop closure",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무엇을 고치나(행동·가중치·평가자·연구 과정)와 사람이 순환 어디에 있나로 RSI 연구를 나누는 틀",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "config.json",
     "@language": "ko"
    },
    {
     "@value": "config.json",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Hugging Face 모델마다 있는, 아키텍처와 층 크기를 적은 수십 줄 파일.",
    "@language": "ko"
   },

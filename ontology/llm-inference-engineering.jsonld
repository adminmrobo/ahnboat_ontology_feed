    }
   ]
  },
  {
   "@id": "lab:method/recomputation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "다시 계산하기 (재계산)",
     "@language": "ko"
    },
    {
     "@value": "recomputation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순방향의 N×N 중간값을 보관하지 않고 역방향에서 다시 계산하는 기법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

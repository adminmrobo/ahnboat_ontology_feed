  {
   "@id": "lab:concept/echo",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "메아리 (과거의 흔적)",
     "@language": "ko"
    },
    {
     "@value": "echo of the past",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이 시리즈에서 자기상관을 부르는 별명. 과거의 값이 오늘 값에 남긴 흔적.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ]
  },
  {
   "@id": "lab:method/pos-tagging-frequency",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "품사 태깅과 빈도 분석",
     "@language": "ko"
    },
    {
     "@value": "part-of-speech tagging and frequency analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰에 문법적 역할(품사)을 붙이고, 전처리된 단어의 출현 횟수를 세어 핵심어를 찾는 분석.",
    "@language": "ko"

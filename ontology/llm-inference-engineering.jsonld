    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "줄지 않는 길",
     "@language": "ko"
    },
    {
     "@value": "constant error path",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "지우개가 1에 가까울 때 메모와 학습 신호가 줄지 않고 지나가는 경로.",

   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "한 번에 몰아 하기 (커널 융합)",
     "@language": "ko"
    },
    {
     "@value": "kernel fusion",
     "@language": "en"
    }
   ],
   "skos:definition": {

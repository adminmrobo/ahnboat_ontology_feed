     "@value": "오염",
     "@language": "ko"
    },
    {
     "@value": "benchmark contamination",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공개된 시험 문제가 모델의 학습 데이터에 섞여 점수가 부풀려지는 일.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

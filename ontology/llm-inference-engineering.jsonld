    }
   ]
  },
  {
   "@id": "lab:term/sparsity",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "희소성",
     "@language": "ko"
    },
    {
     "@value": "sparsity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가능한 단어 조합에 비해 데이터가 너무 적어 대부분의 조합을 한 번도 보지 못하는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/02-3_models_methods.html#lv3"
   },
   "lab:partOf": [

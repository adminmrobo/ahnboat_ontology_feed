     "@id": "lab:concept/time-series"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/short-memory"
    }
   ]
  },
  {
   "@id": "lab:concept/exploding-gradient",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "기울기 폭발",
     "@language": "ko"
    },
    {
     "@value": "Exploding gradient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "반대로 층을 지날수록 기울기가 커져 학습이 튕겨 나가는 현상.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_4_reading_state.html#lv2"
   }
  },
  {
   "@id": "lab:concept/cell-state",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "셀 상태",
     "@language": "ko"
    },
    {
     "@value": "Cell state",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "LSTM 안쪽에 따로 보관하는 기억 띠 c. 걸음마다 망각 문을 곱하고 새 후보를 더한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_5_eraser_notepad.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/lstm"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/forget-gate"
    }
   ]
  },
  {
   "@id": "lab:concept/forget-gate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "망각 문",
     "@language": "ko"
    },
    {
     "@value": "Forget gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "옛 셀 상태를 얼마나 남길지 정하는 0~1 값 f. 1에 가까우면 기억이 거의 그대로 넘어간다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_5_eraser_notepad.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/lstm"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/constant-error-path"
    }
   ]
  },
  {
   "@id": "lab:concept/input-gate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "입력 문",
     "@language": "ko"
    },
    {
     "@value": "Input gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 후보를 셀 상태에 얼마나 적을지 정하는 0~1 값 i.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_5_eraser_notepad.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/lstm"
    }
   ]
  },
  {
   "@id": "lab:concept/vanishing-gradient",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기울기 소실",
     "@language": "ko"
    },
    {
     "@value": "Vanishing gradient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "펼친 망에서 기울기가 거슬러 오는 동안 거듭 곱해져 작아지는 현상. 앞쪽 입력이 학습에 거의 반영되지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_4_reading_state.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/rnn"
    }
   ],
   "lab:contrastsWith": [

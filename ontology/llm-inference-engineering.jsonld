    {
     "@value": "에이전트",
     "@language": "ko"
    },
    {
     "@value": "agent",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스스로 다음 행동을 정하며 여러 단계의 일을 해 나가는 AI.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

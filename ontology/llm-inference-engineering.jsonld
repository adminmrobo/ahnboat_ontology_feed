    {
     "@value": "integrated development environment",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Integrated Development Environment, 통합 개발 환경. 코드 작성·실행·디버깅·버전 관리를 한곳에서 하는 프로그램.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/02-2_tools_environment.html#lv3"
   },

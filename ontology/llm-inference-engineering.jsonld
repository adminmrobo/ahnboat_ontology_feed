   ],
   "skos:prefLabel": [
    {
     "@value": "질문을 보고 만드는 기억",
     "@language": "ko"
    },
    {
     "@value": "query-conditioned memory",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "질문이 온 뒤에 그 질문에 맞게 꺼내어 줄이는 기억. 질문을 모르고 미리 줄이는 요약과 다르다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

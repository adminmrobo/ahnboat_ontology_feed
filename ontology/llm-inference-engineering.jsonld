     "@value": "발화 문턱",
     "@language": "ko"
    },
    {
     "@value": "neuron firing threshold",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "뉴런은 입력이 문턱을 넘어야 발화한다. ReLU의 꺾임과 닮았다(실제 뉴런은 스파이크를 낸다).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "전문가 병렬화",
     "@language": "ko"
    },
    {
     "@value": "expert parallelism",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "전문가를 여러 GPU에 나눠 싣는 추론 병렬화. 대규모 배치에서 희소성을 살린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_02_textbook_ch02_p1_p2/02_models.html#lv5"
   }
  },
  {
   "@id": "lab:concept/causal-lm",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "인과 언어 모델",
     "@language": "ko"
    },
    {
     "@value": "causal language model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞 토큰만 보고 다음 토큰을 예측하는 언어 모델. 오늘날 생성 LLM 전부.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_02_textbook_ch02_p1_p2/02_models.html#lv5"
   },
   "lab:broader": [

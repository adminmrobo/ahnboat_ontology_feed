   ],
   "skos:prefLabel": [
    {
     "@value": "가운데 놓침",
     "@language": "ko"
    },
    {
     "@value": "lost in the middle",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "긴 입력의 가운데에 놓인 정보가 앞·끝에 놓인 정보보다 덜 쓰이는 경향.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ]
  },
  {
   "@id": "lab:concept/nlp-disciplines",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자연어 처리의 학문적 바탕",
     "@language": "ko"
    },
    {
     "@value": "disciplinary foundations of NLP",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자연어 처리를 이루는 언어학(문법·의미론·화용론), 컴퓨터 과학(알고리즘·데이터 구조), 통계·수학(확률 모델·벡터 공간), 인공지능(머신러닝·딥러닝).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

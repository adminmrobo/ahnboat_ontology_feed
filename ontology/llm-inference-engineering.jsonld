    }
   ]
  },
  {
   "@id": "lab:method/word2vec",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "Word2Vec",
     "@language": "ko"
    },
    {
     "@value": "Word2Vec",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "주변 단어를 예측하는 작은 신경망을 학습해 단어마다 100~300차원의 밀집 벡터를 얻는 단어 임베딩 방법. 분포 가설에 바탕을 둔다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-1_word2vec_overview.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/w2v-training-tricks"
    },
    {
     "@id": "lab:method/logistic-regression"
    }
   ]
  },
  {
   "@id": "lab:method/w2v-training-tricks",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "Word2Vec 학습 효율화",
     "@language": "ko"
    },
    {
     "@value": "Word2Vec training efficiency techniques",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대상 단어와 몇 개의 부정 샘플만 학습하는 네거티브 샘플링(보통 5~20개)과, 이진 트리로 계산량을 O(V)에서 O(log V)로 줄이는 계층적 소프트맥스.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-1_word2vec_overview.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/vector-arithmetic"
    }
   ]
  },
  {
   "@id": "lab:concept/vector-arithmetic",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "단어 벡터 연산과 시각화",
     "@language": "ko"
    },
    {
     "@value": "word vector arithmetic and visualization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "단어 벡터의 덧셈·뺄셈으로 의미 관계를 추론하고, PCA·t-SNE로 고차원 벡터를 2·3차원에 그려 군집·방향·편향을 살피는 일.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-1_word2vec_overview.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/embedding-space"
    }
   ]
  },
  {
   "@id": "lab:method/cbow",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [

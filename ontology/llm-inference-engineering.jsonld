   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "어제 값 그대로 (나이브 예측)",
     "@language": "ko"
    },
    {
     "@value": "naive forecast",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "내일 값을 오늘 값으로 두는 가장 쉬운 기준선.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

     "@id": "lab:method/transformer"
    }
   ]
  },
  {
   "@id": "lab:term/lm-head",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "LM 헤드",
     "@language": "ko"
    },
    {
     "@value": "language modeling head",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "은닉 상태를 어휘 크기의 로짓 벡터로 바꾸는 출력층.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

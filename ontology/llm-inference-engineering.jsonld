     "@value": "memory token",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "글이 아니라 모델의 입력 자리에 바로 넣는 숫자 묶음. Memorilla는 16개를 쓴다.",
    "@language": "ko"

   ],
   "skos:prefLabel": [
    {
     "@value": "BI 도구",
     "@language": "ko"
    },
    {
     "@value": "business intelligence tool",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Business Intelligence 도구. 데이터를 대시보드·차트로 보여 의사결정을 돕는 프로그램(Tableau, Power BI).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/02-2_tools_environment.html#lv3"

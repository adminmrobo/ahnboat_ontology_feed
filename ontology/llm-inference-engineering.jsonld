    },
    {
     "@id": "lab:topic/self-attention"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:concept/arithmetic-intensity"
    }
   ]
  },
  {
   "@id": "lab:method/block-sparse-flashattention",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],

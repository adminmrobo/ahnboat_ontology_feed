  {
   "@id": "lab:concept/rnn-vanishing-gradient",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "순환 신경망과 기울기 소실",
     "@language": "ko"
    },
    {
     "@value": "recurrent neural network and vanishing gradients",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이전 은닉 상태를 현재 입력과 결합해 다음 은닉 상태를 만드는 순환 구조와, 긴 시퀀스에서 기울기가 거듭제곱으로 약해지거나 커지는 소실·폭주 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

   ],
   "skos:prefLabel": [
    {
     "@value": "시간을 거슬러 되돌려 보내기",
     "@language": "ko"
    },
    {
     "@value": "backpropagation through time",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "끝에서 틀린 만큼을 앞 칸으로 차례로 되돌려 보내 숫자를 고치는 학습 방법.",
    "@language": "ko"
   },

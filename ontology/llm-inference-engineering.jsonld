  {
   "@id": "lab:concept/llm-characteristics",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "대규모 언어모델의 특징",
     "@language": "ko"
    },
    {
     "@value": "characteristics of large language models",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "수십억~수조 매개변수의 LLM이 보이는 범용성(여러 작업 수행)과 창발성(명시적으로 학습하지 않은 능력의 출현), 좁은 AI에서 넓은 AI로·도구에서 동반자로의 패러다임 변화.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/09-3_llm_rag.html#lv1"
   },
   "lab:prerequisiteOf": [

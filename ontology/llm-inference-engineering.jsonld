   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "HMM",
     "@language": "ko"
    },
    {
     "@value": "hidden Markov model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Hidden Markov Model, 은닉 마르코프 모델. 보이지 않는 상태의 흐름을 확률로 모델링하는 통계 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/02-3_models_methods.html#lv3"
   },
   "lab:partOf": [
    {

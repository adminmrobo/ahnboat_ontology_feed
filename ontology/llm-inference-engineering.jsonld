     "@id": "lab:concept/exploding-gradient"
    }
   ]
  },
  {
   "@id": "lab:method/ar-model",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "AR·ARIMA 모델",
     "@language": "ko"
    },
    {
     "@value": "autoregressive and ARIMA models",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "과거 값들의 가중합(AR), 과거 오차의 가중합(MA), 차분(I)을 조합한 시계열 예측 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_1_window_is_memory.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/arima"
    }
   ]
  },
  {
   "@id": "lab:concept/validation-set",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "검증 데이터",
     "@language": "ko"
    },
    {
     "@value": "Validation set",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습에 쓰지 않고 설정과 멈출 때를 고르는 데 쓰는 데이터.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_1_window_is_memory.html#lv2"
   },
   "lab:topic": [

    }
   ]
  },
  {
   "@id": "lab:concept/sliding-window",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "창 (window)",
     "@language": "ko"
    },
    {
     "@value": "sliding window",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다음 값을 짐작할 때 펼쳐 놓는 과거 구간. 거슬러 보는 날 수(lookback)와 같은 말로 쓴다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_1_window_is_memory.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/memory-horizon"
    },
    {
     "@id": "lab:concept/context-window"
    },
    {
     "@id": "lab:concept/training-sample"
    }
   ]
  },
  {
   "@id": "lab:concept/memory-horizon",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기억의 길이",
     "@language": "ko"
    },
    {
     "@value": "memory horizon",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모델의 예측에 영향을 줄 수 있는 가장 먼 과거까지의 거리. 창 모델에서는 창 길이와 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_1_window_is_memory.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/context-window"
    }
   ]
  },
  {
   "@id": "lab:concept/training-sample",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "연습 문제 (학습 샘플)",
     "@language": "ko"
    },
    {
     "@value": "training sample",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(창, 정답 하루) 한 쌍. 창이 길수록 만들 수 있는 개수가 준다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_1_window_is_memory.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/sliding-window"
    }
   ]
  },
  {

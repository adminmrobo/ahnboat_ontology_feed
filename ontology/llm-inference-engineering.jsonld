    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "속도가 다른 메모 여러 칸",
     "@language": "ko"
    },
    {
     "@value": "multiple timescales",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "빠른 메모와 느린 메모를 함께 써서 천천히 꺼지는 메아리를 흉내 내는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_4_reading_state.html#lv1"
   }
  },
  {

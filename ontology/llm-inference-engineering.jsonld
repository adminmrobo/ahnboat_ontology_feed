   ],
   "skos:prefLabel": [
    {
     "@value": "모음 (쪽지 더하기)",
     "@language": "ko"
    },
    {
     "@value": "collection memory",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 정보가 올 때마다 기록을 하나씩 더하고 필요할 때 찾아 쓰는 기억.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/3_2_when_to_write.html#lv2"

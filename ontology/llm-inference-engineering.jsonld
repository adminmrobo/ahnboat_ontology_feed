     "@value": "예측 오차",
     "@language": "ko"
    },
    {
     "@value": "prediction error",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "예측한 켜진 비율과 측정한 비율의 차이(%p). 작을수록 좋다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_02_textbook_ch02_p1_p2/02_models.html#duel"

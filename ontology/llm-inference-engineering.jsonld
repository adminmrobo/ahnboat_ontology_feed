    }
   ]
  },
  {
   "@id": "lab:concept/seasonality",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "되풀이되는 흐름 (계절성)",
     "@language": "ko"
    },
    {
     "@value": "seasonality",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "요일·달처럼 일정한 간격으로 되풀이되는 오르내림.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_2_fading_echo.html#lv1"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:concept/short-memory"
    }
   ]
  },
  {
   "@id": "lab:concept/short-memory",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "단기기억 (빨리 꺼지는 메아리)",
     "@language": "ko"
    },
    {
     "@value": "short memory",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메아리가 하루마다 일정한 비율로 줄어 금방 0이 되는 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_2_fading_echo.html#lv2"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:concept/long-memory"
    }
   ]
  },
  {
   "@id": "lab:concept/half-life",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "반감기",
     "@language": "ko"
    },
    {
     "@value": "half-life",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메아리가 절반으로 줄어드는 데 걸리는 날 수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_2_fading_echo.html#lv2"
   }
  },
  {
   "@id": "lab:concept/decay-rate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "하루 뒤 남는 비율 (φ)",
     "@language": "ko"
    },
    {
     "@value": "decay rate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "하루가 지날 때 메아리가 몇 배로 남는지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_2_fading_echo.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/half-life"
    }
   ]
  },
  {
   "@id": "lab:method/deseasonalize",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "요일 평균 빼기",
     "@language": "ko"
    },
    {
     "@value": "deseasonalizing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "요일별 평균을 빼서 되풀이되는 흐름을 걷어 내는 손질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_2_fading_echo.html#lv2"
   },
   "lab:solves": [
    {
     "@id": "lab:concept/seasonality"
    }
   ]
  },
  {
   "@id": "lab:concept/long-memory",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "장기기억 (천천히 꺼지는 메아리)",
     "@language": "ko"
    },
    {
     "@value": "long memory",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메아리가 날 수의 거듭제곱으로 천천히 줄어 몇 달이 지나도 남는 기록의 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_3_long_memory.html#lv1"
   }
  },
  {
   "@id": "lab:concept/hurst-exponent",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "허스트 지수",
     "@language": "ko"
    },
    {
     "@value": "Hurst exponent",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메아리가 얼마나 오래 가는지 나타내는 숫자. 0.5면 기억 없음, 1에 가까울수록 오래 간다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_3_long_memory.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-memory"
    }
   ]
  },
  {
   "@id": "lab:concept/hyperbolic-decay",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "나누기로 줄기 (거듭제곱 감쇠)",
     "@language": "ko"
    },
    {
     "@value": "hyperbolic decay",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메아리가 날 수의 거듭제곱에 반비례해 줄어드는 모양.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_3_long_memory.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/long-memory"
    }
   ]
  },
  {
   "@id": "lab:method/fractional-differencing",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "분수 차분",
     "@language": "ko"
    },
    {
     "@value": "fractional differencing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "천천히 꺼지는 메아리를 세기 d 하나로 담는 방법. ARFIMA의 핵심.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_3_long_memory.html#lv1"
   },
   "lab:solves": [
    {
     "@id": "lab:concept/long-memory"
    }
   ]
  },
  {
   "@id": "lab:concept/mean-reversion",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "평소로 돌아가기",
     "@language": "ko"
    },
    {
     "@value": "mean reversion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시간이 지나면 값이 평소 수준 쪽으로 돌아오는 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_3_long_memory.html#lv2"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:concept/long-memory"
    }
   ]
  },
  {
   "@id": "lab:concept/running-memo",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "메모 한 칸 (지수 평균)",
     "@language": "ko"
    },
    {
     "@value": "running memo (exponential average)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 값이 올 때마다 옛 메모를 일정 비율 남기고 새 값을 더해 고쳐 쓰는 숫자 하나.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_4_reading_state.html#lv1"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/hidden-state"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/multi-timescale"
    }
   ]
  },
  {
   "@id": "lab:concept/retention-rate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "남기는 비율",
     "@language": "ko"
    },
    {
     "@value": "retention rate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "메모를 고쳐 쓸 때 옛 메모를 얼마나 남기는지.",
    "@language": "ko"
   },

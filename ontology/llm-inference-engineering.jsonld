    }
   ]
  },
  {
   "@id": "lab:method/autoregressive-generation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "자기회귀 토큰 생성",
     "@language": "ko"
    },
    {
     "@value": "autoregressive token generation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰 열에서 다음 토큰을 하나씩 예측해 이어 붙이는 생성 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

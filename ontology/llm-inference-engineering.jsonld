  {
   "@id": "lab:concept/nltk-toolkit",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "NLTK",
     "@language": "ko"
    },
    {
     "@value": "Natural Language Toolkit",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰화, 품사 태깅, 구문 분석, WordNet 기반 의미 분석, 텍스트 분류, 말뭉치 관리를 제공하는 교육 친화적 파이썬 자연어 처리 패키지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/03-2_english_nltk.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/english-preprocessing"
    }
   ]
  },
  {
   "@id": "lab:method/english-preprocessing",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "영어 텍스트 전처리",
     "@language": "ko"
    },
    {
     "@value": "English text preprocessing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "소문자 변환, 단어·문장 토큰화, 구두점 제거, 불용어 제거로 영어 원문을 분석용 토큰 목록으로 바꾸는 절차.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/03-2_english_nltk.html#lv2"
   },
   "lab:prerequisiteOf": [

   ]
  },
  {
   "@id": "lab:method/plan-nominal-activation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "이름표 기준 활성 계획",
     "@language": "ko"
    },
    {
     "@value": "plan by nominal activation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰당 고르는 비율(8/128)만큼만 일한다고 보고 계획한다 (주판봇의 선택).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

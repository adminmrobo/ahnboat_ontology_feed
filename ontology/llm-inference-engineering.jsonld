   ],
   "skos:definition": {
    "@value": "현재 값이 자기 자신의 과거 값과 얼마나 닮았는지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/llm_memory_trilogy/1_2_fading_echo.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/autocorrelation"
    }
   ],
   "lab:partOf": [

  {
   "@id": "lab:concept/word-similarity-applications",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "단어 유사도의 응용",
     "@language": "ko"
    },
    {
     "@value": "applications of word similarity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "단어 벡터 사이의 유사도를 검색 쿼리 확장, 콘텐츠 기반 추천, 기계 번역의 어휘 선택, 챗봇·질의응답에 활용하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-3_similarity.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/cosine-similarity"
    }
   ]
  },
  {
   "@id": "lab:concept/cosine-similarity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "코사인 유사도",
     "@language": "ko"
    },
    {
     "@value": "cosine similarity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 벡터가 이루는 각도의 코사인. −1(반대)~1(같은 방향) 값을 가지며 벡터의 길이는 무시한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-3_similarity.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/embedding-space"
    },
    {
     "@id": "lab:topic/inner-product-orthogonality"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/other-similarity-measures"
    }
   ]
  },
  {
   "@id": "lab:concept/other-similarity-measures",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "기타 유사도 측정과 Word2Vec의 한계",
     "@language": "ko"
    },
    {
     "@value": "other similarity measures and Word2Vec limitations",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "피어슨 상관계수, 자카드 유사도(교집합 ÷ 합집합), KL 발산(비대칭 분포 차이)과 OOV·다의어·문맥 무시라는 Word2Vec의 한계, 그리고 FastText·BERT·ELMo·GPT로의 보완.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/06-3_similarity.html#lv3"
   },

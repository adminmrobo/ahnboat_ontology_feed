     "@id": "lab:topic/residual-connections"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/seq2seq-improvements"
    }
   ]
  },
  {
   "@id": "lab:term/layernorm",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "층 정규화",
     "@language": "ko"
    },
    {
     "@value": "layer normalization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "층의 출력을 평균 0·일정한 크기로 맞춰 학습을 안정시키는 기법(Layer Normalization).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/08-1_seq2seq_limits.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/seq2seq-improvements"
    }
   ]
  },
  {
   "@id": "lab:term/coverage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "커버리지 메커니즘",
     "@language": "ko"
    },
    {
     "@value": "coverage mechanism",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이미 주목한 입력 위치를 기록해 반복·누락을 줄이는 기법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/08-1_seq2seq_limits.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/seq2seq-improvements"
    }
   ]
  },
  {
   "@id": "lab:method/attention-heatmap-evaluation",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "어텐션 효과 평가와 히트맵 해석",
     "@language": "ko"
    },
    {
     "@value": "evaluating attention and reading heatmaps",
     "@language": "en"
    }

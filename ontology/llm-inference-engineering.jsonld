     "@value": "온라인 소프트맥스",
     "@language": "ko"
    },
    {
     "@value": "online softmax (softmax with scaling)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최댓값 m과 지수합 ℓ을 들고 다니며 블록별 소프트맥스를 정확히 합치는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_03_article_01/03_flash_attention.html#r2"

   ]
  },
  {
   "@id": "lab:concept/verbosity-bias",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "길이 편향",
     "@language": "ko"
    },
    {
     "@value": "verbosity bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "내용과 무관하게 긴 답을 더 좋게 보는 경향.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/LLM_evaluation/llm_evaluation.html#lv4"
   }
  },
  {
   "@id": "lab:concept/position-bias",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "위치 편향",
     "@language": "ko"
    },
    {
     "@value": "position bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "먼저(또는 나중에) 보여 준 답을 더 좋게 보는 경향.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/LLM_evaluation/llm_evaluation.html#lv4"
   }
  },

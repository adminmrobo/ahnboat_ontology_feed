   ],
   "skos:prefLabel": [
    {
     "@value": "켜진 전문가 비율",
     "@language": "ko"
    },
    {
     "@value": "active expert fraction",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 디코드 단계에서 한 번이라도 선택된 전문가의 비율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "LLM 심판",
     "@language": "ko"
    },
    {
     "@value": "LLM-as-a-judge",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "더 강한 언어모델에게 답의 품질을 채점하게 하는 방법. 위치·길이 편향이 있다.",

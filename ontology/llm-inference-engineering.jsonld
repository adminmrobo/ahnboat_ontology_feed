     "@value": "구두점",
     "@language": "ko"
    },
    {
     "@value": "punctuation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "마침표·쉼표·느낌표처럼 문장을 끊거나 꾸미는 기호.",

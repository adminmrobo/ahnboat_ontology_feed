    {
     "@value": "라우터",
     "@language": "ko"
    },
    {
     "@value": "router",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "층마다 어떤 전문가를 쓸지 고르는 LLM 안의 작은 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

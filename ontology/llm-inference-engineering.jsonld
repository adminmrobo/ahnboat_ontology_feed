  {
   "@id": "lab:term/sent-tokenize",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "문장 토큰화",
     "@language": "ko"
    },
    {
     "@value": "sentence tokenization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "긴 글을 문장 단위로 나누는 일(sent_tokenize).",
    "@language": "ko"

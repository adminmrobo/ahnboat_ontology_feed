    }
   ]
  },
  {
   "@id": "lab:method/stopword-removal",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "불용어 제거와 원형 찾기",
     "@language": "ko"
    },
    {
     "@value": "stop-word removal and stemming/lemmatization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "분석에 도움이 적은 흔한 단어를 빼고, 단어를 어간이나 사전 기본형(표제어)으로 바꿔 같은 단어를 하나로 모으는 전처리.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/ai-nlp-data-analysis/03-1_morpheme_overview.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/nltk-toolkit"
    }
   ]
  },
  {
   "@id": "lab:term/natural-language",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자연어",
     "@language": "ko"
    },
    {
     "@value": "natural language",
     "@language": "en"
    }
   ],
   "skos:definition": {

     "@value": "Memorilla",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "저장된 문서 전체에서 질문에 필요한 것을 고정된 수의 기억 토큰으로 모아 모델에 넘기는 기억 장치.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

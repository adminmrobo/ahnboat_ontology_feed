   ],
   "skos:prefLabel": [
    {
     "@value": "피드포워드 층",
     "@language": "ko"
    },
    {
     "@value": "feed-forward network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "트랜스포머 블록 안의 다층 퍼셉트론. 학습 가능한 가중치의 대부분을 차지한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

     "@id": "lab:method/flashattention"
    }
   ]
  },
  {
   "@id": "lab:method/gradient-checkpointing",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "그래디언트 체크포인팅",
     "@language": "ko"
    },
    {
     "@value": "gradient checkpointing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "중간값 일부만 보관하고 역방향에서 다시 계산해 메모리를 아끼는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/inference_engineering_study/week_03_article_01/03_flash_attention.html#lab"
   }

    },
    {
     "@value": "signal to noise",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "상태공간모형에서 지속 성분의 잡음 분산과 일시 성분·측정 잡음 분산의 비. 이 비가 크면 지속 성분이 관측값을 바짝 따라가 뾰족해지고, 작으면 매끄러운 추세가 된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

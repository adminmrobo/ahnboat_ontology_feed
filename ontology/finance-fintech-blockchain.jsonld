     "@id": "lab:topic/token-economics"
    }
   ]
  },
  {
   "@id": "lab:term/erc-20",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "ERC-20",
     "@language": "ko"
    },
    {
     "@value": "ERC-20",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이더리움 위에서 토큰을 만들 때 쓰는 공통 규격. 03·04편의 91개 토큰이 이 규격이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/smart-contracts"
    }
   ]
  },
  {
   "@id": "lab:metric/var",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "VaR",
     "@language": "ko"
    },
    {
     "@value": "Value at Risk",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "주어진 신뢰수준에서 정해진 기간 동안 생길 수 있는 최대 손실 금액.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/heteroskedasticity"
    }
   ]
  },
  {
   "@id": "lab:method/autoregressive-volatility",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "자기회귀 변동성 모형",
     "@language": "ko"
    },
    {
     "@value": "autoregressive volatility model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "변동성의 자기회귀적 특징을 고려한 모형(원문 2.2).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#lab"
   }
  },
  {
   "@id": "lab:method/moving-sd-60",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "60일 이동 표준편차",
     "@language": "ko"
    },
    {
     "@value": "60-day rolling standard deviation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대결에서 초파리가 고른 예보 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#duel"
   },

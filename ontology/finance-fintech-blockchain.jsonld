    }
   ]
  },
  {
   "@id": "lab:concept/financial-leverage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "재무레버리지",
     "@language": "ko"
    },
    {
     "@value": "financial leverage",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "부채와 자기자본의 시장가치 비율. 주가가 떨어지면 커진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-6_asymmetry-decomposition.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/leverage-effect"
    }
   ]
  },
  {
   "@id": "lab:method/tgarch",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "TGARCH (기준값 GARCH)",
     "@language": "ko"
    },
    {
     "@value": "tgarch",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "나쁜 뉴스(uₜ₋₁<0)일 때 u²의 계수에 γ를 더해 비대칭을 담는 GARCH. Glosten·Jagannathan·Runkle(1993).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-6_asymmetry-decomposition.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/egarch"
    }
   ],
   "lab:broader": [
    {

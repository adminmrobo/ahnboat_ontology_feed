     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "하루 수익률이 서로 독립이면 Δt일 표준편차는 하루 표준편차 × √Δt.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/value-at-risk"
    }
   ]
  },
  {
   "@id": "lab:method/constant-variance",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "상수 분산 (전체 표본)",
     "@language": "ko"
    },
    {
     "@value": "constant variance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "긴 기간 전체로 분산 하나를 계산해 모든 날에 똑같이 쓰는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#lv2"
   },

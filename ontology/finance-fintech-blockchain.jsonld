   ]
  },
  {
   "@id": "lab:method/simple-moving-average",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "단순이동평균 (SMA)",
     "@language": "ko"
    },
    {
     "@value": "simple moving average",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "최근 m일 수익률 제곱을 똑같은 무게(1/m)로 평균해 분산을 어림한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/trend-seasonality"
    }
   ],
   "lab:prerequisiteOf": [

    },
    {
     "@value": "contemporaneous effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 날 기대변수 변화와 수익률의 관계. VKOSPI는 모든 섹터에서 강한 음(-)이었다.",
    "@language": "ko"

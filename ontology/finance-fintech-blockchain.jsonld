  {
   "@id": "lab:concept/nonsynchronous-trading",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "마감 시각 차이 (비동시 거래)",
     "@language": "ko"
    },
    {
     "@value": "nonsynchronous trading",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "선물이 현물보다 늦게 마감하면, 현물 마감 뒤에 나온 정보가 오늘 선물에 먼저 담기고 내일 현물에 반영된다. 그러면 어제 선물 변화가 오늘 현물을 '앞서는' 것처럼 보인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch3/3-6_usdf-k200f.html#lv3"
   },

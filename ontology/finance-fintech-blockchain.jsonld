    }
   ]
  },
  {
   "@id": "lab:concept/legal-tender",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "법정화폐",
     "@language": "ko"
    },
    {
     "@value": "legal tender",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정부가 법으로 지정해 유통되고 발행국에서 교환수단으로 통용되는 화폐(원문이 인용한 FinCEN 설명).",
    "@language": "ko"
   },

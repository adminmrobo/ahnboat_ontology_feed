  {
   "@id": "lab:concept/steem",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "스팀",
     "@language": "ko"
    },
    {
     "@value": "STEEM",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스팀 블록체인의 핵심 코인. 기간마다 일정 %를 새로 발행해 보상으로 나눈다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

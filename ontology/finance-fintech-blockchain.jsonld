  {
   "@id": "lab:method/arch",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "ARCH 모형",
     "@language": "ko"
    },
    {
     "@value": "arch",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "오늘의 분산을 어제 충격(오차) 제곱으로 정하는 모형. Engle(1982).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/volatility-models"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:method/maximum-likelihood"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/garch"
    }
   ]
  },
  {
   "@id": "lab:method/garch",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "GARCH 모형",
     "@language": "ko"
    },
    {
     "@value": "GARCH",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "오늘의 분산을 상수, 어제 충격 제곱, 어제 분산의 가중합으로 정하는 모형. Bollerslev(1986).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/volatility-models"
    }
   ],
   "lab:prerequisiteOf": [

     "@language": "ko"
    },
    {
     "@value": "average block interval",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "블록과 블록 사이에 걸린 시간의 평균. 백서는 10분을 가정한다.",
    "@language": "ko"
   },

  {
   "@id": "lab:concept/break-even-point",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "손익분기점",
     "@language": "ko"
    },
    {
     "@value": "Break-even point",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "평균총비용의 최저점. 이윤 0.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

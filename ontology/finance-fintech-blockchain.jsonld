    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "목표값",
     "@language": "ko"
    },
    {
     "@value": "target",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "블록 해시가 이 값보다 작아야 유효하다. 목표값이 작을수록 난이도가 높다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

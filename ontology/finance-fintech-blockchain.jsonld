  },
  {
   "@id": "lab:concept/operating-leverage",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "영업레버리지와 투자 의사결정",
     "@language": "ko"
    },
    {
     "@value": "operating leverage and investment decision",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "영업레버리지도(DOL) = 공헌이익 ÷ 영업이익. 고정비 비중이 클수록 매출 변화율이 영업이익 변화율로 크게 증폭된다. 투자는 회수기간과 순현재가치(NPV)로 평가한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/valuation_without_revenue/02_proforma_vc.html#lv3"
   },

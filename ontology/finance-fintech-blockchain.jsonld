    {
     "@value": "준강형 효율적 시장",
     "@language": "ko"
    },
    {
     "@value": "semi-strong-form efficiency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "발표된 공개 정보까지 즉시 가격에 반영된다는 형태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_01_bitcoin_price_analytics/crypto_info_efficiency.html#q1"

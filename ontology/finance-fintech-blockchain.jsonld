   }
  },
  {
   "@id": "lab:method/hmm",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "은닉 마르코프 모델(HMM)",
     "@language": "ko"
    },
    {
     "@value": "Hidden Markov Model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잠재된 시장 국면 상태(은닉층)와 방출 관측치를 모델링하는 2중 확률 모형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_02_crypto_predict_model_analytics/01_crypto_timeseries.html#sec-diag"
   },

    }
   ]
  },
  {
   "@id": "lab:method/curation-reward",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "큐레이팅 보상",
     "@language": "ko"
    },
    {
     "@value": "curation reward",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "좋은 글에 투표한 사람이 받는 보상. 전체 보상의 25%. 빨리, 큰 스팀파워로 투표할수록 많이 받는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/token-economics"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/reward-pool"
    }
   ]
  },
  {
   "@id": "lab:concept/steem-power",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "스팀파워",
     "@language": "ko"
    },
    {
     "@value": "Steem Power",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스팀을 묶어 영향력(보팅 파워)으로 바꾼 것. 거래·전송이 안 되고, 다시 스팀으로 바꾸는 데 13주가 걸린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/token-economics"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/peg"
    }
   ]
  },
  {
   "@id": "lab:concept/power-down",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "파워다운",
     "@language": "ko"
    },
    {
     "@value": "power down",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스팀파워를 스팀으로 되돌리는 일. 13주에 걸쳐 1주마다 최대 1/13씩 바뀐다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/steem-power"
    }
   ]
  },
  {
   "@id": "lab:concept/steem-dollar",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "스팀달러",
     "@language": "ko"
    },
    {
     "@value": "Steem Dollars (SBD)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "유통을 위해 만든 토큰. 1달러 가치 유지를 목표로 이자와 컨버전 장치를 둔다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/token-economics"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/peg"
    }
   ]
  },
  {
   "@id": "lab:concept/peg",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "1달러 고정 목표",
     "@language": "ko"
    },
    {
     "@value": "price peg",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰 가격을 특정 값(여기서는 1달러)에 묶어 두려는 목표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#lab"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/token-economics"
    }
   ]
  },
  {
   "@id": "lab:method/sbd-savings-interest",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "저축 이자 장치",
     "@language": "ko"
    },
    {
     "@value": "SBD savings interest",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스팀달러가 1달러 이하일 때 저축 계정에 이자를 붙여 저축을 유도하고 공급을 줄인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#lab"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/peg"
    }
   ]
  },
  {
   "@id": "lab:method/sbd-conversion",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "컨버전",
     "@language": "ko"
    },
    {
     "@value": "SBD conversion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스팀달러 1개를 내면 1달러어치 스팀을 받는 기능. 스팀달러를 없애 공급을 줄인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#lab"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/peg"
    }
   ]
  },
  {
   "@id": "lab:metric/peg-deviation",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균 괴리",
     "@language": "ko"
    },
    {
     "@value": "mean absolute peg deviation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "180일 동안 |가격 − 1달러|의 평균. 대결 판정 기준.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#duel"
   }
  },

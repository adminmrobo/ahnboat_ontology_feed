    },
    {
     "@value": "toyoda bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 기간의 오차 분산이 다르면 Chow F 검정의 실제 기각률이 명목 수준과 달라진다. 짧은 기간의 분산이 크면 과다 기각, 작으면 과소 기각한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch3/3-3_decomposition-check.html#lv2"

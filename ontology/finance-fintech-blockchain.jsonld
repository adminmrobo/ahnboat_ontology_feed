    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "강형 효율적 시장",
     "@language": "ko"
    },
    {
     "@value": "strong-form efficiency",
     "@language": "en"
    }
   ],
   "skos:definition": {

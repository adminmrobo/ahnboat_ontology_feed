  {
   "@id": "lab:concept/cds",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "신용파산스왑(CDS)",
     "@language": "ko"
    },
    {
     "@value": "cds",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "채무불이행 위험을 넘기는 대가로 수수료(CDS 프리미엄)를 내고, 신용사건 때 손실을 보전받는 계약.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-7_volatility-index.html#lv4"
   }
  },
  {
   "@id": "lab:concept/fear-gauge",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "공포지수",
     "@language": "ko"
    },
    {
     "@value": "fear gauge",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "VIX의 별명. 주가와 반대로 움직여 위기 때 치솟는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-7_volatility-index.html#lv1"

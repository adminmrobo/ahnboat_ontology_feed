   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "전기 효과 (γ₂, γ₄)",
     "@language": "ko"
    },
    {
     "@value": "lagged effect",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "어제(또는 지난주 평균)의 기대변수 변화가 오늘 수익률에 주는 영향. 논문이 말하는 수익률 효과의 핵심.",
    "@language": "ko"
   },

     "@id": "lab:topic/share-capital"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/financing-activities"
    }
   ]
  },
  {
   "@id": "lab:concept/fair-value-loss",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "공정가치 평가손실",
     "@language": "ko"
    },
    {
     "@value": "fair value loss",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "전환사채·파생상품 등을 공정가치로 다시 재면서 생긴 손실. 순손실을 키우지만 현금은 나가지 않는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/cashflow-lab/index.html#lv5"
   },

   ]
  },
  {
   "@id": "lab:term/distributed-ledger",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "분산 장부",
     "@language": "ko"
    },
    {
     "@value": "distributed ledger",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 기관이 아니라 여러 참여자가 같은 거래 기록을 나눠 갖고 함께 검증하는 장부.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/ledger-evolution"
    }
   ]
  },
  {
   "@id": "lab:term/upvote",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "업보팅",
     "@language": "ko"
    },
    {
     "@value": "upvote",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "게시글을 추천하는 투표. 스팀파워가 클수록 투표의 힘(보팅 파워)이 크다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r2"
   }
  },
  {
   "@id": "lab:term/token-economy",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "토큰 이코노미",
     "@language": "ko"
    },
    {
     "@value": "token economy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "토큰의 발행·보상·유통 규칙으로 참여자의 행동을 이끄는 경제 설계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#q"
   },
   "lab:topic": [

   ],
   "skos:prefLabel": [
    {
     "@value": "확정 깊이만큼 기다리기",
     "@language": "ko"
    },
    {
     "@value": "waiting for confirmations",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "거래가 담긴 블록 뒤에 z블록이 쌓일 때까지 기다려 공격 성공 확률을 낮추는 방식.",
    "@language": "ko"
   },

    }
   ]
  },
  {
   "@id": "lab:concept/electronic-money",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "전자화폐",
     "@language": "ko"
    },
    {
     "@value": "electronic money",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "전자적으로만 교환되는 돈이나 증서. 컴퓨터 네트워크, 인터넷, 선불카드 시스템에서 쓰인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r1"
   },
   "lab:topic": [

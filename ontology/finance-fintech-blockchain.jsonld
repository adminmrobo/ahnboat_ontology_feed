    }
   ]
  },
  {
   "@id": "lab:concept/virtual-currency",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "가상화폐",
     "@language": "ko"
    },
    {
     "@value": "virtual currency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "개발자가 발행·관리하고 특정 가상 커뮤니티 회원끼리 쓰는 규제되지 않은 디지털 화폐(유럽중앙은행 2012 정의).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r1"
   },

     "@id": "lab:concept/spurious-persistence"
    }
   ]
  },
  {
   "@id": "lab:concept/cryptocurrency",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "암호화폐",
     "@language": "ko"
    },
    {
     "@value": "cryptocurrency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "블록체인 기술로 암호화돼 분산 발행되는 디지털 자산. 액면가와 기초자산이 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#r1"
   },

     "@id": "lab:method/garch"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/sigma-forecast-error"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/sim-garch-market"
    }
   ]
  },
  {
   "@id": "lab:metric/sigma-forecast-error",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "σ 예측 평균 오차",
     "@language": "ko"
    },
    {
     "@value": "mean absolute sigma forecast error",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시험 기간에 예측 σ와 진짜 σ의 차이를 평균한 값.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#duel"
   }
  },
  {
   "@id": "lab:metric/var-violation-rate",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "VaR 위반 비율",
     "@language": "ko"
    },
    {
     "@value": "VaR violation rate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "수익률이 VaR 경계 아래로 떨어진 날의 비율. 신뢰수준과 맞아야 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#lab"
   }
  },
  {
   "@id": "lab:dataset/sim-garch-market",
   "@type": [
    "skos:Concept",
    "lab:Dataset"
   ],
   "skos:prefLabel": [
    {
     "@value": "가상 GARCH 시장",
     "@language": "ko"
    },
    {
     "@value": "simulated GARCH market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "α=0.10, β=0.85, 장기 σ 3%/일로 만든 1,000일 가상 수익률.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#lab"
   }
  },
  {
   "@id": "lab:term/standard-deviation",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "표준편차",
     "@language": "ko"
    },
    {
     "@value": "standard deviation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "값들이 평균에서 얼마나 퍼져 있는지 나타내는 수. 분산의 제곱근.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/dispersion"
    }
   ]
  },
  {
   "@id": "lab:term/normal-distribution",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "정규분포",
     "@language": "ko"
    },
    {
     "@value": "normal distribution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "평균을 중심으로 좌우 대칭인 종 모양 분포. 정규분포 VaR는 수익률이 이 분포를 따른다고 본다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/continuous-distributions"
    }
   ]
  },
  {
   "@id": "lab:term/autocorrelation",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "자기상관",
     "@language": "ko"
    },
    {
     "@value": "autocorrelation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "어떤 값이 몇 시점 전의 자기 값과 얼마나 같이 움직이는지 나타내는 상관.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/autocorrelation"
    }
   ]
  },
  {
   "@id": "lab:term/conditional-variance",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [

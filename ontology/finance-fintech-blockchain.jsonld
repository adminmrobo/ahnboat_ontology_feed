   ],
   "skos:prefLabel": [
    {
     "@value": "assert 검산",
     "@language": "ko"
    },
    {
     "@value": "assertion-based reconciliation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조건이 틀리면 코드가 멈추게 해 AI가 쓴 계산을 공시 숫자·항등식과 대조하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

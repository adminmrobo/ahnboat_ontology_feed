  {
   "@id": "lab:method/mining-race",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "채굴 경주 (먼저 푼 노드가 블록을 씀)",
     "@language": "ko"
    },
    {
     "@value": "mining race",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "여러 채굴자가 동시에 논스를 찾고, 가장 먼저 찾은 노드가 블록을 쓰고 보상을 받는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch02/2-06_mining-race.html#lv2"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/blocks-won"
    }
   ]
  },
  {
   "@id": "lab:metric/expected-attempts",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균 시도 횟수 16^d",
     "@language": "ko"
    },
    {
     "@value": "expected attempts",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞자리 0이 d개인 해시를 찾는 데 필요한 평균 시도 수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch02/2-06_mining-race.html#lv1"
   }
  },
  {
   "@id": "lab:metric/blocks-won",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "만든 블록 수",
     "@language": "ko"
    },
    {
     "@value": "blocks won",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "경주에서 각 채굴자가 먼저 찾아 쓴 블록의 수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch02/2-06_mining-race.html#duel"
   }
  },
  {

     "@id": "lab:method/ewma"
    }
   ]
  },
  {
   "@id": "lab:metric/var-exceedance",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "VaR 초과율",
     "@language": "ko"
    },
    {
     "@value": "VaR exceedance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "손실이 VaR 한도를 넘은 날의 비율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#lv2"
   }
  },
  {
   "@id": "lab:metric/forecast-rmse",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "변동성 예측 오차 (RMSE)",
     "@language": "ko"
    },
    {
     "@value": "forecast RMSE",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "예측 σ와 모의 시장의 진짜 σ 차이의 제곱평균제곱근.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#duel"
   }
  },
  {
   "@id": "lab:concept/conditional-variance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "조건부 분산 hₜ",
     "@language": "ko"
    },
    {
     "@value": "conditional variance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "어제(t−1)까지의 정보가 주어졌을 때 오늘 수익률의 분산. 날마다 바뀐다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/volatility-models"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/ljung-box-test"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/garch-m"
    }
   ]
  },
  {
   "@id": "lab:concept/unconditional-variance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "무조건부 분산",
     "@language": "ko"
    },
    {
     "@value": "unconditional variance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정보를 하나도 쓰지 않은 전체 평균 분산. 모든 날에 같다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv1"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:concept/conditional-variance"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/mean-reversion"
    }
   ]
  },
  {
   "@id": "lab:method/ljung-box-test",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "Ljung-Box Q 검정",
     "@language": "ko"
    },
    {
     "@value": "ljung box test",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "여러 시차의 자기상관을 한꺼번에 묶어 '모두 0인가'를 검정한다. Q가 카이제곱 임계값보다 크면 독립이라는 가설을 버린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/lm-test"
    },
    {
     "@id": "lab:concept/nonlinear-dependence"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/thesis-q"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/misclass"
    }
   ]
  },
  {
   "@id": "lab:term/null-hypothesis",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "귀무가설",
     "@language": "ko"
    },
    {
     "@value": "null hypothesis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "'차이·관계가 없다'는 기본 가정. 데이터가 이것과 너무 안 맞으면 기각한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/ljung-box-test"
    }
   ]
  },
  {
   "@id": "lab:method/lm-test",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "라그랑주 승수(LM) 검정",
     "@language": "ko"
    },
    {
     "@value": "lm test",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "잔차 제곱을 그 시차들에 회귀해 모든 계수가 0인지 검정한다. T·R²가 χ²(q)를 따른다. Engle(1982).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/maximum-likelihood"
    }
   ]
  },
  {
   "@id": "lab:term/r-squared",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "결정계수 R²",
     "@language": "ko"
    },
    {
     "@value": "r squared",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "회귀식이 종속변수의 출렁임을 얼마나 설명하는지(0~1).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/lm-test"
    }
   ]
  },
  {
   "@id": "lab:method/maximum-likelihood",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "최우추정 (ML)",
     "@language": "ko"
    },
    {
     "@value": "maximum likelihood",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관측된 자료가 나올 확률(우도)을 가장 크게 만드는 모수를 고르는 추정법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/maximum-likelihood"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:method/moment-estimator"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/abs-error"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/simulated-arch"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/garch"
    },
    {
     "@id": "lab:method/garch-m"
    }
   ]
  },
  {
   "@id": "lab:concept/log-likelihood",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "로그우도",
     "@language": "ko"
    },
    {
     "@value": "log likelihood",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "우도에 로그를 씌운 값. 곱이 합으로 바뀌어 계산이 쉽다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv4"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/maximum-likelihood"
    }
   ]
  },
  {
   "@id": "lab:method/moment-estimator",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "적률 추정 (u² 자기상관)",
     "@language": "ko"
    },
    {
     "@value": "moment estimator",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "ARCH(1)에서 u²의 1시차 자기상관이 α₁과 같다는 성질로 α₁을 어림하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#duel"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/abs-error"
    }
   ]
  },
  {
   "@id": "lab:metric/abs-error",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "α₁ 추정 오차",
     "@language": "ko"
    },
    {
     "@value": "absolute error",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "추정한 α₁과 모의 시장의 진짜 α₁의 차이(절대값)의 평균.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#duel"
   }
  },
  {
   "@id": "lab:dataset/simulated-arch",
   "@type": [
    "skos:Concept",
    "lab:Dataset"
   ],
   "skos:prefLabel": [
    {
     "@value": "모의 ARCH(1) 표본 (설명용)",
     "@language": "ko"
    },
    {
     "@value": "simulated ARCH(1)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "진짜 α₀, α₁을 알고 만든 가짜 수익률.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-4_clustering-tests.html#lv4"
   }
  },
  {
   "@id": "lab:term/omega",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "ω (오메가)",
     "@language": "ko"
    },
    {
     "@value": "omega",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "GARCH 분산식의 상수항. 장기 분산 = ω/(1−α−β)를 정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-5_arch-garch.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/garch"
    }
   ]
  },
  {
   "@id": "lab:method/igarch",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "IGARCH",
     "@language": "ko"
    },
    {
     "@value": "integrated GARCH",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "α+β = 1인 GARCH. 충격이 분산에 영구히 남는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-5_arch-garch.html#lv3"
   },
   "lab:broader": [
    {
     "@id": "lab:method/garch"
    }
   ]
  },
  {
   "@id": "lab:method/garch-m",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "GARCH-M",
     "@language": "ko"
    },
    {
     "@value": "GARCH-in-mean",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "평균방정식에 조건부 분산을 넣어 시간가변적 위험 프리미엄을 측정하는 GARCH.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-5_arch-garch.html#lv4"
   },
   "lab:broader": [
    {
     "@id": "lab:method/garch"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/state-space-model"
    }
   ],
   "lab:evaluatedOn": [

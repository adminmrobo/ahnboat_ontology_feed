   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "앞 500일로 추정한 GARCH(1,1)",
     "@language": "ko"
    },
    {
     "@value": "fitted GARCH(1,1)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대결에서 주판봇이 고른 예보 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#duel"
   },

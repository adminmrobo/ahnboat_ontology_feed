    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/forecast-rmse"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/simulated-market"
    }
   ]
  },
  {
   "@id": "lab:concept/persistence",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지속성 (α+β)",
     "@language": "ko"
    },
    {
     "@value": "persistence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "충격이 분산에 얼마나 오래 남는지. GARCH(1,1)에서는 α+β, 1에 가까울수록 오래 간다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/02_volatility_garch.html#r3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/igarch"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/garch"
    },
    {
     "@id": "lab:method/garch-m"
    }
   ],
   "lab:relatedTo": [

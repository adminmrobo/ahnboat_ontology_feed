    }
   ],
   "skos:definition": {
    "@value": "구조변화가 일어났다고 보는 시점. 사건(위기 시작일)으로 정하거나 자료에서 F가 가장 큰 시점을 찾는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

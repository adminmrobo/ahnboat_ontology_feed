     "@id": "lab:method/historical-volatility"
    }
   ]
  },
  {
   "@id": "lab:term/lambda",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "λ (람다)",
     "@language": "ko"
    },
    {
     "@value": "lambda",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "EWMA에서 어제까지의 어림값을 얼마나 남길지 정하는 값. 0.94면 하루마다 무게가 6%씩 준다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/ewma"
    }
   ]
  },
  {
   "@id": "lab:method/riskmetrics",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "리스크메트릭스 (RiskMetrics)",
     "@language": "ko"
    },
    {
     "@value": "riskmetrics",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "J.P. Morgan이 쓰던 위험관리 방식. 어제 추정치와 어제 수익률로 오늘 분산을 갱신하는 EWMA의 일종.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-3_risk-measures.html#lv4"
   },
   "lab:topic": [

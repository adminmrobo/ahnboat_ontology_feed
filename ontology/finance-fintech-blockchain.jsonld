    },
    {
     "@value": "efsf",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "재정위기에 처한 유로존 회원국을 지원하려고 2010년 5월 설립한 비상기금. 논문은 설립일 2010.5.9를 4기의 시작으로 보았다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ]
  },
  {
   "@id": "lab:concept/multicollinearity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "다중공선성",
     "@language": "ko"
    },
    {
     "@value": "multicollinearity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "설명변수끼리 강하게 함께 움직여 회귀계수를 따로 가려내기 어려운 상태. 계수가 흔들리고 부호가 뒤집히기도 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch2/2-3_research-model.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/multicollinearity"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:method/contribution-regression"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/return-effect-model"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/fig51"
    }
   ]
  },
  {
   "@id": "lab:method/return-effect-model",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "수익률 효과 모형 1~3",
     "@language": "ko"
    },
    {
     "@value": "return effect model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "섹터 당기수익률을 당기·전기 기대변수, 전기 수익률, 전기 평균 기대변수(또는 평균 수익률)에 회귀(식 4.16~4.18).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch2/2-3_research-model.html#lv4"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/a2-error"
    }
   ],
   "lab:evaluatedOn": [
    {
     "@id": "lab:dataset/sim-return-effect"
    }
   ]
  },
  {
   "@id": "lab:concept/omitted-variable-bias",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "누락변수 편의",
     "@language": "ko"
    },
    {
     "@value": "omitted variable bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "결과에 영향을 주고 설명변수와도 상관된 변수를 빼면, 남은 계수가 그 몫까지 떠안아 치우친다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch2/2-3_research-model.html#lv4"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/a2-error"
    }
   ]
  },

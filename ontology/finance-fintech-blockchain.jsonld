   ],
   "skos:prefLabel": [
    {
     "@value": "Accuracy Ratio (괴리율)",
     "@language": "ko"
    },
    {
     "@value": "Accuracy Ratio",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(예측가/실제가) - 1 로 정의되며 스케일 불변성과 과대/과소 편향을 탐지하는 지표.",
    "@language": "ko"
   },

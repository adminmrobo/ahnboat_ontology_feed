   ],
   "skos:prefLabel": [
    {
     "@value": "채굴",
     "@language": "ko"
    },
    {
     "@value": "mining",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 블록을 만들고 검증하는 계산 작업. 먼저 성공한 채굴자가 보상으로 비트코인을 받는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

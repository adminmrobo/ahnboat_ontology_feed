  {
   "@id": "lab:concept/mining-difficulty",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "채굴 난이도",
     "@language": "ko"
    },
    {
     "@value": "mining difficulty",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "채굴 문제의 어려운 정도. 참여 계산력이 늘면 올라가고 줄면 내려가, 정해진 시간에 일정 수의 블록이 나오게 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch02/2-06_mining-race.html#why"
   },
   "lab:partOf": [

    },
    {
     "@value": "interest plus conversion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대결에서 주판봇이 고른 설정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#duel"

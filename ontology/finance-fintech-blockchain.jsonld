   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "Chow 검정",
     "@language": "ko"
    },
    {
     "@value": "chow test",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자료를 한 시점에서 둘로 나눠 각각 회귀한 뒤, 두 기간의 회귀계수가 같다는 귀무가설을 F 검정으로 확인한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch2/2-4_periods-chow.html#lv2"

     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Pₜ = β₀ + β₁Xᵃ + β₂BPS + ε. 기타정보를 빼고 주당 값으로 쓴 실증식.",
    "@language": "ko"
   },

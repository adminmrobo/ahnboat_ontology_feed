   ],
   "skos:prefLabel": [
    {
     "@value": "정보 효율성",
     "@language": "ko"
    },
    {
     "@value": "information efficiency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 정보가 가격에 얼마나 빠르고 완전하게 반영되는지. 이 논문은 코인 가격 정보의 주식시장 선행 정보 역할로 살폈다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

     "@value": "탈중앙화 정도",
     "@language": "ko"
    },
    {
     "@value": "degree of decentralization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "참여와 결정권이 얼마나 여러 참여자에게 퍼져 있는가.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#q"
   },

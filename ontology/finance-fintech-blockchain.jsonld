     "@value": "현금 런웨이",
     "@language": "ko"
    },
    {
     "@value": "cash runway",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "가진 현금성 자금이 지금의 영업현금 유출 속도로 몇 달 버티는지 보는 단순 지표.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

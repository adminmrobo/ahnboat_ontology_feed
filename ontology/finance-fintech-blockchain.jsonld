   "lab:partOf": [
    {
     "@id": "lab:method/chow-test"
    }
   ]
  },
  {
   "@id": "lab:concept/f-distribution",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "F 분포",
     "@language": "ko"
    },
    {
     "@value": "f distribution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 분산의 비가 따르는 분포. Chow 검정 통계량이 귀무가설 아래에서 F(k, n−2k)를 따른다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch2/2-4_periods-chow.html#lv2"

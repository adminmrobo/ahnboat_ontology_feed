    }
   ]
  },
  {
   "@id": "lab:metric/roe",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "자기자본이익률",
     "@language": "ko"
    },
    {
     "@value": "return on equity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "순이익 ÷ 자기자본. 주주의 돈으로 얼마를 벌었나.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/valuation_without_revenue/03_value_models.html#lv5"
   }
  },

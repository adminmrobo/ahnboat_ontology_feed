    }
   ]
  },
  {
   "@id": "lab:concept/reward-pool",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "보상 바구니",
     "@language": "ko"
    },
    {
     "@value": "reward pool",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기간마다 새로 발행한 스팀으로 만든 보상. 달러 가치는 스팀 가격에 따라 바뀐다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

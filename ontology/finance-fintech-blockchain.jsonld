     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "블록을 쓸 권리, 곧 표를 계산력에 비례해 주는 원리.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch02/2-06_mining-race.html#lv2"
   },
   "lab:partOf": [

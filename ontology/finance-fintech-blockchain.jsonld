   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "영업현금흐름 ÷ 당기순이익",
     "@language": "ko"
    },
    {
     "@value": "CFO to net income",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이익의 질을 보는 비율. 손실 회사에서는 '순손실 중 실제 현금 손실의 비율'로 읽는다.",
    "@language": "ko"
   },

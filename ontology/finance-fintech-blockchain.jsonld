    {
     "@value": "traffic revenue model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "매출 = 대상 인구 × 일 접속률 × 1인당 일 클릭 × 단가 × 영업일수.",
    "@language": "ko"
   },

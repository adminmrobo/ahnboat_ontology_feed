  {
   "@id": "lab:standard/kr-gaap",
   "@type": [
    "skos:Concept",
    "lab:Standard"
   ],
   "skos:prefLabel": [
    {
     "@value": "일반기업회계기준",
     "@language": "ko"
    },
    {
     "@value": "Korean GAAP for non-public entities",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "K-IFRS를 적용하지 않는 외부감사 대상 회사가 쓰는 기준. 사례 회사가 적용.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/cashflow-lab/index.html#lv6"
   }
  },
  {
   "@id": "lab:method/cashflow-prompt",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "현금흐름표 작성 프롬프트",
     "@language": "ko"
    },
    {
     "@value": "cash flow prompt",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작성 원칙·검산 요구·출력 형식을 담아 생성AI에게 코드를 쓰게 하는 지시문.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

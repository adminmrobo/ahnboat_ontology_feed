   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "이자만 쓰는 선택",
     "@language": "ko"
    },
    {
     "@value": "interest only",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대결에서 초파리가 고른 설정.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_07_media_blockchain/01_steem_reward_tokens.html#duel"

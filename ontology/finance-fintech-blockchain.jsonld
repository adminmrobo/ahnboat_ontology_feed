    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "51% 공격",
     "@language": "ko"
    },
    {
     "@value": "majority attack",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 세력이 계산력(또는 지분)의 과반을 쥐고 사슬을 다시 쓰는 공격. 2-07의 식에서 q ≥ 0.5에 해당한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch03/3-01_pow-vs-pos.html#lv2"

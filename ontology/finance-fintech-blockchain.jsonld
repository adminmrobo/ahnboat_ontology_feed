  {
   "@id": "lab:method/collusion-count",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "과반 담합 수 세기",
     "@language": "ko"
    },
    {
     "@value": "counting colluders for majority",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "몫이 큰 순서로 더해 50%를 넘는 최소 채굴자 수를 구하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

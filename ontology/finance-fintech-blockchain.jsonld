    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/beta-error"
    },
    {
     "@id": "lab:metric/false-reject"
    }
   ]
  },
  {
   "@id": "lab:term/ssr",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "잔차제곱합(SSR)",
     "@language": "ko"
    },
    {
     "@value": "ssr",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "회귀선으로 설명하지 못한 부분(잔차)을 제곱해 더한 값. 작을수록 잘 맞는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch2/2-4_periods-chow.html#lv2"

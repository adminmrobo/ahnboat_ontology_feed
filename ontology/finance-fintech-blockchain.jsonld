    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "논스",
     "@language": "ko"
    },
    {
     "@value": "nonce",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "'일회성 숫자'. 채굴할 때 해시가 목표보다 작아질 때까지 바꿔 가며 넣는 값.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

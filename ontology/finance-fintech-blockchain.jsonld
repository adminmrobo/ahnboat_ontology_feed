   "@type": [
    "skos:Concept",
    "lab:Dataset"
   ],
   "skos:prefLabel": [
    {
     "@value": "레버리지 모의 시장 (설명용)",
     "@language": "ko"
    },
    {
     "@value": "simulated TGARCH market",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "TGARCH 규칙으로 만든 가짜 수익률. 하락 뒤 분산이 더 커진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-6_asymmetry-decomposition.html#lv1"
   }
  },
  {
   "@id": "lab:concept/volatility-index",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "변동성 지수",
     "@language": "ko"
    },
    {
     "@value": "volatility index",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "옵션 가격에 내재된 기초자산의 향후 30일 기대 변동성을 연율 %로 나타낸 지수.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-7_volatility-index.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/fair-variance-swap"
    }
   ]
  },
  {
   "@id": "lab:concept/vix",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "VIX",
     "@language": "ko"
    },
    {
     "@value": "vix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "S&P500 지수옵션으로 산출하는 미국의 변동성 지수. 1993년 CBOE가 시작. 투자자 공포지수로 불린다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-7_volatility-index.html#lv1"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/volatility-index"
    }
   ]
  },
  {
   "@id": "lab:concept/implied-volatility",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "내재변동성",
     "@language": "ko"
    },
    {
     "@value": "implied volatility",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "옵션의 시장가격을 옵션 가격 모형에 넣어 거꾸로 풀어낸 변동성.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_00_Korean_stockmarket_volatility_study/ch1/1-7_volatility-index.html#lv1"

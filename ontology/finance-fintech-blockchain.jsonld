  {
   "@id": "lab:method/cost-driven-concentration",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "단가 차이에 따른 계산력 쏠림 모형",
     "@language": "ko"
    },
    {
     "@value": "cost-driven concentration model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "해마다 수익과 단가를 비교해 채굴자가 남거나 떠나거나 장비를 늘리는 모형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

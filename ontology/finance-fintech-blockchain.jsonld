    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "난이도 조정 (이동 평균)",
     "@language": "ko"
    },
    {
     "@value": "difficulty retargeting",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "지난 블록들의 평균 간격을 보고 다음 난이도를 정해 블록 간격을 목표에 맞추는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/blockchain_finance_ch02/2-07_difficulty-and-confirmation.html#lv1"

     "@id": "lab:method/lstm"
    }
   ]
  },
  {
   "@id": "lab:method/viterbi-path",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "HMM 최적 경로 디코딩",
     "@language": "ko"
    },
    {
     "@value": "Optimal Path Decoding",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "비테르비 알고리즘을 통해 관측 시퀀스로부터 가장 확률 높은 은닉 상태 경로를 추론.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/my_article_02_crypto_predict_model_analytics/01_crypto_timeseries.html#sec-path"
   }
  },
  {
   "@id": "lab:concept/emh-weak-form",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "약형 효율적 시장",
     "@language": "ko"
    },
    {
     "@value": "weak-form efficiency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "과거 가격 정보가 이미 반영돼 과거 가격으로 미래를 예측할 수 없다는 형태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ]
  },
  {
   "@id": "lab:concept/rule-based",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "규칙 기반",
     "@language": "ko"
    },
    {
     "@value": "Rule-based system",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사람(또는 진화)이 미리 규칙을 써 두는 방식. 설명은 쉽지만 환경이 바뀌면 직접 고쳐야 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/AI_Model_Review_Fruit_fly_special/1_fruitfly_brain_deep_learning.html#rule"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/rule-vs-learning"
    }
   ],
   "lab:contrastsWith": [
    {
     "@id": "lab:concept/learning-based"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/machine-learning"
    }
   ]
  },
  {
   "@id": "lab:concept/learning-based",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "학습 기반",
     "@language": "ko"
    },
    {
     "@value": "Learning-based system",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "예시와 결과만 주고 예상이 틀린 만큼 가중치를 고쳐 규칙을 스스로 찾게 하는 방식.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/AI_Model_Review_Fruit_fly_special/1_fruitfly_brain_deep_learning.html#rule"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/rule-vs-learning"
    },
    {
     "@id": "lab:topic/supervised-learning"
    }
   ],

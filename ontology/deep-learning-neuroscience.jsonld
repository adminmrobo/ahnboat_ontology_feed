   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "코호넨 네트워크",
     "@language": "ko"
    },
    {
     "@value": "Kohonen Network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "정답 없이 비슷한 입력끼리 지도 위 가까운 칸에 모이게 정리한다(자기조직화 지도).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

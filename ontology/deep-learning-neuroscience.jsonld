   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "어텐션",
     "@language": "ko"
    },
    {
     "@value": "attention",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 위치끼리 관련 점수를 매기고 그 점수만큼 정보를 섞는 계산. 이름만 사람의 주의에서 빌렸다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

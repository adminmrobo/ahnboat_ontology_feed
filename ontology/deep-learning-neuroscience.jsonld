   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "행렬곱",
     "@language": "ko"
    },
    {
     "@value": "matrix multiplication",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "(m,n)(n,p)→(m,p). 가운데 축 n이 축약된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

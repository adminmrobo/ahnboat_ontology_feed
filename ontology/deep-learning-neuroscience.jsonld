    }
   ]
  },
  {
   "@id": "lab:term/backpropagation",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "역전파",
     "@language": "ko"
    },
    {
     "@value": "backpropagation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "출력의 오차를 거꾸로 흘려 각 가중치를 얼마나 고칠지 계산하는 방법. 초파리 뇌는 쓰지 않는 것으로 여겨진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#a5"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/backpropagation"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/neural-network-architecture"
    }
   ]
  },
  {

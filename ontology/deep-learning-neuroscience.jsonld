     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "합류 뉴런을 타고난 입력 × 1.0 + 학습된 입력 × 0.6을 더하는 유닛 하나로 둔 설명용 장난감 모형.",
    "@language": "ko"
   },

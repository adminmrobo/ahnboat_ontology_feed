    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/neural-network-architecture"
    }
   ]
  },
  {
   "@id": "lab:term/convolution",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "합성곱",
     "@language": "ko"
    },
    {
     "@value": "convolution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작은 창(커널)을 이미지 위로 밀며 같은 가중치로 이웃 픽셀을 묶어 계산하는 연산.",
    "@language": "ko"

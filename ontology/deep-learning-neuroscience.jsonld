   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "시간을 기억하는 망",
     "@language": "ko"
    },
    {
     "@value": "recurrent networks",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞 시점의 상태를 다음 시점에 다시 넣는다. 순서가 있는 데이터를 다룬다.",
    "@language": "ko"
   },

   ],
   "skos:prefLabel": [
    {
     "@value": "망각 게이트",
     "@language": "ko"
    },
    {
     "@value": "Forget gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "옛 기억을 얼마나 남길지 정하는 문. 1에 가까우면 유지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/deep_learning_model_design_lab_01/04_lstm.html#spec"

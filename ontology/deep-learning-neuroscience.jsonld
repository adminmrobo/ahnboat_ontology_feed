     "@value": "Inhibitory connections",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "음수 가중치. 쓴맛 브레이크처럼 다른 경로를 끈다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

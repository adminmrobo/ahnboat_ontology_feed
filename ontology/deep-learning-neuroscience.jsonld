  {
   "@id": "lab:concept/atlas-a5",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "합성곱 신경망",
     "@language": "ko"
    },
    {
     "@value": "합성곱 신경망",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "분홍 커널이 작은 창을 밀며 이웃한 픽셀끼리만 묶어 봅니다. 같은 창을 화면 전체에 다시 씁니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#a5"
   },
   "lab:broader": [

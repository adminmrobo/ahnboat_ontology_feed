  {
   "@id": "lab:concept/activation-inspection",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "활성값 관찰",
     "@language": "ko"
    },
    {
     "@value": "Activation inspection",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "중간 층의 활성값 변화를 관찰한다. 변화만으로 학습 위치를 단정할 수는 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

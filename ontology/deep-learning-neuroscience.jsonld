     "@value": "볼츠만 머신",
     "@language": "ko"
    },
    {
     "@value": "Boltzmann Machine",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "홉필드에 확률적 은닉 셀을 더했다. 데이터의 확률분포 자체를 배우려 한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#m-boltzmann-machine"

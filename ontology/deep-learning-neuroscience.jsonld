     "@id": "lab:concept/energy-networks"
    }
   ]
  },
  {
   "@id": "lab:method/ntm",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "신경 튜링 머신",
     "@language": "ko"
    },
    {
     "@value": "Neural Turing Machine",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "신경망에 외부 메모리(아래 파란 셀)를 붙여 어텐션으로 읽고 쓰게 했다. 알고리즘을 배우려는 시도다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

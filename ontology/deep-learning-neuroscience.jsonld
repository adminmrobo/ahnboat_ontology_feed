  {
   "@id": "lab:concept/sense-nerve-brain-action",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "감각기관 → 신경 → 뇌 → 행동",
     "@language": "ko"
    },
    {
     "@value": "Sense → nerve → brain → action",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "초파리의 네 단계는 신경망의 입력층 → 전처리·첫 층 → 은닉층 → 출력층과 일대일로 맞는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/AI_Model_Review_Fruit_fly_special/1_fruitfly_brain_deep_learning.html#map"
   },

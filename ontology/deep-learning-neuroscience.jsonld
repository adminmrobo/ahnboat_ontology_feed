   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "역합성곱 신경망",
     "@language": "ko"
    },
    {
     "@value": "Deconvolutional Network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "DCN을 거꾸로 돌린다. 작은 정보에서 큰 이미지를 펼쳐 낸다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#m-deconv-net"
   },
   "lab:broader": [

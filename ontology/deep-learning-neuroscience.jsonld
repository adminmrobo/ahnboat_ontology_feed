  {
   "@id": "lab:concept/filter",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "필터(커널)",
     "@language": "ko"
    },
    {
     "@value": "Filter (kernel)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "3×3 같은 작은 숫자 판. 그림 위를 밀며 곱해 더한다.",
    "@language": "ko"
   },

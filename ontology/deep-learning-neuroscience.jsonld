     "@id": "lab:concept/neural-network-architecture"
    }
   ]
  },
  {
   "@id": "lab:method/lsm",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "액체 상태 기계",
     "@language": "ko"
    },
    {
     "@value": "Liquid State Machine",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "스파이크를 내는 셀을 무작위로 엉성하게 연결해 두고, 출력층만 학습한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#m-lsm"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/atlas-a6"
    },
    {
     "@id": "lab:concept/brain-networks"
    }
   ]
  },
  {
   "@id": "lab:method/elm",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "극단 학습 기계",
     "@language": "ko"
    },
    {
     "@value": "Extreme Learning Machine",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "은닉층 가중치를 무작위로 정해 고정하고, 출력층만 한 번에 계산해서 끝낸다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#m-elm"
   },

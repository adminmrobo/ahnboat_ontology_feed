    }
   ]
  },
  {
   "@id": "lab:method/hopfield-network",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "홉필드 네트워크",
     "@language": "ko"
    },
    {
     "@value": "Hopfield Network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 셀이 서로 연결되어 저장된 패턴 쪽으로 스스로 굴러간다. 연상 기억 장치다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

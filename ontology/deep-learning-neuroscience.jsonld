   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "가중치",
     "@language": "ko"
    },
    {
     "@value": "weight",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "입력 신호에 곱하는 숫자. 클수록 그 입력을 더 중요하게 본다. 초파리로 치면 시냅스 전달 세기에 해당한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#guide"

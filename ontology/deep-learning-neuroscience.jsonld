   ],
   "skos:prefLabel": [
    {
     "@value": "커넥톰",
     "@language": "ko"
    },
    {
     "@value": "connectome",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "뇌의 뉴런과 시냅스 연결을 모두 적은 배선도. 구조일 뿐, 시냅스 세기와 뉴런 성질은 따로 필요하다.",
    "@language": "ko"

     "@value": "Feedforward neural network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "입력에서 출력으로 한 방향으로만 신호가 흐르는 신경망. 순환이 없다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

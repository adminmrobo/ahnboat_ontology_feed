   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "풀링",
     "@language": "ko"
    },
    {
     "@value": "Pooling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작은 구역의 대표값(최댓값·평균)만 남겨 크기를 줄인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

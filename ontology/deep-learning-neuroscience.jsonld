   "@id": "lab:concept/update-gate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "업데이트 게이트",
     "@language": "ko"
    },
    {
     "@value": "Update gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "옛 메모와 새 후보를 섞는 비율 z_t.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/deep_learning_model_design_lab_01/05_gru.html#math"

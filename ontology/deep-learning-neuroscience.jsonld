    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "에너지·확률 기반 모델",
     "@language": "ko"
    },
    {
     "@value": "에너지·확률 기반 모델",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "층 구분 없이 서로 연결되거나, 확률적으로 켜지고 꺼지는 셀을 씁니다. 딥러닝 초창기의 주역입니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#a4"

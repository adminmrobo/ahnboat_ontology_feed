   ]
  },
  {
   "@id": "lab:method/matvec",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "행렬 × 벡터",
     "@language": "ko"
    },
    {
     "@value": "matrix-vector product",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "y = Ax. x의 축이 A의 둘째 축과 축약된다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/what_is_tensor/03_tensor_ops.html#lv2"

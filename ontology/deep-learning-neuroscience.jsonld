   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "에코 상태 네트워크",
     "@language": "ko"
    },
    {
     "@value": "Echo State Network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "무작위로 연결된 순환 셀 덩어리(저수지)를 고정해 두고 출력층만 학습하는 RNN.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

  {
   "@id": "lab:concept/prediction-error-update",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "예측 오차 갱신",
     "@language": "ko"
    },
    {
     "@value": "Prediction-error update",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "값 ← 값 + η × (결과 − 예상). 예상이 틀린 만큼 고친다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

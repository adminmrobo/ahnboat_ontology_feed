     "@id": "lab:concept/atlas-a5"
    },
    {
     "@id": "lab:concept/convolution-networks"
    }
   ]
  },
  {
   "@id": "lab:concept/atlas-a6",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "생성·특수 구조",
     "@language": "ko"
    },
    {
     "@value": "생성·특수 구조",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "학습 방식이나 연결 방식이 독특한 구조들입니다. 원본 차트에서 한 묶음으로 실렸습니다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#a6"
   },
   "lab:broader": [

   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "필요한 곳을 직접 보는 망",
     "@language": "ko"
    },
    {
     "@value": "attention networks",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 위치가 서로를 얼마나 참고할지 점수를 매겨, 먼 곳도 한 번에 본다.",

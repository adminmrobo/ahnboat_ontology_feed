    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "공간을 보는 망",
     "@language": "ko"
    },
    {
     "@value": "convolution networks",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작은 창으로 이웃한 픽셀끼리만 묶어 본다. 같은 창을 화면 전체에 재사용한다.",

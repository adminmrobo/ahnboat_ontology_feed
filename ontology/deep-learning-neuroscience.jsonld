    }
   ]
  },
  {
   "@id": "lab:method/dcn",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "깊은 합성곱 신경망",
     "@language": "ko"
    },
    {
     "@value": "Deep Convolutional Network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "작은 창(커널)으로 이미지를 훑어 선, 모양, 물체 순으로 특징을 쌓은 뒤 분류한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/neural_network_atlas/1_neural_network_atlas_chart.html#m-dcn"
   },
   "lab:broader": [
    {
     "@id": "lab:concept/atlas-a5"
    },
    {
     "@id": "lab:concept/convolution-networks"
    }
   ]
  },
  {

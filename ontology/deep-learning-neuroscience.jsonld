    }
   ]
  },
  {
   "@id": "lab:concept/reset-gate",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "리셋 게이트",
     "@language": "ko"
    },
    {
     "@value": "Reset gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 후보를 만들 때 옛 메모를 얼마나 참고할지 정하는 r_t.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

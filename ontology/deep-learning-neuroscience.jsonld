   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "셀 상태",
     "@language": "ko"
    },
    {
     "@value": "Cell state",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "시점을 따라 흐르는 긴 기억. 곱하기(망각)와 더하기(새 내용)로만 바뀐다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/deep_learning_model_design_lab_01/04_lstm.html#math"

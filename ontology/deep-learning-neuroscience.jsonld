    }
   ]
  },
  {
   "@id": "lab:method/dcign",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "합성곱 역그래픽스망",
     "@language": "ko"
    },
    {
     "@value": "Deep Convolutional Inverse Graphics Network",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "합성곱 인코더 + 확률 잠재층 + 역합성곱 디코더. 사실상 이미지용 VAE다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

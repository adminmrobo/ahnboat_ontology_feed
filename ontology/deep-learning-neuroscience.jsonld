   ],
   "skos:prefLabel": [
    {
     "@value": "게이트",
     "@language": "ko"
    },
    {
     "@value": "Gate",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "0~1 사이 값(시그모이드)으로 정보를 얼마나 통과시킬지 정하는 문.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

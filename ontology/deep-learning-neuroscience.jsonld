   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "앞 층 가중치가 바뀌면 뒤 층 활성값도 바뀐다",
     "@language": "ko"
    },
    {
     "@value": "Upstream weight change shifts downstream activations",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "중간 층 W2만 파인튜닝해도 같은 입력에 대한 그 뒤 층의 활성값이 모두 달라진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/AI_Model_Review_Fruit_fly_special/2_fruitfly_memory_retrieval_paper.html#p4"

  {
   "@id": "lab:concept/dales-law",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "데일의 법칙 (부호는 신경전달물질에서)",
     "@language": "ko"
    },
    {
     "@value": "Dale's principle",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 뉴런의 출력은 모두 같은 부호다. 아세틸콜린 등은 흥분, GABA·글루탐산·히스타민은 억제로 정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

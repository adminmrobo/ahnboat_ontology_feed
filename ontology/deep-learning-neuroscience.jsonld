     "@language": "ko"
    },
    {
     "@value": "Hidden state",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "지금까지 읽은 것을 요약한 64칸짜리 숫자 묶음 h. 걸음마다 새로 계산되어 덮어써진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

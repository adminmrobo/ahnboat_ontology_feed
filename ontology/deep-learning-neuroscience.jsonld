   ],
   "skos:prefLabel": [
    {
     "@value": "시점 간 가중치 공유",
     "@language": "ko"
    },
    {
     "@value": "Weights shared across time",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 시점에 같은 가중치를 쓴다. 길이가 달라도 같은 부품으로 읽는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

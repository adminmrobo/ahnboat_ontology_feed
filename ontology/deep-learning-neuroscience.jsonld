    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "원소별 연산과 브로드캐스트",
     "@language": "ko"
    },
    {
     "@value": "element-wise ops and broadcasting",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 자리끼리 계산하고, 모양이 다르면 뒤 축부터 맞춰 늘려 붙인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

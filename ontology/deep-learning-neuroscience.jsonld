   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "위치 정보",
     "@language": "ko"
    },
    {
     "@value": "Positional encoding",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한꺼번에 보느라 잃는 순서 정보를 숫자로 더해 주는 장치.",
    "@language": "ko"

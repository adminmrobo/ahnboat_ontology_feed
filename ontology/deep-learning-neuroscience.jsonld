   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "손실함수",
     "@language": "ko"
    },
    {
     "@value": "loss function",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모델이 얼마나 틀렸는지를 숫자 하나로 재는 함수. 학습은 이 값을 줄이는 과정이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

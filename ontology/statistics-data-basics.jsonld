   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "집계와 그룹",
     "@language": "ko"
    },
    {
     "@value": "aggregation and grouping",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "집계 함수로 여러 행을 하나의 값으로 계산하고 GROUP BY·HAVING으로 그룹별 집계·조건을 거는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w10_sql_dml.html#lv2"

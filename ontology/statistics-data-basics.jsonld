  {
   "@id": "lab:concept/data-modeling",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "데이터 모델링",
     "@language": "ko"
    },
    {
     "@value": "data modeling",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "현실 세계의 정보를 목적에 맞게 추상화해 컴퓨터 세계의 데이터베이스로 옮기는 과정(개념·논리·물리).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w05_er_modeling.html#lv1"
   },
   "lab:prerequisiteOf": [

   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "희소행렬",
     "@language": "ko"
    },
    {
     "@value": "sparse matrix",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대부분이 빈칸(0)인 표. 채워진 칸만 저장해 메모리를 아낌.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv3"

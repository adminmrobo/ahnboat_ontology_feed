    }
   ]
  },
  {
   "@id": "lab:concept/recommendation-objective",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "추천의 목표 지표",
     "@language": "ko"
    },
    {
     "@value": "recommendation objective",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "추천 순위를 매길 때 최대로 하려는 값(클릭률, 시청시간, 다양성 등). 목표에 따라 추천 결과가 달라진다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/collaborative-filtering"
    }
   ]
  },
  {
   "@id": "lab:method/collaborative-filtering",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "협업 필터링",
     "@language": "ko"
    },
    {
     "@value": "collaborative filtering",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사용자-항목 평점표에서 취향이 닮은 사용자(또는 항목)를 찾아 비어 있는 평점을 예측하는 추천 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/bayesian-credit-scoring"
    }
   ]
  },
  {
   "@id": "lab:metric/support",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "지지도",
     "@language": "ko"
    },
    {
     "@value": "support",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "전체 거래 중 A와 B를 함께 산 비율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/association-rules"
    }
   ]
  },
  {
   "@id": "lab:metric/confidence",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "신뢰도",
     "@language": "ko"
    },
    {
     "@value": "confidence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "A를 산 거래 중 B도 산 비율. 조건부 확률 P(B|A).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/association-rules"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:metric/lift"
    }
   ]
  },
  {
   "@id": "lab:metric/lift",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "향상도",
     "@language": "ko"
    },
    {
     "@value": "lift",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "신뢰도 ÷ B의 평소 구매율. 1보다 크면 함께 사는 경향.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/association-rules"
    }
   ]
  },
  {
   "@id": "lab:term/filter-bubble",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "필터 버블",
     "@language": "ko"
    },
    {
     "@value": "filter bubble",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "알고리즘이 좋아할 만한 것만 보여 줘 시야가 좁아지는 현상.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/recommendation-objective"
    }
   ]
  },
  {
   "@id": "lab:metric/diversity",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "다양성",
     "@language": "ko"
    },
    {
     "@value": "diversity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "추천 목록이 얼마나 여러 분야를 담는지.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv2"
   },
   "lab:partOf": [

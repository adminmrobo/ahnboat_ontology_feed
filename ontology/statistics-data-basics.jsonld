    }
   ]
  },
  {
   "@id": "lab:method/lda",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "LDA 토픽 모델",
     "@language": "ko"
    },
    {
     "@value": "latent Dirichlet allocation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문서를 토픽의 혼합, 토픽을 단어 분포로 보고, 관찰한 단어로부터 문서-주제 분포 θ와 주제-단어 분포 φ를 추정하는 확률적 토픽 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/10_nlp_bayes.html#lv3"

     "@id": "lab:concept/log-based-recovery"
    }
   ]
  },
  {
   "@id": "lab:term/checkpoint",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "검사 시점",
     "@language": "ko"
    },
    {
     "@value": "checkpoint",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "일정 간격으로 로그와 버퍼 내용을 디스크에 반영해 두는 시점. 회복 작업을 줄인다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w13_transaction_recovery_concurrency.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/log-based-recovery"
    }
   ]
  },
  {
   "@id": "lab:term/lost-update",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "갱신 분실",
     "@language": "ko"
    },
    {
     "@value": "lost update",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 트랜잭션이 쓴 값을 다른 트랜잭션이 덮어써 첫 변경이 사라지는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w13_transaction_recovery_concurrency.html#lv4"
   },

    }
   ]
  },
  {
   "@id": "lab:concept/er-attribute-types",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "E-R 다이어그램의 속성",
     "@language": "ko"
    },
    {
     "@value": "attributes in the E-R model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "단순·복합·다중값·유도·키 속성과 그 ERD 기호.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w05_er_modeling.html#lv3"

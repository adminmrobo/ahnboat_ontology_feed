     "@value": "조인 검색과 부속 질의",
     "@language": "ko"
    },
    {
     "@value": "joins and subqueries",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "여러 표를 조인 속성으로 이어 검색하거나, 괄호 속 SELECT(부속 질의)의 결과로 상위 질의를 수행하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

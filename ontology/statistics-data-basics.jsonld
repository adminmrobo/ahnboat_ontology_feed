    }
   ]
  },
  {
   "@id": "lab:concept/data-independence",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "데이터 독립성",
     "@language": "ko"
    },
    {
     "@value": "data independence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 단계의 스키마가 바뀌어도 사상만 고쳐 위 단계가 영향을 받지 않게 하는 성질(논리적·물리적).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w04_database_system.html#lv3"
   },
   "lab:prerequisiteOf": [
    {

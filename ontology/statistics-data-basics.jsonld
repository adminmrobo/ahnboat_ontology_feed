    }
   ]
  },
  {
   "@id": "lab:method/naive-bayes",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "나이브 베이즈 분류기",
     "@language": "ko"
    },
    {
     "@value": "naive Bayes classifier",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "단어(특징)들이 분류 안에서 서로 독립이라고 가정하고, 사전 확률에 각 단어의 가능도를 곱해 분류하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch02/2-2_bayes_theorem.html#lv4"
   },

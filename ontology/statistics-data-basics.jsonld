   ],
   "skos:definition": {
    "@value": "카지노가 모든 베팅에서 장기적으로 가져가는 몫의 비율.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/01_what_is_statistics.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:theory/law-of-large-numbers"
    },
    {
     "@id": "lab:distribution/binomial"
    }
   ]
  },
  {
   "@id": "lab:distribution/binomial",
   "@type": [
    "skos:Concept",
    "lab:Distribution"
   ],
   "skos:prefLabel": [
    {
     "@value": "이항분포와 반복 시행",
     "@language": "ko"
    },
    {
     "@value": "binomial distribution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "n번 독립 시행에서 성공 확률 p인 사건이 k번 일어날 확률의 분포. P(X=k) = nCk p^k (1−p)^(n−k).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/discrete-distributions"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:theory/bayes-theorem"
    }
   ]
  },
  {
   "@id": "lab:concept/frequentist-probability",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "도수론적 관점",
     "@language": "ko"
    },
    {
     "@value": "frequentist view",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 조건으로 무한히 반복할 때의 상대빈도로 확률을 정의하는 관점.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/probability-rules"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/conditional-probability"
    }
   ]
  },
  {
   "@id": "lab:concept/subjective-probability",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "주관적 관점",
     "@language": "ko"
    },
    {
     "@value": "subjective (Bayesian) view",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "확률을 어떤 일에 대한 믿음의 정도로 보는 관점. 베이지안 통계의 출발점.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/prior-posterior"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/conditional-probability"
    }
   ]
  },
  {
   "@id": "lab:concept/prior-probability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "사전 확률",
     "@language": "ko"
    },
    {
     "@value": "prior probability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 정보를 보기 전의 확률. P(A)",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv1"
   },

    }
   ]
  },
  {
   "@id": "lab:theory/bayes-theorem",
   "@type": [
    "skos:Concept",
    "lab:Theory"
   ],
   "skos:prefLabel": [
    {
     "@value": "베이즈 정리",
     "@language": "ko"
    },
    {
     "@value": "Bayes' theorem",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사후 확률 = 가능도 × 사전 확률 ÷ 증거의 전체 확률. P(H|E) = P(E|H)P(H) / P(E).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/03_bayesian_thinking.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/bayes-theorem"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/naive-bayes"
    }
   ]
  },
  {
   "@id": "lab:method/sequential-bayesian-update",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "베이지안 순차 업데이트",
     "@language": "ko"
    },
    {
     "@value": "sequential Bayesian updating",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "앞 증거로 얻은 사후 확률을 다음 증거의 사전 확률로 쓰며 믿음을 차례로 고치는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/03_bayesian_thinking.html#lv3"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/prior-posterior"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/ab-test"
    }
   ]
  },
  {

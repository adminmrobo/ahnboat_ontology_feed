    },
    {
     "@value": "data modification and views",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "INSERT·UPDATE·DELETE로 데이터를 바꾸고, 뷰로 질의를 가상 테이블로 저장하며, 삽입 SQL로 프로그램에서 SQL을 쓰는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w10_sql_dml.html#lv4"
   }
  },

  {
   "@id": "lab:method/association-rules",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "연관 규칙 분석",
     "@language": "ko"
    },
    {
     "@value": "association rule mining",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "거래 기록에서 함께 나타나는 항목의 짝을 지지도·신뢰도·향상도로 찾는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv1"
   },

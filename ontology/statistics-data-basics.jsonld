   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "콘텐츠 기반",
     "@language": "ko"
    },
    {
     "@value": "content-based filtering",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "항목의 특징(장르·키워드)이 내가 좋아한 것과 비슷한 항목을 추천.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv3"
   },
   "lab:partOf": [

    }
   ]
  },
  {
   "@id": "lab:concept/requirements-analysis",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "요구사항 분석",
     "@language": "ko"
    },
    {
     "@value": "requirements analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "업무 문장에서 개체·속성·관계·제약 조건 후보를 찾아내는 일.",
    "@language": "ko"
   },

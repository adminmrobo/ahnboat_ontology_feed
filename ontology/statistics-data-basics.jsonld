     "@value": "database system components",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터베이스, DBMS, 사용자, 데이터 언어, 컴퓨터로 이루어진 시스템.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

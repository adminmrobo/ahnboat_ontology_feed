    }
   ]
  },
  {
   "@id": "lab:term/two-phase-locking",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "2단계 로킹",
     "@language": "ko"
    },
    {
     "@value": "two phase locking",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "lock만 하는 확장 단계 후 unlock만 하는 축소 단계로 나누는 로킹 규약. 직렬 가능성 보장.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w13_transaction_recovery_concurrency.html#lv4"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/concurrency-locking"
    }
   ]
  },
  {
   "@id": "lab:term/select-for-update",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "FOR UPDATE",
     "@language": "ko"
    },
    {
     "@value": "select for update",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "읽은 행에 쓰기 잠금을 걸어 트랜잭션이 끝날 때까지 다른 세션이 고치지 못하게 하는 문장.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w13_transaction_recovery_concurrency.html#lv5"
   },
   "lab:partOf": [

  },
  {
   "@id": "lab:concept/three-schema-architecture",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "3단계 데이터베이스 구조",
     "@language": "ko"
    },
    {
     "@value": "three-schema architecture",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터베이스를 외부·개념·내부 세 단계 관점으로 나누어 정의한 구조.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w04_database_system.html#lv2"
   },
   "lab:prerequisiteOf": [

    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "유병률",
     "@language": "ko"
    },
    {
     "@value": "prevalence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "집단 안에서 그 질병을 가진 사람의 비율. 진단의 사전 확률.",
    "@language": "ko"

  {
   "@id": "lab:concept/data-redundancy",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "데이터 중복",
     "@language": "ko"
    },
    {
     "@value": "data redundancy in file systems",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 데이터가 여러 파일에 저장되어, 통제하지 않으면 값이 서로 달라지는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

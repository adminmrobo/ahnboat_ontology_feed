     "@value": "귀무가설",
     "@language": "ko"
    },
    {
     "@value": "null hypothesis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차이가 없다는 기본 가정. 검정은 이것을 버릴 증거가 있는지 묻는다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch05/3-1_hypothesis_testing.html#lv3"

    },
    {
     "@value": "specificity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "실제 없을 때 음성으로 판정하는 비율. TN ÷ (TN+FP)",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

    }
   ]
  },
  {
   "@id": "lab:term/deadlock",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "교착 상태",
     "@language": "ko"
    },
    {
     "@value": "deadlock",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "트랜잭션들이 서로의 잠금 해제를 무한히 기다리는 상태.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w13_transaction_recovery_concurrency.html#lv4"
   },
   "lab:partOf": [

  {
   "@id": "lab:concept/select-statement",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "SELECT 문",
     "@language": "ko"
    },
    {
     "@value": "select statement",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "SELECT·FROM·WHERE·ORDER BY로 조건에 맞는 행과 칸을 골라 정렬해 보여 주는 질의.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

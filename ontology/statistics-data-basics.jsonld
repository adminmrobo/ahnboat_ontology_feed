     "@language": "ko"
    },
    {
     "@value": "central tendency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 값의 합 ÷ 개수. 이상치에 끌려간다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

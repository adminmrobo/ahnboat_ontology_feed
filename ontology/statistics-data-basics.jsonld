   ],
   "skos:prefLabel": [
    {
     "@value": "확증편향",
     "@language": "ko"
    },
    {
     "@value": "confirmation bias",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자기 생각에 맞는 정보만 골라 믿는 경향.",
    "@language": "ko"

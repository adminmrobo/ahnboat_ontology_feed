     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 안의 전환율 사후분포로 P(B>A)와 기대 개선을 계산하고, 남은 위험에 맞춰 적용 범위를 단계적으로 넓히는 의사결정 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

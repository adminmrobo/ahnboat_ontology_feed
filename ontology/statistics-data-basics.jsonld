     "@id": "lab:concept/3nf-bcnf"
    }
   ]
  },
  {
   "@id": "lab:metric/db_w12",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "한 달 작업 비용 (건드리는 행 수, 설명용 모형 · 적을수록 이김)",
     "@language": "ko"
    },
    {
     "@value": "duel metric",
     "@language": "en"
    }
   ],
   "rdfs:isDefinedBy": {

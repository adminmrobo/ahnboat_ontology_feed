     "@id": "lab:method/sequential-bayesian-update"
    }
   ]
  },
  {
   "@id": "lab:concept/confidence-interval",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "신뢰구간",
     "@language": "ko"
    },
    {
     "@value": "confidence interval",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "같은 방법으로 반복하면 그중 약 95%가 참값을 포함하는 구간(빈도주의). \"이 구간에 참값이 있을 확률 95%\"로 읽지 않음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch04/2-1a_point_interval.html#lv4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/confidence-interval"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/diagnostic-uncertainty"
    }
   ]
  },
  {
   "@id": "lab:concept/power",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "검정력",
     "@language": "ko"
    },
    {
     "@value": "statistical power",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "진짜 효과가 있을 때 그것을 잡아낼 확률(보통 80%).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch05/3-1_hypothesis_testing.html#lv6"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/statistical-power"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:method/bayesian-ab-rollout"
    }
   ]
  },
  {
   "@id": "lab:concept/p-value",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "p값",
     "@language": "ko"
    },
    {
     "@value": "p-value",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차이가 없다고 가정할 때 이만큼 또는 더 극단적인 결과가 나올 확률. 가설이 참일 확률이 아님.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch05/3-1_hypothesis_testing.html#lv5"

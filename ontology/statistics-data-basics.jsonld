  {
   "@id": "lab:concept/requirements-specification",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "요구 사항 명세",
     "@language": "ko"
    },
    {
     "@value": "requirements specification",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터베이스의 용도와 사용자 요구를 분석해 유지할 데이터와 규칙을 문장으로 정리한 문서.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv1"
   },
   "lab:prerequisiteOf": [

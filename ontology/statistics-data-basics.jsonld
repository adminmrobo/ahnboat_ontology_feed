   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "코사인 유사도",
     "@language": "ko"
    },
    {
     "@value": "cosine similarity",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 벡터의 방향이 얼마나 같은지. 1이면 같음, 0이면 무관.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/05_recommender.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:method/collaborative-filtering"
    }
   ]
  },

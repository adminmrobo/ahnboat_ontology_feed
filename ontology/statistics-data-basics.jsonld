    }
   ],
   "lab:motivates": [
    {
     "@id": "lab:concept/bayes"
    }
   ]
  },
  {
   "@id": "lab:concept/correlation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "상관계수",
     "@language": "ko"
    },
    {
     "@value": "correlation coefficient",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 값이 함께 움직이는 정도. −1(반대로)~+1(똑같이).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch01/1-1_what_is_statistics.html#lv7"
   },
   "lab:topic": [

     "@language": "ko"
    },
    {
     "@value": "join operations",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "공통 속성의 값으로 두 릴레이션의 튜플을 잇는 연산(세타·동등·자연·외부·세미 조인).",

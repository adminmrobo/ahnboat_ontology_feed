    },
    {
     "@id": "lab:theory/bayes-theorem"
    },
    {
     "@id": "lab:method/bayesian-credit-scoring"
    }
   ]
  },
  {
   "@id": "lab:concept/posterior-probability",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "사후 확률",
     "@language": "ko"
    },
    {
     "@value": "posterior probability",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "새 정보를 반영해 고친 확률. P(A|B)",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv1"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/prior-posterior"
    },
    {
     "@id": "lab:topic/probability-statistics"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/conditional-probability"
    },
    {
     "@id": "lab:theory/bayes-theorem"
    }
   ]
  },
  {
   "@id": "lab:concept/dependence",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "종속",
     "@language": "ko"
    },
    {
     "@value": "dependence",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 사건이 다른 사건의 확률을 바꾸는 관계. 예: 돌려놓지 않는 카드 뽑기",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/independence"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/independence"
    }
   ]
  },
  {
   "@id": "lab:concept/mutually-exclusive",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "배반",
     "@language": "ko"
    },
    {
     "@value": "mutually exclusive",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 사건이 동시에 일어날 수 없는 관계. P(A∩B) = 0",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/probability-rules"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/independence"
    }
   ]
  },
  {
   "@id": "lab:concept/gamblers-fallacy",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "도박꾼의 오류",
     "@language": "ko"
    },
    {
     "@value": "gambler's fallacy",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "독립 시행에서 한쪽 결과가 연속되면 반대 결과가 \"나올 차례\"라고 믿는 착각.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/02_probability.html#lv3"
   },

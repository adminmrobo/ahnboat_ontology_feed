  {
   "@id": "lab:method/tf-idf",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "TF-IDF",
     "@language": "ko"
    },
    {
     "@value": "term frequency-inverse document frequency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문서 안 단어 빈도(TF)에 전체 문서에서의 희귀도(IDF = log(N ÷ df))를 곱해 문서별 단어 중요도를 매기는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/10_nlp_bayes.html#lv1"
   },
   "lab:partOf": [

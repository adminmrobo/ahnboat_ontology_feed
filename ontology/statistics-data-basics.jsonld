     "@id": "lab:concept/conceptual-design"
    }
   ]
  },
  {
   "@id": "lab:concept/conceptual-design",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "개념적 설계",
     "@language": "ko"
    },
    {
     "@value": "conceptual design",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "요구 사항 명세에서 개체·속성·관계를 추출해 DBMS와 무관한 E-R 다이어그램(개념적 스키마)을 만드는 단계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/er-to-relational-mapping"
    }
   ]
  },
  {
   "@id": "lab:concept/er-to-relational-mapping",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "E-R 다이어그램의 릴레이션 변환",
     "@language": "ko"
    },
    {
     "@value": "er to relational mapping",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "개체, N:M·1:N·1:1 관계, 다중값 속성을 릴레이션 스키마로 바꾸는 다섯 가지 규칙.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/physical-design-implementation"
    }
   ]
  },
  {
   "@id": "lab:concept/physical-design-implementation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "물리적 설계와 구현",
     "@language": "ko"
    },
    {
     "@value": "physical design and implementation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자료형·제약·색인 등 물리적 구조를 정하고(물리적 설계) SQL로 실제 데이터베이스를 만드는 것(구현).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv4"
   }
  },
  {
   "@id": "lab:term/requirements-document",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "요구 사항 명세서",
     "@language": "ko"
    },
    {
     "@value": "requirements document",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "요구 사항 분석의 결과물. 데이터베이스가 유지해야 할 데이터와 규칙을 문장으로 정리한 문서.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/requirements-specification"
    }
   ]
  },
  {
   "@id": "lab:term/conceptual-design-phase",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "개념적 설계",
     "@language": "ko"
    },
    {
     "@value": "conceptual design phase",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "DBMS와 무관하게 E-R 다이어그램으로 개념적 스키마를 만드는 단계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/conceptual-design"
    }
   ]
  },
  {
   "@id": "lab:term/logical-design-phase",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "논리적 설계",
     "@language": "ko"
    },
    {
     "@value": "logical design phase",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "개념적 스키마를 DBMS에 맞는 논리적 스키마(릴레이션 스키마)로 바꾸는 단계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/er-to-relational-mapping"
    }
   ]
  },
  {
   "@id": "lab:term/physical-design-phase",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "물리적 설계",
     "@language": "ko"
    },
    {
     "@value": "physical design phase",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "자료형·색인·저장 구조 등 실제 DBMS에서 구현할 물리적 구조를 정하는 단계.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv4"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/physical-design-implementation"
    }
   ]
  },
  {
   "@id": "lab:term/mapping-rules",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "변환 규칙",
     "@language": "ko"
    },
    {
     "@value": "mapping rules",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "개체, N:M, 1:N, 1:1, 다중값 속성을 릴레이션으로 바꾸는 다섯 규칙.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/er-to-relational-mapping"
    }
   ]
  },
  {
   "@id": "lab:method/db_w11-fly",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "5단계를 거친 뒤 한 번에 생성",
     "@language": "ko"
    },
    {
     "@value": "option A (fly)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문장을 다 읽고 그림부터 그려. 그래야 고칠 일이 없어.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#duel"
   },
   "lab:contrastsWith": [
    {
     "@id": "lab:method/db_w11-robo"
    }
   ],
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/db_w11"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/physical-design-implementation"
    }
   ]
  },
  {
   "@id": "lab:method/db_w11-robo",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "문장마다 바로 CREATE · ALTER",
     "@language": "ko"
    },
    {
     "@value": "option B (jupanbot)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "읽으면서 바로 치는 게 빠르지! 고치면 되잖아!",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#duel"
   },
   "lab:evaluatedBy": [
    {
     "@id": "lab:metric/db_w11"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/physical-design-implementation"
    }
   ]
  },
  {
   "@id": "lab:metric/db_w11",
   "@type": [
    "skos:Concept",
    "lab:Metric"
   ],
   "skos:prefLabel": [
    {
     "@value": "완성까지의 구조 변경 횟수 (적을수록 이김)",
     "@language": "ko"
    },
    {
     "@value": "duel metric",
     "@language": "en"
    }
   ],
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w11_database_design_process.html#duel"
   }
  },
  {
   "@id": "lab:concept/anomalies",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이상 현상",
     "@language": "ko"
    },
    {
     "@value": "anomalies",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "불필요한 중복 때문에 삽입·갱신·삭제할 때 생기는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/functional-dependency"
    }
   ]
  },
  {
   "@id": "lab:concept/functional-dependency",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "함수 종속",
     "@language": "ko"
    },
    {
     "@value": "functional dependency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "속성 X의 값이 속성 Y의 값을 하나로 결정하는 관계(X → Y). 완전·부분·이행 종속.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/1nf-2nf"
    }
   ]
  },
  {
   "@id": "lab:concept/1nf-2nf",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "제1·제2정규형",
     "@language": "ko"
    },
    {
     "@value": "first and second normal form",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "원자값만 갖는 1NF와, 부분 함수 종속을 제거한 2NF.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/3nf-bcnf"
    }
   ]
  },
  {
   "@id": "lab:concept/3nf-bcnf",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "제3정규형과 BCNF",
     "@language": "ko"
    },
    {
     "@value": "third normal form and bcnf",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "이행 종속을 제거한 3NF와 모든 결정자가 후보키인 BCNF, 그리고 성능을 위한 반정규화.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv4"
   }
  },
  {
   "@id": "lab:term/insertion-anomaly",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "삽입 이상",
     "@language": "ko"
    },
    {
     "@value": "insertion anomaly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터를 넣을 때 원하지 않는 다른 데이터까지 함께 넣어야 하는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/anomalies"
    }
   ]
  },
  {
   "@id": "lab:term/update-anomaly",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "갱신 이상",
     "@language": "ko"
    },
    {
     "@value": "update anomaly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "중복된 데이터 중 일부만 수정되어 불일치가 생기는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/anomalies"
    }
   ]
  },
  {
   "@id": "lab:term/deletion-anomaly",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "삭제 이상",
     "@language": "ko"
    },
    {
     "@value": "deletion anomaly",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "데이터를 지울 때 지우면 안 되는 다른 데이터까지 함께 사라지는 문제.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv1"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/anomalies"
    }
   ]
  },
  {
   "@id": "lab:term/determinant",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "결정자",
     "@language": "ko"
    },
    {
     "@value": "determinant",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "함수 종속 X → Y에서 X. 값 하나가 Y의 값 하나를 결정한다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/functional-dependency"
    }
   ]
  },
  {
   "@id": "lab:term/partial-dependency",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "부분 함수 종속",
     "@language": "ko"
    },
    {
     "@value": "partial dependency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기본키의 일부에만 종속되는 것. 2NF에서 제거.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/functional-dependency"
    }
   ]
  },
  {
   "@id": "lab:term/transitive-dependency",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "이행 함수 종속",
     "@language": "ko"
    },
    {
     "@value": "transitive dependency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "X → Y, Y → Z일 때 X → Z. 3NF에서 제거.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv2"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/functional-dependency"
    }
   ]
  },
  {
   "@id": "lab:term/first-normal-form",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "제1정규형",
     "@language": "ko"
    },
    {
     "@value": "first normal form",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 속성 값이 원자값인 정규형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/1nf-2nf"
    }
   ]
  },
  {
   "@id": "lab:term/second-normal-form",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "제2정규형",
     "@language": "ko"
    },
    {
     "@value": "second normal form",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "1NF이면서 부분 함수 종속이 없는 정규형.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv3"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/1nf-2nf"
    }
   ]
  },
  {
   "@id": "lab:term/bcnf",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "BCNF",
     "@language": "ko"
    },
    {
     "@value": "bcnf",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 결정자가 후보키인 정규형(보이스-코드 정규형).",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv4"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/3nf-bcnf"
    }
   ]
  },
  {
   "@id": "lab:term/lossless-decomposition",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "무손실 분해",
     "@language": "ko"
    },
    {
     "@value": "lossless decomposition",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "분해한 표들을 다시 조인하면 원래 표와 정확히 같아지는 분해.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv4"
   },
   "lab:partOf": [
    {
     "@id": "lab:concept/3nf-bcnf"
    }
   ]
  },
  {
   "@id": "lab:term/denormalization",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "반정규화",
     "@language": "ko"
    },
    {
     "@value": "denormalization",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "성능을 위해 정규화한 표를 일부러 합치거나 중복을 허용하는 것.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#lv4"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/normalization-db"
    }
   ],
   "lab:partOf": [
    {
     "@id": "lab:concept/3nf-bcnf"
    }
   ]
  },
  {
   "@id": "lab:method/db_w12-fly",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "3NF — 회원 정보는 회원 표에 한 번",
     "@language": "ko"
    },
    {
     "@value": "option A (fly)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 사실은 한 곳에. 등급이 바뀌면 한 줄만 고치면 돼.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#duel"
   },
   "lab:contrastsWith": [

   ],
   "skos:prefLabel": [
    {
     "@value": "마르코프 가정",
     "@language": "ko"
    },
    {
     "@value": "Markov assumption",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "다음 상태는 바로 직전 상태에만 달려 있다는 가정. 그 전의 역사는 직전 상태에 다 담겼다고 본다.",
    "@language": "ko"
   },

    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "추상화",
     "@language": "ko"
    },
    {
     "@value": "abstraction",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "복잡한 현실에서 목적에 필요한 특성만 골라 단순하게 표현하는 일.",
    "@language": "ko"

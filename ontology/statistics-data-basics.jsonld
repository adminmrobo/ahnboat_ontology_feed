   ],
   "skos:prefLabel": [
    {
     "@value": "통계적 가설검정",
     "@language": "ko"
    },
    {
     "@value": "statistical hypothesis test",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "차이가 없다는 가정을 세우고, 그 가정 아래에서 관측 결과가 얼마나 드문지를 계산해 가정을 버릴지 정하는 절차.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/statistics_note/ch05/3-1_hypothesis_testing.html#lv2"
   },

    }
   ]
  },
  {
   "@id": "lab:method/active-learning",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "능동 학습",
     "@language": "ko"
    },
    {
     "@value": "active learning",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모델이 가장 헷갈린 사례를 골라 라벨을 달아 학습하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

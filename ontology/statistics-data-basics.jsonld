   ],
   "skos:prefLabel": [
    {
     "@value": "라플라스 평활",
     "@language": "ko"
    },
    {
     "@value": "Laplace smoothing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 단어 횟수에 1을 더해 확률 0을 막는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

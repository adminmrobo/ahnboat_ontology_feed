     "@id": "lab:concept/proportion-credible-interval"
    }
   ]
  },
  {
   "@id": "lab:concept/proportion-credible-interval",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "비율의 신용구간",
     "@language": "ko"
    },
    {
     "@value": "credible interval for a proportion",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관찰한 성공·실패 수로 만든 베타 사후분포에서, 비율이 들어 있을 범위를 확률로 나타낸 구간.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/10_nlp_bayes.html#lv2"
   },
   "lab:topic": [
    {
     "@id": "lab:topic/credible-interval"
    }
   ],
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/topic-model-lda"
    }
   ]
  },
  {
   "@id": "lab:method/topic-model-lda",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "토픽 모델(LDA)",
     "@language": "ko"
    },
    {
     "@value": "topic model (latent Dirichlet allocation)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "문서는 여러 토픽의 혼합, 토픽은 단어들의 확률분포라고 보고, 문서마다 토픽 비율을 베이지안으로 추정하는 방법.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/10_nlp_bayes.html#lv3"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:method/bayesian-tag-recommendation"
    }
   ]
  },
  {
   "@id": "lab:concept/nlp",
   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "자연어 처리",
     "@language": "ko"
    },
    {
     "@value": "natural language processing",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "사람의 말과 글을 컴퓨터로 분석·생성하는 분야.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

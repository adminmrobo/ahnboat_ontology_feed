     "@value": "공분산",
     "@language": "ko"
    },
    {
     "@value": "covariance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "두 변수가 평균에서 같은 방향으로 벗어나는 정도. 단위가 남음.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

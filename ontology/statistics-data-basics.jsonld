    }
   ]
  },
  {
   "@id": "lab:concept/mean",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "평균",
     "@language": "ko"
    },
    {
     "@value": "mean",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "모든 값을 더해 개수로 나눈 값. 데이터의 가운데를 나타냄.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/01_what_is_statistics.html#lv1"

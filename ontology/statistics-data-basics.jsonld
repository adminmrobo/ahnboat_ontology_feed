  {
   "@id": "lab:method/naive-bayes-sentiment",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "나이브 베이즈 감성 분석",
     "@language": "ko"
    },
    {
     "@value": "naive Bayes sentiment analysis",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "리뷰의 단어들을 증거로, 긍정·부정 각각의 사전 확률에 단어별 가능도를 곱해 감성 확률을 계산하는 분류.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/10_nlp_bayes.html#lv1"
   },
   "lab:prerequisiteOf": [

    },
    {
     "@value": "hidden vector",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "LSTM이 매 시점 내보내는 −1~1 사이 연속값 줄.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/timeseries-trilogy/3_1_hidden_state.html#lv2"

     "@id": "lab:metric/db_w12"
    }
   ],
   "lab:relatedTo": [
    {
     "@id": "lab:concept/3nf-bcnf"
    }
   ]
  },
  {
   "@id": "lab:method/db_w12-robo",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "반정규화 — 대출 표에 회원 정보도 저장",
     "@language": "ko"
    },
    {
     "@value": "option B (jupanbot)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "조회할 때 JOIN이 없으니 빠르지! 표 하나면 한 번에 끝!",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w12_normalization.html#duel"

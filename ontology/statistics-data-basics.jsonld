     "@id": "lab:concept/dispersion"
    }
   ]
  },
  {
   "@id": "lab:distribution/t",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "t분포",
     "@language": "ko"
    },
    {
     "@value": "t-distribution",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "표본이 작아 흩어짐을 표본으로 어림할 때 쓰는, 정규분포보다 꼬리가 두꺼운 분포. 자유도가 커지면 정규분포에 가까워짐.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/01_what_is_statistics.html#lv2"

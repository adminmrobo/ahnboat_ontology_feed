  {
   "@id": "lab:concept/unstructured-big-data",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "비정형 데이터와 빅데이터",
     "@language": "ko"
    },
    {
     "@value": "unstructured data and big data",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "칸이 정해지지 않은 데이터(비정형)와 양·속도·다양성(3V)이 큰 빅데이터. 관계형만으로는 부담이 생기는 데이터.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w14_database_applications.html#lv1"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/relational-vs-document"
    }
   ]
  },
  {
   "@id": "lab:concept/relational-vs-document",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "관계형 모델과 문서형 모델",
     "@language": "ko"
    },
    {
     "@value": "relational vs document model",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관계형은 표와 외래키·JOIN으로, 문서형은 JSON 같은 문서 안에 관련 값을 함께 담아 표현하는 데이터 모델.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w14_database_applications.html#lv2"
   },
   "lab:prerequisiteOf": [
    {
     "@id": "lab:concept/index-performance"
    }
   ]
  },
  {
   "@id": "lab:concept/index-performance",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "색인과 조회 성능",
     "@language": "ko"
    },
    {
     "@value": "index and query performance",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "특정 칸의 값을 정렬해 행의 위치를 가리키는 구조. 전체 스캔 대신 빠르게 찾게 해 준다.",

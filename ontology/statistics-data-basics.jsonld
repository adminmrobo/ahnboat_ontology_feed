   ],
   "skos:prefLabel": [
    {
     "@value": "신용등급",
     "@language": "ko"
    },
    {
     "@value": "credit rating",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "대출자의 상환 능력을 등급으로 나타낸 것. 등급별 연체율이 사전 확률이 됨.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

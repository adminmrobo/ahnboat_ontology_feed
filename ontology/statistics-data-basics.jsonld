    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "데이터 종속성",
     "@language": "ko"
    },
    {
     "@value": "data dependency",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "응용 프로그램이 파일의 구성과 물리적 저장 구조에 맞춰 작성되어, 구조가 바뀌면 프로그램도 고쳐야 하는 성질.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w03_dbms.html#lv2"

   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "로킹 — 기다렸다가 처리",
     "@language": "ko"
    },
    {
     "@value": "option A (fly)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "열쇠 없으면 기다려. 조금 늦어도 돈은 안 사라져.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "충당금",
     "@language": "ko"
    },
    {
     "@value": "loan loss provision",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "돌려받지 못할 것으로 예상되는 대출을 미리 비용으로 잡아 두는 돈.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/06_financial_risk.html#lv1"
   },
   "lab:partOf": [

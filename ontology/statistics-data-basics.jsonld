    }
   ]
  },
  {
   "@id": "lab:method/db_w13-robo",
   "@type": [
    "skos:Concept",
    "lab:Method"
   ],
   "skos:prefLabel": [
    {
     "@value": "잠금 없이 바로 처리",
     "@language": "ko"
    },
    {
     "@value": "option B (jupanbot)",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "기다리는 시간이 아깝지! 그냥 동시에 쓰자!",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

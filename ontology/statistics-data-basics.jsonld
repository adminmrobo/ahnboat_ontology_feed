    }
   ]
  },
  {
   "@id": "lab:concept/coefficient-of-variation",
   "@type": [
    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "변동계수",
     "@language": "ko"
    },
    {
     "@value": "coefficient of variation",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "표준편차 ÷ 평균 × 100%. 평균이 다른 집단의 상대적 기복을 비교.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/bayesian-statistics-for-data-scientists/01_what_is_statistics.html#lv1"
   },

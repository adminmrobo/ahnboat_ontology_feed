    "skos:Concept",
    "lab:Concept"
   ],
   "skos:prefLabel": [
    {
     "@value": "관계와 대응 수",
     "@language": "ko"
    },
    {
     "@value": "relationship cardinality",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "한 개체가 다른 개체 몇 개와 이어질 수 있는지(1:1, 1:N, N:M)와 참여의 필수·선택.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/data_base_design/weeks/w05_er_modeling.html#lv4"
   }
  },
  {

   ],
   "skos:prefLabel": [
    {
     "@value": "선형",
     "@language": "ko"
    },
    {
     "@value": "linear",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "값에 숫자를 곱해 더하기만 하는 관계. 그래프로는 곧은 선·평평한 면이다.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {

   ],
   "skos:prefLabel": [
    {
     "@value": "전방 알고리즘",
     "@language": "ko"
    },
    {
     "@value": "forward algorithm",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "관측을 하루씩 받으며 “지금 각 상태일 확률”을 갱신하는 계산. 앞 날의 확률 × 전이 × 방출.",
    "@language": "ko"
   },
   "rdfs:isDefinedBy": {
    "@id": "https://adminmrobo.github.io/timeseries-trilogy/3_1_hidden_state.html#lv1"
   }
  },

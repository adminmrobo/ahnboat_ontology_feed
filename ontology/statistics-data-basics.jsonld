   "@type": [
    "skos:Concept",
    "lab:Term"
   ],
   "skos:prefLabel": [
    {
     "@value": "토픽",
     "@language": "ko"
    },
    {
     "@value": "topic",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "함께 자주 나오는 단어들의 확률분포. 사람이 상위 단어를 보고 이름을 붙임.",
    "@language": "ko"
